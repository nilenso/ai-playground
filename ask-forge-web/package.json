{
	"name": "ask-forge-web",
	"module": "src/server.ts",
	"type": "module",
	"scripts": {
		"dev": "bun run build && bun run --hot src/server.ts",
		"build": "bun run scripts/build-client.ts",
		"dev:visualizer": "bun run build:visualizer && bun run --hot src/visualizer-server.ts",
		"build:visualizer": "bun build src/client/visualizer-index.tsx --outfile public/visualizer.js --minify",
		"format": "bunx biome format --write .",
		"lint": "bunx biome lint .",
		"check": "bunx biome check --write .",
		"dump-sessions": "bun run scripts/dump-sessions.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@types/bun": "latest",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@logtape/hono": "^2.0.4",
		"@logtape/logtape": "^2.0.4",
		"@nilenso/ask-forge": "npm:@jsr/nilenso__ask-forge@0.0.15",
		"highlight.js": "^11.11.1",
		"hono": "^4.7.10",
		"marked": "^17.0.1",
		"marked-highlight": "^2.2.3",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-markdown": "^10.1.0"
	}
}
