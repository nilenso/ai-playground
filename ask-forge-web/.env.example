# OpenRouter API key for LLM calls
OPENROUTER_API_KEY=your-openrouter-api-key

# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# JWT secret for signing auth tokens (generate a random 32+ char string)
JWT_SECRET=your-secure-random-string-at-least-32-chars

# App URL (used for OAuth callback redirect)
APP_URL=http://localhost:3000

# Arize Phoenix (optional — tracing disabled if not set)
# Run `docker-compose up phoenix` then set:
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# Phoenix auth (required when PHOENIX_ENABLE_AUTH is set on the container)
PHOENIX_SECRET=dev-phoenix-jwt-secret-change-in-production1
PHOENIX_ADMIN_SECRET=dev-phoenix-admin-secret-at-least-32chars1
PHOENIX_ADMIN_PASSWORD=admin
