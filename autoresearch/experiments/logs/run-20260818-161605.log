COMMAND_ALIASES = {
    "place": "places", "poi": "places", "pois": "places", "search": "places",
    "find": "places", "amenities": "places", "business": "places",
    "building": "buildings",
    "road": "roads", "street": "roads", "streets": "roads",
    "segments": "roads", "segment": "roads", "highways": "roads",
    "address": "addresses", "addr": "addresses",
    "land_use": "landuse", "land-use": "landuse", "land": "landuse",
    "waters": "water", "rivers": "water", "lakes": "water",
    "polygon": "boundary", "geometry": "boundary", "boundaries": "boundary",
    "resolve": "where", "lookup": "where", "geocode": "where", "place-info": "where",
    "reverse": "containing", "locate": "containing", "reverse-geocode": "containing",
    "category": "categories", "cats": "categories", "cuisines": "categories",
    "type": "types", "theme": "themes",
    "commands": "capabilities", "manifest": "capabilities",
    "howto": "examples", "recipes": "examples", "cheatsheet": "examples",
    "help": "examples",
    "group": "groups", "category-groups": "groups",
    "fields": "schema", "columns": "schema",
    "export": "download", "dump": "download", "get": "download", "fetch": "download",
    "release": "releases",
}


class BotmapGroup(click.Group):
    """Click group with alias/prefix resolution and no raw tracebacks."""

    def get_command(self, ctx, cmd_name):
        cmd = super().get_command(ctx, cmd_name)
        if cmd is not None:
            return cmd
        key = cmd_name.lower().replace("_", "-")
        target = COMMAND_ALIASES.get(cmd_name.lower()) or COMMAND_ALIASES.get(key)
        if target:
            resolved = super().get_command(ctx, target)
            if resolved is not None:
                click.secho(
                    f"[botmap] {cmd_name!r} is not a command; running "
                    f"`botmap {target}` instead.",
                    fg="bright_black", err=True,
                )
                return resolved
        names = self.list_commands(ctx)
        prefix_hits = [n for n in names if n.startswith(cmd_name.lower())]
        if len(prefix_hits) == 1:
            return super().get_command(ctx, prefix_hits[0])
        import difflib
        close = difflib.get_close_matches(cmd_name.lower(), names, n=3, cutoff=0.5)
        suggestion = ""
        if close:
            suggestion = (
                f" Did you mean: {', '.join('botmap ' + c for c in close)}?"
            )
        raise click.UsageError(
            f"No such command {cmd_name!r}.{suggestion}\n"
            f"Available: {', '.join(names)}\n"
            f"Run `botmap examples` for a question -> command cheat sheet."
        )

    def invoke(self, ctx):
        try:
            return super().invoke(ctx)
        except (click.ClickException, click.exceptions.Exit, click.Abort,
                SystemExit, KeyboardInterrupt):
            raise
        except Exception as exc:  # never show a raw traceback
            if os.environ.get("BOTMAP_DEBUG"):
                raise
            raise click.ClickException(_friendly_failure(exc)) from exc


@click.group(cls=BotmapGroup, invoke_without_command=True, help=GROUP_HELP)
@click.version_option(
    version=importlib.metadata.version("botmap"),
    prog_name="botmap",
)
@click.option("--json", "json_output", is_flag=True, default=False,
              help="Emit machine-readable JSON (works before or after the "
                   "subcommand).")
@click.pass_context
def cli(ctx, json_output):
    ctx.ensure_object(dict)
    ctx.obj["json"] = json_output
    if ctx.invoked_subcommand is None:
        _print_banner()
        click.echo(ctx.get_help())


