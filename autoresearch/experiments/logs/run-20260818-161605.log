# Types that are enum-constrained, for zero-result explanations.
ENUM_FIELDS: Dict[str, Dict[str, List[str]]] = {
    "segment": {"class": ROAD_CLASSES, "subtype": ["road", "rail", "water"]},
    "building": {"class": BUILDING_CLASSES},
    "division": {"subtype": DIVISION_SUBTYPES},
    "division_area": {"subtype": DIVISION_SUBTYPES},
}


def resolve_place_category(term: str) -> List[str]:
    """Plain-English POI term -> candidate Overture category values."""
    key = re.sub(r"[\s\-_]+", " ", str(term).strip().lower())
    if key in PLACE_CATEGORY_ALIASES:
        return list(PLACE_CATEGORY_ALIASES[key])
    if key.endswith("s") and key[:-1] in PLACE_CATEGORY_ALIASES:
        return list(PLACE_CATEGORY_ALIASES[key[:-1]])
    snake = key.replace(" ", "_")
    return [snake] if snake else []


def resolve_road_classes(term: str) -> List[str]:
    """Plain-English road word -> candidate `segment.class` values."""
    key = re.sub(r"[\s\-]+", "_", str(term).strip().lower())
    if key in ROAD_CLASS_GROUPS:
        return list(ROAD_CLASS_GROUPS[key])
    if key in ROAD_CLASSES:
        return [key]
    if key.endswith("s") and key[:-1] in ROAD_CLASSES:
        return [key[:-1]]
    return []


