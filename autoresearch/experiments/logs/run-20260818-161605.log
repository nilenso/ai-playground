def _norm(name: str) -> str:
    """Normalize a field name for fuzzy comparison: lowercase, alnum only."""
    return re.sub(r"[^a-z0-9]", "", str(name).lower())


# ---------------------------------------------------------------------------
# Schema introspection helpers
# ---------------------------------------------------------------------------

def _collect_paths(
    schema: pa.Schema, max_depth: int = 4
) -> Tuple[List[Tuple[str, pa.DataType]], List[Tuple[str, pa.DataType]]]:
    """Return (reachable_paths, paths_inside_lists).

    Reachable paths can be addressed with pc.field(...).  Paths that sit
    inside a repeated (list) column cannot, and deserve a different error.
    """
    reachable: List[Tuple[str, pa.DataType]] = []
    inside_list: List[Tuple[str, pa.DataType]] = []

    def is_listy(t: pa.DataType) -> bool:
        return (
            pa.types.is_list(t)
            or pa.types.is_large_list(t)
            or pa.types.is_fixed_size_list(t)
        )

    def walk(prefix: str, typ: pa.DataType, depth: int, in_list: bool) -> None:
        if depth > max_depth:
            return
        if pa.types.is_struct(typ):
            for i in range(typ.num_fields):
                child = typ.field(i)
                path = f"{prefix}.{child.name}" if prefix else child.name
                (inside_list if in_list else reachable).append((path, child.type))
                walk(path, child.type, depth + 1, in_list)
        elif is_listy(typ):
            walk(prefix, typ.value_type, depth + 1, True)

    try:
        fields = list(schema)
    except Exception:  # pragma: no cover - defensive
        fields = []
    for f in fields:
        reachable.append((f.name, f.type))
        walk(f.name, f.type, 1, False)
    return reachable, inside_list


def _type_at(schema: pa.Schema, path: str) -> Optional[pa.DataType]:
    """Resolve a dotted path to its pyarrow type, or None if not addressable."""
    if schema is None:
        return None
    parts = path.split(".")
    try:
        if parts[0] not in schema.names:
            return None
        typ = schema.field(parts[0]).type
    except Exception:  # pragma: no cover - defensive
        return None
    for part in parts[1:]:
        if not pa.types.is_struct(typ):
            return None
        names = [typ.field(i).name for i in range(typ.num_fields)]
        if part not in names:
            return None
        typ = typ.field(names.index(part)).type
    return typ


def _is_string_type(typ: Optional[pa.DataType]) -> bool:
    if typ is None:
        return False
    return bool(
        pa.types.is_string(typ)
        or pa.types.is_large_string(typ)
        or (hasattr(pa.types, "is_string_view") and pa.types.is_string_view(typ))
    )


def _is_numeric_type(typ: Optional[pa.DataType]) -> bool:
    if typ is None:
        return False
    return bool(
        (pa.types.is_integer(typ) or pa.types.is_floating(typ) or
         pa.types.is_decimal(typ)) and not pa.types.is_boolean(typ)
    )


def _format_value(value: Any) -> str:
    """Render a value the way it should be typed back into --where."""
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, list):
        return "[" + ",".join(_format_value(v) for v in value) + "]"
    text = str(value)
    if re.search(r"[\s,]", text):
        return f"'{text}'"
    return text


# ---------------------------------------------------------------------------
# ParsedFilter
# ---------------------------------------------------------------------------

@dataclass(frozen=True)
class ParsedFilter:
    """One parsed `--where` clause.

    key   dotted field path as the user typed it (may be an alias)
    op    one of SUPPORTED_OPS
    value python scalar / list / None
    raw   the untouched right-hand side text, used to recover things that
          coercion would destroy (leading-zero postcodes, "02139")
    """

    key: str
    op: str
    value: Any = None
    raw: Optional[str] = None

    # -- key resolution ---------------------------------------------------

    def resolved_key(self, schema: Optional[pa.Schema]) -> str:
        """Map self.key onto a real, addressable field path in `schema`.

        Accepts the exact name, a different case/underscore spelling, a well
        known alias (`name` -> `names.primary`), or an unambiguous leaf name
        (`primary` -> `names.primary`).  Raises ValueError with a runnable
        suggestion otherwise.
        """
        if schema is None:
            return self.key

        key = self.key.strip().strip('"').strip("'")
        # `names[primary]` / `names->primary` / `names/primary` all mean the
        # same thing to an assistant.
        key = re.sub(r"\[\s*['\"]?([^\]'\"]+)['\"]?\s*\]", r".\1", key)
        key = key.replace("->", ".").replace("/", ".").strip(".")

        reachable, inside_list = _collect_paths(schema)
        by_lower = {p.lower(): p for p, _ in reachable}
        by_norm: Dict[str, str] = {}
        for p, _ in reachable:
            by_norm.setdefault(_norm(p), p)

        # 1. exact / case-insensitive / punctuation-insensitive path
        if key in by_lower.values():
            return key
        if key.lower() in by_lower:
            return by_lower[key.lower()]
        if _norm(key) in by_norm:
            return by_norm[_norm(key)]

        # 2. known alias
        for candidate in _KEY_ALIASES.get(_norm(key), ()):
            if candidate in by_lower.values():
                return candidate
            if candidate.lower() in by_lower:
                return by_lower[candidate.lower()]
            if _norm(candidate) in by_norm:
                return by_norm[_norm(candidate)]

        # 3. unambiguous leaf name, e.g. `primary` -> `names.primary`
        leaf_hits = [p for p, _ in reachable if _norm(p.split(".")[-1]) == _norm(key)]
        if len(leaf_hits) == 1:
            return leaf_hits[0]
        if len(leaf_hits) > 1:
            shortest = min(leaf_hits, key=lambda p: (p.count("."), len(p)))
            raise ValueError(
                f"Field {self.key!r} is ambiguous: it could mean "
                f"{', '.join(sorted(leaf_hits))}.\n"
                f"Spell it out, e.g.  --where "
                f"'{shortest}{self._op_text()}{_format_value(self.value)}'"
            )

        # 4. it exists, but inside a repeated (list) column -> different fix
        list_hits = [
            p for p, _ in inside_list
            if _norm(p) == _norm(key) or _norm(p.split(".")[-1]) == _norm(key)
        ]
        if list_hits:
            path = sorted(list_hits, key=len)[0]
            top = path.split(".")[0]
            leaf = path.split(".")[-1]
            hint = (
                f"  botmap addresses --{leaf} {_format_value(self.value)} "
                f"--in '<PLACE>'\n"
                if top == "addresses"
                else ""
            )
            raise ValueError(
                f"Field {path!r} exists but lives inside the repeated (list) "
                f"column {top!r}, which --where cannot address, so filtering "
                f"on it here would silently match nothing.\n"
                f"Use the purpose-built command instead:\n"
                f"{hint}"
                f"  botmap search --help        # for name/category lookups\n"
                f"or export and post-process:  botmap download -t <TYPE> "
                f"--in '<PLACE>' -o out.parquet"
            )

        # 5. give up, but give up usefully
        raise ValueError(self._unknown_field_message(key, reachable))

    def _op_text(self) -> str:
        if self.op in ("in", "not in"):
            return f" {self.op} "
        if self.op == "is_null":
            return " is "
        if self.op == "not_null":
            return " is not "
        return self.op

    def _unknown_field_message(
        self, key: str, reachable: Sequence[Tuple[str, pa.DataType]]
    ) -> str:
        import difflib

        paths = [p for p, _ in reachable]
        norm_map = {_norm(p): p for p in paths}
        close = difflib.get_close_matches(_norm(key), list(norm_map), n=4, cutoff=0.55)
        suggestions = [norm_map[c] for c in close]
        if not suggestions:
            suggestions = [
                p for p in paths
                if _norm(key) in _norm(p) or _norm(p) in _norm(key)
            ][:4]

        top_level = sorted({p.split(".")[0] for p in paths})
        lines = [f"Unknown field {self.key!r} for this data type."]
        if suggestions:
            lines.append("Closest matching fields: " + ", ".join(suggestions))
            best = suggestions[0]
            value = _format_value(self.value)
            lines.append(
                f"Ready to run:  --where '{best}{self._op_text()}{value}'"
            )
        lines.append("Top-level fields here: " + ", ".join(top_level[:30]))
        lines.append(
            "Full field list (including nested paths):  "
            "botmap schema -t <TYPE>"
        )
        return "\n".join(lines)

    # -- value adaptation -------------------------------------------------

    def _numeric_from_text(self, text: str, typ: pa.DataType) -> Union[int, float]:
        s = text.strip().strip("'\"").replace(",", "")
        m = re.fullmatch(
            r"([+-]?\d+(?:\.\d+)?)\s*"
            r"(m|meter|meters|metre|metres|km|kilometers?|ft|foot|feet|"
            r"mi|mile|miles|storeys?|stories|floors?|levels?)?",
            s,
            re.IGNORECASE,
        )
        if not m:
            raise ValueError(
                f"Field {self.key!r} is numeric ({typ}) but the value "
                f"{text!r} is not a number.\n"
                f"Use a bare number, e.g.  --where "
                f"'{self.key}{self._op_text()}100'\n"
                f"For text matching use ~ instead:  --where "
                f"'names.primary~{text.strip().strip(chr(39))}'"
            )
        number = float(m.group(1))
        unit = (m.group(2) or "").lower()
        if unit in ("km", "kilometer", "kilometers"):
            number *= 1000.0
        elif unit in ("ft", "foot", "feet"):
            number *= 0.3048
        elif unit in ("mi", "mile", "miles"):
            number *= 1609.344
        if pa.types.is_integer(typ) and float(number).is_integer():
            return int(number)
        return number

    def _adapt_scalar(self, value: Any, typ: Optional[pa.DataType],
                      raw: Optional[str] = None) -> Any:
        if value is None or typ is None:
            return value
        if _is_string_type(typ):
            if isinstance(value, bool):
                return "true" if value else "false"
            if isinstance(value, str):
                return value
            # Numeric coercion would have eaten a leading zero ("02139").
            if raw is not None:
                return raw.strip().strip("'\"")
            return str(value)
        if pa.types.is_boolean(typ):
            if isinstance(value, bool):
                return value
            if isinstance(value, (int, float)):
                return bool(value)
            text = str(value).strip().lower()
            if text in ("true", "t", "yes", "y", "1"):
                return True
            if text in ("false", "f", "no", "n", "0"):
                return False
            raise ValueError(
                f"Field {self.key!r} is boolean but the value {value!r} is "
                f"not true/false.\nReady to run:  --where "
                f"'{self.key}=true'"
            )
        if _is_numeric_type(typ):
            if isinstance(value, bool):
                return int(value)
            if isinstance(value, (int, float)):
                return value
            return self._numeric_from_text(str(value), typ)
        return value

    def _adapt(self, typ: Optional[pa.DataType]) -> Any:
        if isinstance(self.value, list):
            return [self._adapt_scalar(v, typ) for v in self.value]
        return self._adapt_scalar(self.value, typ, self.raw)

    # -- expression building ----------------------------------------------

    def to_pyarrow_expression(
        self, schema: Optional[pa.Schema] = None
    ) -> pc.Expression:
        """Build a pc.Expression, resolving dotted keys against `schema`."""
        path = self.resolved_key(schema)
        parts = path.split(".")
        ref = pc.field(*parts) if len(parts) > 1 else pc.field(parts[0])

        typ = _type_at(schema, path) if schema is not None else None
        op = self.op
        value = self._adapt(typ)
        strings = _is_string_type(typ)

        if op == "is_null":
            return ref.is_null()
        if op == "not_null":
            return ref.is_valid()

        if op == "=":
            if strings and isinstance(value, str):
                # Case-insensitive: a case-sensitive miss reads as "there are
                # none here", which is the worst failure mode in this system.
                return pc.utf8_lower(ref) == value.lower()
            return ref == value
        if op == "!=":
            if strings and isinstance(value, str):
                return pc.utf8_lower(ref) != value.lower()
            return ref != value
        if op == "<":
            return ref < value
        if op == "<=":
            return ref <= value
        if op == ">":
            return ref > value
        if op == ">=":
            return ref >= value
        if op in ("in", "not in"):
            values = value if isinstance(value, list) else [value]
            if strings and all(isinstance(v, str) for v in values):
                expr = pc.utf8_lower(ref).isin([v.lower() for v in values])
            else:
                expr = ref.isin(values)
            return ~expr if op == "not in" else expr
        if op in ("~", "!~"):
            pattern = value if isinstance(value, str) else str(value)
            expr = self._pattern_expression(ref, pattern)
            return ~expr if op == "!~" else expr
        if op == "^=":
            return pc.starts_with(ref, str(value), ignore_case=True)
        if op == "$=":
            return pc.ends_with(ref, str(value), ignore_case=True)

        raise ValueError(
            f"Unsupported operator {self.op!r}. Supported: "
            f"{', '.join(SUPPORTED_OPS)}"
        )

    @staticmethod
    def _pattern_expression(ref: pc.Expression, pattern: str) -> pc.Expression:
        """SQL-ish LIKE / glob patterns collapse onto substring matching."""
        body = pattern
        lead = body.startswith("%") or body.startswith("*")
        trail = body.endswith("%") or body.endswith("*")
        body = body.strip("%*")
        if not body:
            return ref.is_valid()
        if lead and not trail:
            return pc.ends_with(ref, body, ignore_case=True)
        if trail and not lead:
            return pc.starts_with(ref, body, ignore_case=True)
        return pc.match_substring(ref, body, ignore_case=True)

    # -- validation -------------------------------------------------------

    def validate_against_schema(self, schema: pa.Schema) -> None:
        """Verify the key resolves and the value fits; raise ValueError if not."""
        path = self.resolved_key(schema)
        typ = _type_at(schema, path)
        if self.op in ("~", "!~", "^=", "$=") and typ is not None:
            if not _is_string_type(typ):
                raise ValueError(
                    f"Operator {self.op!r} only works on text fields, but "
                    f"{path!r} is {typ}.\n"
                    f"Ready to run:  --where "
                    f"'{path}={_format_value(self.value)}'"
                )
        if self.op in ("in", "not in") and not isinstance(self.value, list):
            raise ValueError(
                f"`{self.op}` needs a bracketed list.\n"
                f"Ready to run:  --where "
                f"'{path} {self.op} [{_format_value(self.value)}]'"
            )
        # Force value coercion now so type errors surface with a good message
        # rather than as an Arrow cast traceback mid-scan.
        self._adapt(typ)


# ---------------------------------------------------------------------------
# Value coercion
# ---------------------------------------------------------------------------

def _coerce_scalar(raw: str) -> Union[str, int, float, bool, None]:
    """Turn one right-hand-side token into a python scalar.

    Quoted text is always kept as text.  Numbers with a leading zero stay
    text too, so postcodes like 02139 are not silently turned into 2139.
    """
    s = str(raw).strip()

    # Quoted -> literal text, no further guessing.
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
        return s[1:-1]

    low = s.lower()
    if low in ("true", "yes"):
        return True
    if low in ("false", "no"):
        return False
    if low in _NULL_WORDS:
        return None

    if re.fullmatch(r"[+-]?\d+", s) and not re.fullmatch(r"[+-]?0\d+", s):
        try:
            return int(s)
        except ValueError:
            pass
    if re.fullmatch(r"[+-]?(\d+\.\d*|\.\d+|\d+[eE][+-]?\d+)", s):
        try:
            return float(s)
        except ValueError:
            pass
    return s


def _parse_list_value(raw: str) -> List[Any]:
    """Parse the right-hand side of `in`.

    Accepts [a,b,c], (a,b,c), {a,b,c} and a bare comma-separated list, since
    all four are things an assistant plausibly types.
    """
    s = str(raw).strip()
    pairs = (("[", "]"), ("(", ")"), ("{", "}"))
    for open_c, close_c in pairs:
        if s.startswith(open_c) and s.endswith(close_c):
            s = s[1:-1]
            break
    else:
        if "," not in s:
            # Single value: treat as a one-element list instead of erroring.
            single = _coerce_scalar(s)
            if single is None or single == "":
                raise ValueError(
                    f"`in` needs at least one value, got {raw!r}.\n"
                    f"Ready to run:  --where 'class in [hospital,clinic]'"
                )
            return [single]

    parts = [p for p in (chunk.strip() for chunk in _split_list(s)) if p]
    if not parts:
        raise ValueError(
            f"`in` list is empty: {raw!r}.\n"
            f"Ready to run:  --where 'class in [hospital,clinic]'"
        )
    return [_coerce_scalar(p) for p in parts]


def _split_list(inner: str) -> List[str]:
    """Split on commas that are not inside quotes."""
    out: List[str] = []
    buf: List[str] = []
    quote: Optional[str] = None
    for ch in inner:
        if quote:
            if ch == quote:
                quote = None
            buf.append(ch)
        elif ch in ("'", '"'):
            quote = ch
            buf.append(ch)
        elif ch == ",":
            out.append("".join(buf))
            buf = []
        else:
            buf.append(ch)
    out.append("".join(buf))
    return out


# ---------------------------------------------------------------------------
# Expression parsing
# ---------------------------------------------------------------------------

def _find_operator(expr: str) -> Optional[Tuple[int, int, str]]:
    """Return (start, length, raw_op) for the leftmost operator, longest wins."""
    best: Optional[Tuple[int, int, str]] = None

    def offer(idx: int, length: int, token: str) -> None:
        nonlocal best
        if idx < 0:
            return
        if best is None or idx < best[0] or (idx == best[0] and length > best[1]):
            best = (idx, length, token)

    for op in _SYMBOL_OPS:
        offer(expr.find(op), len(op), op)

    for m in _WORD_OP_RE.finditer(expr):
        token = re.sub(r"[\s_]+", " ", m.group(1).strip().lower())
        offer(m.start(), len(m.group(0)), token)

    if best is None:
        for op in _FALLBACK_SYMBOL_OPS:
            offer(expr.find(op), len(op), op)

    return best


def parse_where_expr(expr: str) -> ParsedFilter:
    """Parse a single --where expression of the form 'KEY OP VALUE'.

    Understood forms (all equivalent where sensible):
        class=hospital            class == hospital       class:hospital
        class != hospital         class <> hospital
        height>150                height > 150m           height gt 150
        class in [a,b]            class in (a,b)          class in a,b
        class not in [a,b]
        names.primary~cambridge   names.primary contains cambridge
        names.primary like 'Main%'
        height is null            height is not null      height != null
    """
    if expr is None:
        raise ValueError("--where expression is empty.")

    text = str(expr).strip()
    # A whole expression wrapped in quotes by an over-cautious caller.
    if len(text) >= 2 and text[0] == text[-1] and text[0] in ("'", '"'):
        inner = text[1:-1].strip()
        if inner:
            text = inner
    if not text:
        raise ValueError(
            "--where expression is empty. Use KEY OP VALUE, e.g. "
            "--where 'class=hospital'"
        )

    # `key is null` / `key is not null` before generic splitting.
    m = re.fullmatch(
        r"(?P<key>[\w.\[\]'\"/>-]+)\s+is\s+(?P<neg>not\s+)?"
        r"(?P<word>null|none|nil|nan|empty|missing|set|present)",
        text,
        re.IGNORECASE,
    )
    if m:
        word = m.group("word").lower()
        negated = bool(m.group("neg"))
        if word in ("set", "present"):
            negated = not negated
        return ParsedFilter(
            key=m.group("key").strip(),
            op="not_null" if negated else "is_null",
            value=None,
            raw=None,
        )

    found = _find_operator(text)
    if found is None:
        raise ValueError(
            f"Filter {text!r} has no operator. Use KEY OP VALUE, e.g.\n"
            f"  --where 'class=hospital'\n"
            f"  --where 'height>150'\n"
            f"  --where 'names.primary~harbor'\n"
            f"If you typed an unquoted > or <, your shell redirected it to a "
            f"file - wrap the whole expression in single quotes."
        )

    idx, length, raw_op = found
    key = text[:idx].strip()
    value_raw = text[idx + length:].strip()

    # `height:>150` - the colon was noise in front of a real operator.
    if raw_op == ":" and value_raw[:2] in ("!=", ">=", "<=") :
        raw_op, value_raw = value_raw[:2], value_raw[2:].strip()
    elif raw_op == ":" and value_raw[:1] in (">", "<", "=", "~"):
        raw_op, value_raw = value_raw[:1], value_raw[1:].strip()

    op = _OP_CANONICAL.get(raw_op.strip().lower())
    if op is None:
        raise ValueError(
            f"Unrecognized operator {raw_op!r} in {text!r}. Supported: "
            f"=, !=, <, <=, >, >=, in, not in, ~ (contains), is null"
        )

    if not key:
        raise ValueError(
            f"--where expression has an empty field name: {text!r}\n"
            f"Ready to run:  --where 'class{op if op not in ('in', 'not in') else ' in '}"
            f"{value_raw or 'hospital'}'"
        )
    if not value_raw:
        raise ValueError(
            f"--where expression has an empty value: {text!r}\n"
            f"Ready to run:  --where '{key}={'true' if op == '=' else '0'}'\n"
            f"To test for presence instead:  --where '{key} is not null'"
        )

    # `is` / `is not` with a real value behave like = / !=.
    if op == "is":
        op = "="
    elif op == "is not":
        op = "!="

    if op in ("in", "not in"):
        value = _parse_list_value(value_raw)
        return ParsedFilter(key=key, op=op, value=value, raw=value_raw)

    value = _coerce_scalar(value_raw)

    # `field = null` really means "is null" - comparing against the literal
    # text "null" would return zero rows and be read as "there are none".
    quoted = len(value_raw) >= 2 and value_raw[0] == value_raw[-1] and value_raw[0] in ("'", '"')
    if value is None and not quoted:
        if op == "=":
            return ParsedFilter(key=key, op="is_null", value=None, raw=None)
        if op == "!=":
            return ParsedFilter(key=key, op="not_null", value=None, raw=None)
        raise ValueError(
            f"Cannot compare {key!r} to null with {op!r}.\n"
            f"Ready to run:  --where '{key} is not null'"
        )

    return ParsedFilter(key=key, op=op, value=value, raw=value_raw)


def parse_where_exprs(exprs: Sequence[str]) -> List[ParsedFilter]:
    """Parse many --where expressions."""
    return [parse_where_expr(e) for e in (exprs or [])]


# ---------------------------------------------------------------------------
# Combination and post-mortem helpers
# ---------------------------------------------------------------------------

def combine(
    filters: Sequence[Union[ParsedFilter, str]],
    schema: Optional[pa.Schema] = None,
) -> Optional[pc.Expression]:
    """AND-combine filters, validating each against the schema.

    Accepts already-parsed ParsedFilter objects or raw --where strings.
    """
    if not filters:
        return None
    parsed: List[ParsedFilter] = []
    for f in filters:
        parsed.append(parse_where_expr(f) if isinstance(f, str) else f)

    if schema is not None:
        for f in parsed:
            f.validate_against_schema(schema)

    exprs = [f.to_pyarrow_expression(schema) for f in parsed]
    result = exprs[0]
    for e in exprs[1:]:
        result = result & e
    return result


def format_filters(filters: Sequence[ParsedFilter]) -> str:
    """Human-readable echo of the active filters, for zero-result messages."""
    parts = []
    for f in filters or []:
        if f.op == "is_null":
            parts.append(f"{f.key} is null")
        elif f.op == "not_null":
            parts.append(f"{f.key} is not null")
        elif f.op in ("in", "not in"):
            parts.append(f"{f.key} {f.op} {_format_value(f.value)}")
        else:
            parts.append(f"{f.key}{f.op}{_format_value(f.value)}")
    return " AND ".join(parts)


