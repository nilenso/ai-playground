# When a struct is compared directly, descend to its "main" child.
_STRUCT_DEFAULT_CHILDREN = ("primary", "value", "name", "text", "common")


# --------------------------------------------------------------------------
# key resolution
# --------------------------------------------------------------------------
def _resolve_dotted(key: str, schema: Any) -> Optional[Tuple[str, pa.DataType, bool]]:
    """Exact-ish resolution of a dotted key. Returns (canonical, type, crossed_list)."""
    segs = [s.strip() for s in str(key).split(".")]
    segs = [s for s in segs if s and _norm(s) not in _SKIP_SEGMENTS]
    if not segs:
        return None

    names = _schema_names(schema)
    top = None
    wanted = _variants(segs[0])
    for n in names:
        if _norm(n) in wanted:
            top = n
            break
    if top is None:
        return None

    canon = [top]
    t = _top_field_type(schema, top)
    crossed = False
    for seg in segs[1:]:
        kids = _children(t)
        if not kids:
            return None
        want = _variants(seg)
        hit = None
        for cname, ctype, parent_list in kids:
            if _norm(cname) in want:
                hit = (cname, ctype, parent_list)
                break
        if hit is None:
            return None
        canon.append(hit[0])
        t = hit[1]
        crossed = crossed or hit[2]
    return (".".join(canon), t, crossed)


def _auto_descend(path: str, t: pa.DataType, crossed: bool) -> Tuple[str, pa.DataType, bool]:
    """`names` -> `names.primary`; single-field structs are unwrapped too."""
    guard = 0
    while t is not None and pa.types.is_struct(t) and guard < 3:
        guard += 1
        kids = _children(t)
        pick = None
        for want in _STRUCT_DEFAULT_CHILDREN:
            for cname, ctype, parent_list in kids:
                if _norm(cname) == want and not _is_container(ctype):
                    pick = (cname, ctype, parent_list)
                    break
            if pick:
                break
        if pick is None and len(kids) == 1 and not _is_container(kids[0][1]):
            pick = kids[0]
        if pick is None:
            break
        path = f"{path}.{pick[0]}"
        t = pick[1]
        crossed = crossed or pick[2]
    return path, t, crossed


def _candidates_for(key: str, schema: Any) -> List[Tuple[str, pa.DataType, bool]]:
    """Ordered candidate resolutions for a user-supplied key."""
    seen = set()
    out: List[Tuple[str, pa.DataType, bool]] = []

    def add(res: Optional[Tuple[str, pa.DataType, bool]]) -> None:
        if res and res[0] not in seen:
            seen.add(res[0])
            out.append(res)

    add(_resolve_dotted(key, schema))

    n = _norm(key.replace(".", "_"))
    for alias_path in _ALIASES.get(n, []):
        add(_resolve_dotted(alias_path, schema))
    n2 = _norm(key.split(".")[-1])
    if n2 != n:
        for alias_path in _ALIASES.get(n2, []):
            add(_resolve_dotted(alias_path, schema))

    # schema-wide leaf-name search, cheapest paths first
    want = _variants(key.split(".")[-1])
    matches = []
    for path, t, crossed in _walk_paths(schema, max_depth=3):
        leaf = path.split(".")[-1]
        if _norm(leaf) in want or _norm(path.replace(".", "")) in want:
            matches.append((crossed, path.count("."), path, t))
    matches.sort()
    for crossed, _depth, path, t in matches:
        add((path, t, crossed))

    return out


def _suggestions(key: str, schema: Any, limit: int = 3) -> List[str]:
    paths = [p for p, t, crossed in _walk_paths(schema, max_depth=2)
             if not crossed and not _is_container(t)]
    if not paths:
        paths = _schema_names(schema)
    keyn = _norm(key.replace(".", ""))
    scored = difflib.get_close_matches(
        keyn, [_norm(p.replace(".", "")) for p in paths], n=limit, cutoff=0.55
    )
    out = []
    for s in scored:
        for p in paths:
            if _norm(p.replace(".", "")) == s and p not in out:
                out.append(p)
                break
    # alias-driven suggestions even when spelling is far off
    for alias_path in _ALIASES.get(_norm(key), []):
        r = _resolve_dotted(alias_path, schema)
        if r and not r[2] and r[0] not in out:
            out.append(r[0])
    return out[:limit]


def _fmt_value(value: Any) -> str:
    if value is NULL:
        return "null"
    if isinstance(value, list):
        return "[" + ",".join(_fmt_value(v) for v in value) + "]"
    if isinstance(value, bool):
        return "true" if value else "false"
    return str(value)


def _ready_to_run(path: str, op: str, value: Any) -> str:
    op_txt = " in " if op in _LIST_OPS else op
    return f"--where '{path}{op_txt}{_fmt_value(value)}'"


def _resolve_key(key: str, op: str, value: Any, schema: Any) -> Tuple[str, pa.DataType]:
    """Resolve a user key to a filterable dotted path + its arrow type."""
    cands = _candidates_for(key, schema)

    if not cands:
        sug = _suggestions(key, schema)
        lines = [f"Unknown --where field {key!r}: this dataset has no such column."]
        if sug:
            lines.append(
                "Closest match: %s. Ready-to-run replacement:\n  %s"
                % (sug[0], _ready_to_run(sug[0], op, value))
            )
        hint = _field_list_hint(schema)
        if hint:
            lines.append(hint)
        lines.append(
            "Field names are case-insensitive; nested fields use dots "
            "(e.g. names.primary, categories.primary). Run `botmap examples` "
            "for known-good command shapes."
        )
        raise ValueError(" ".join(lines))

    # First candidate that is a scalar (after auto-descending structs) and does
    # not cross a repeated field.
    fallback = None
    for path, t, crossed in cands:
        p2, t2, crossed2 = _auto_descend(path, t, crossed)
        if crossed2 or _is_container(t2):
            if fallback is None:
                fallback = (p2, t2, crossed2)
            continue
        if op in _TEXT_OPS and not _is_stringish(t2):
            if fallback is None:
                fallback = (p2, t2, crossed2)
            continue
        return p2, t2

    path, t, crossed = fallback  # type: ignore[misc]
    leaf = path.split(".")[-1]

    if crossed:
        alt = []
        if _norm(leaf) in {"street", "number", "postcode", "locality", "region",
                           "country", "housenumber"}:
            alt.append(
                "the address theme has %r as a top-level field, so "
                "`botmap count -t address --bbox <bbox> %s` works"
                % (leaf, _ready_to_run(leaf, op, value))
            )
            if _norm(leaf) == "street":
                alt.append('or use the dedicated flag: `botmap addresses --street "%s" ...`'
                           % _fmt_value(value))
        else:
            alt.append("filter on a top-level or struct field instead")
        raise ValueError(
            f"Field {key!r} resolves to {path!r}, which lives inside a repeated "
            f"(list) field. --where cannot compare inside lists, so this filter "
            f"would silently match nothing. Instead: " + "; ".join(alt) + ". "
            + _field_list_hint(schema)
        )

    if _is_container(t):
        kids = [c[0] for c in _children(t)][:8]
        sub = f"{path}.{kids[0]}" if kids else path
        raise ValueError(
            f"Field {path!r} is a {t} (a container), not a value you can compare "
            f"with {op!r}. Pick a subfield. Ready-to-run replacement:\n  "
            f"{_ready_to_run(sub, op, value)}"
            + (f"\nSubfields: {', '.join(kids)}" if kids else "")
        )

    # op/type mismatch (e.g. `contains` on a number)
    raise ValueError(
        f"Operator {op!r} needs a text field, but {path!r} is {t}. "
        f"Ready-to-run replacement:\n  {_ready_to_run(path, '=', value)}"
    )


# --------------------------------------------------------------------------
# value coercion / adaptation
# --------------------------------------------------------------------------
_INT_RE = re.compile(r"^[+-]?(?:0|[1-9][0-9]*)$")
_FLOAT_RE = re.compile(r"^[+-]?(?:0|[1-9][0-9]*)?\.[0-9]+(?:[eE][+-]?[0-9]+)?$")
_SCI_RE = re.compile(r"^[+-]?(?:0|[1-9][0-9]*)[eE][+-]?[0-9]+$")

_TRUE = {"true", "t", "yes", "y", "1"}
_FALSE = {"false", "f", "no", "n", "0"}


def _coerce_scalar(raw: str) -> Union[str, int, float, bool, _NullValue]:
    """Turn a raw --where token into a Python value, conservatively.

    Quoted tokens always stay strings, and leading-zero tokens like 02138
    stay strings (turning a postcode into an int is a classic silent-zero bug).
    """
    s = str(raw).strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
        return s[1:-1]
    low = s.lower()
    if low in _NULL_TOKENS:
        return NULL
    if low == "true":
        return True
    if low == "false":
        return False
    if _INT_RE.match(s):
        try:
            return int(s)
        except ValueError:
            return s
    if _FLOAT_RE.match(s) or _SCI_RE.match(s):
        try:
            return float(s)
        except ValueError:
            return s
    return s


def _split_list_items(inner: str) -> List[str]:
    items: List[str] = []
    buf = ""
    quote = None
    for ch in inner:
        if quote:
            if ch == quote:
                quote = None
            else:
                buf += ch
            continue
        if ch in ("'", '"'):
            quote = ch
            continue
        if ch in (",", "|", ";"):
            items.append(buf)
            buf = ""
            continue
        buf += ch
    items.append(buf)
    return [i.strip() for i in items if i.strip()]


def _parse_list_value(raw: str) -> List[Any]:
    """Accept [a,b,c], (a,b,c), a,b,c and a bare single value."""
    s = str(raw).strip()
    if len(s) >= 2 and s[0] in "[(" and s[-1] in "])":
        s = s[1:-1]
    items = _split_list_items(s)
    if not items:
        raise ValueError(
            f"`in` needs at least one value, got {raw!r}. "
            "Example: --where 'class in [motorway,trunk,primary]'"
        )
    return [_coerce_scalar(i) for i in items]


def _adapt_value(value: Any, t: Optional[pa.DataType], path: str, op: str) -> Any:
    """Cast the user's value to the schema's type so the filter can match."""
    if value is NULL:
        return value
    if isinstance(value, list):
        return [_adapt_value(v, t, path, op) for v in value]
    if t is None or op in _TEXT_OPS:
        return value if not isinstance(value, bool) else ("true" if value else "false")

    try:
        if _is_stringish(t):
            if isinstance(value, bool):
                return "true" if value else "false"
            if isinstance(value, float) and value.is_integer():
                return str(int(value))
            return value if isinstance(value, str) else str(value)

        if pa.types.is_boolean(t):
            if isinstance(value, bool):
                return value
            s = str(value).strip().lower()
            if s in _TRUE:
                return True
            if s in _FALSE:
                return False
            raise ValueError(
                f"Field {path!r} is a boolean, so {value!r} is not comparable. "
                f"Ready-to-run replacement:\n  {_ready_to_run(path, '=', True)}"
            )

        if pa.types.is_integer(t) or pa.types.is_floating(t) or pa.types.is_decimal(t):
            if isinstance(value, bool):
                return int(value)
            if isinstance(value, (int, float)):
                return value
            s = str(value).strip().rstrip("mM").replace(",", "")
            s = re.sub(r"(?i)(meters|metres|m|ft|feet)$", "", s).strip()
            try:
                return int(s) if _INT_RE.match(s) else float(s)
            except ValueError:
                raise ValueError(
                    f"Field {path!r} is numeric ({t}) but the value {value!r} is not a "
                    f"number. Use a number, e.g.\n  {_ready_to_run(path, op if op not in _LIST_OPS else '=', 150)}"
                )
    except ValueError:
        raise
    except Exception:
        return value
    return value


# --------------------------------------------------------------------------
# expression building
# --------------------------------------------------------------------------
def _field_ref(path: str) -> pc.Expression:
    parts = path.split(".")
    return pc.field(*parts) if len(parts) > 1 else pc.field(parts[0])


def _norm_text_ref(ref: pc.Expression) -> Optional[pc.Expression]:
    """lower(trim(field)) so casing/padding never causes a false zero."""
    try:
        return pc.utf8_lower(pc.utf8_trim_whitespace(ref))
    except Exception:
        try:
            return pc.utf8_lower(ref)
        except Exception:
            return None


def _is_null_expr(ref: pc.Expression) -> pc.Expression:
    try:
        return ref.is_null()
    except Exception:
        return ~ref.is_valid()


@dataclass(frozen=True)
class ParsedFilter:
    key: str
    # User-facing ops from --where:
    #   =  !=  <  <=  >  >=  in  "not in"
    #   ~ / contains / like   : case-insensitive substring
    #   !~                    : case-insensitive "does not contain"
    #   ^ / starts with       : case-insensitive prefix
    #   $ / ends with         : case-insensitive suffix
    # Text `=`, `!=` and `in` are case-insensitive and whitespace-trimmed.
    op: str
    value: Any  # str | int | float | bool | list | NULL

    # ---- public API ------------------------------------------------------
    def resolve(self, schema: Optional[pa.Schema]) -> "ParsedFilter":
        """Return a copy with a canonical field path and schema-typed value."""
        if schema is None:
            return self
        path, t = _resolve_key(self.key, self.op, self.value, schema)
        value = _adapt_value(self.value, t, path, self.op)
        return ParsedFilter(key=path, op=self.op, value=value)

    def validate_against_schema(self, schema: pa.Schema) -> None:
        """Verify the key resolves; raise ValueError with a fix otherwise."""
        self.resolve(schema)

    def to_pyarrow_expression(self, schema: Optional[pa.Schema]) -> pc.Expression:
        """Build a pc.Expression, resolving dotted/aliased keys against `schema`."""
        resolved = self.resolve(schema)
        t = None
        if schema is not None:
            r = _resolve_dotted(resolved.key, schema)
            if r:
                t = r[1]
        try:
            return resolved._build(t)
        except ValueError:
            raise
        except Exception as exc:  # never leak a raw traceback
            raise ValueError(
                f"Could not build the filter {resolved.key!r} {resolved.op} "
                f"{_fmt_value(resolved.value)!r} ({exc}). "
                f"Ready-to-run replacement:\n  "
                f"{_ready_to_run(resolved.key, '=', resolved.value)}"
                + ("\n" + _field_list_hint(schema) if schema is not None else "")
            )

    # ---- internals -------------------------------------------------------
    def _build(self, t: Optional[pa.DataType]) -> pc.Expression:
        ref = _field_ref(self.key)
        op = self.op
        value = self.value

        # NULL handling
        if value is NULL:
            if op in ("=", "in", "~"):
                return _is_null_expr(ref)
            if op in ("!=", "not in", "!~"):
                return ref.is_valid()
            raise ValueError(
                f"Operator {op!r} cannot be used with null. Use "
                f"--where '{self.key}=null' or --where '{self.key}!=null'."
            )

        textual = _is_stringish(t) or (t is None and isinstance(value, str))

        if op == "=":
            if textual and isinstance(value, str):
                n = _norm_text_ref(ref)
                if n is not None:
                    return n == value.strip().lower()
            return ref == value
        if op == "!=":
            if textual and isinstance(value, str):
                n = _norm_text_ref(ref)
                if n is not None:
                    return n != value.strip().lower()
            return ref != value
        if op == "<":
            return ref < value
        if op == "<=":
            return ref <= value
        if op == ">":
            return ref > value
        if op == ">=":
            return ref >= value
        if op in _LIST_OPS:
            values = value if isinstance(value, list) else [value]
            expr = None
            if textual and all(isinstance(v, str) for v in values):
                n = _norm_text_ref(ref)
                if n is not None:
                    try:
                        expr = n.isin([v.strip().lower() for v in values])
                    except Exception:
                        expr = None
            if expr is None:
                expr = ref.isin(values)
            return expr if op == "in" else ~expr
        if op == "~":
            return pc.match_substring(ref, str(value), ignore_case=True)
        if op == "!~":
            return ~pc.match_substring(ref, str(value), ignore_case=True)
        if op == "^":
            return pc.starts_with(ref, str(value), ignore_case=True)
        if op == "$":
            return pc.ends_with(ref, str(value), ignore_case=True)

        raise ValueError(
            f"Unsupported operator {op!r}. Supported: = != < <= > >= in, "
            f"'not in', contains/~, 'starts with', 'ends with'. Example:\n  "
            f"--where '{self.key}={_fmt_value(value)}'"
        )


# --------------------------------------------------------------------------
# expression parsing
# --------------------------------------------------------------------------
def _quote_mask(s: str) -> List[bool]:
    mask = [False] * len(s)
    quote = None
    for i, ch in enumerate(s):
        if quote:
            mask[i] = True
            if ch == quote:
                quote = None
        elif ch in ("'", '"'):
            quote = ch
            mask[i] = True
    return mask


def _find_operator(expr: str) -> Optional[Tuple[int, int, str]]:
    """Return (start, end, op_text) of the operator to split on."""
    mask = _quote_mask(expr)
    best: Optional[Tuple[int, int, str]] = None

    ops_by_len = sorted(set(_SYMBOLIC_OPS), key=len, reverse=True)
    for i in range(len(expr)):
        if mask[i]:
            continue
        for op in ops_by_len:
            if expr.startswith(op, i):
                best = (i, i + len(op), op)
                break
        if best:
            break

    for m in _WORD_OP_RE.finditer(expr):
        start, end = m.span(1)
        if start < len(mask) and mask[start]:
            continue
        if start == 0:  # an expression cannot start with a word operator
            continue
        cand = (start, end, re.sub(r"\s+", " ", m.group(1).strip().lower()))
        if best is None or cand[0] < best[0] or (
            cand[0] == best[0] and (cand[1] - cand[0]) > (best[1] - best[0])
        ):
            best = cand
        break

    return best


def parse_where_expr(expr: str) -> ParsedFilter:
    """Parse a single --where expression of the form 'KEY OP VALUE'.

    Accepted operator spellings (all case-insensitive):
      =  ==  is            equal (text compares ignore case)
      != <> 'is not'       not equal
      <  <=  >  >=         numeric / lexical comparison
      in  'not in'         --where 'class in [motorway,trunk]'  (brackets optional)
      ~ contains like      case-insensitive substring
      'starts with' / 'ends with'
    """
    raw = str(expr).strip()
    if not raw:
        raise ValueError(
            "--where got an empty expression. Use KEY OP VALUE, e.g. "
            "--where 'categories.primary=restaurant'."
        )

    found = _find_operator(raw)
    if found is None:
        guess = raw.split()[0] if raw.split() else raw
        raise ValueError(
            f"Filter {expr!r} has no operator. Use KEY OP VALUE, e.g.\n"
            f"  --where '{guess}=<value>'   or   --where 'height>150'\n"
            "If you typed an unquoted > or <, your shell redirected it to a "
            "file — wrap the whole expression in single quotes."
        )

    start, end, op_text = found
    key = raw[:start].strip()
    value_raw = raw[end:].strip()
    op_key = re.sub(r"\s+", " ", op_text.strip().lower())
    op = _OP_ALIASES.get(op_key)
    if op is None:
        raise ValueError(
            f"Unknown operator {op_text!r} in {expr!r}. Supported: "
            "= != < <= > >= in 'not in' contains 'starts with' 'ends with'."
        )

    if not key:
        raise ValueError(
            f"--where expression {expr!r} has an empty field name. Use "
            "KEY OP VALUE, e.g. --where 'names.primary~coffee'."
        )
    if not value_raw:
        # `field is null` style with the value swallowed by the op match
        if op in ("=", "!="):
            raise ValueError(
                f"--where expression {expr!r} has no value. Example:\n"
                f"  --where '{key}{op}<value>'   or   --where '{key}=null'"
            )
        raise ValueError(f"--where expression {expr!r} has an empty value.")

    if op in _LIST_OPS:
        value: Any = _parse_list_value(value_raw)
    else:
        value = _coerce_scalar(value_raw)
        if op in _TEXT_OPS and value is not NULL and not isinstance(value, str):
            value = value_raw.strip().strip("'\"")

    return ParsedFilter(key=key, op=op, value=value)


def parse_where_exprs(exprs: Sequence[str]) -> List[ParsedFilter]:
