# ---------------------------------------------------------------------------
# Data types
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class Division:
    id: str
    name: str
    subtype: str
    country: Optional[str]
    region: Optional[str]
    admin_level: Optional[int]
    population: Optional[int]
    parent_division_id: Optional[str]
    bbox: tuple[float, float, float, float]  # xmin, ymin, xmax, ymax

    def as_dict(self) -> dict:
        return {
            "id": self.id,
            "name": self.name,
            "subtype": self.subtype,
            "country": self.country,
            "region": self.region,
            "admin_level": self.admin_level,
            "population": self.population,
            "parent_division_id": self.parent_division_id,
            "bbox": list(self.bbox),
        }

    def label(self) -> str:
        bits = [self.name]
        where = self.region or self.country
        if where:
            bits.append(where)
        out = ", ".join(bits)
        extra = [self.subtype] if self.subtype else []
        if self.population:
            extra.append(f"pop {self.population:,}")
        if extra:
            out += " (" + ", ".join(extra) + ")"
        return out

    def suggested_query(self) -> str:
        """A ready-to-paste --in / where argument that resolves to this row."""
        qualifier = None
        if self.region and "-" in self.region:
            qualifier = self.region.split("-", 1)[1]
        elif self.region:
            qualifier = self.region
        elif self.country:
            qualifier = self.country
        return f"{self.name}, {qualifier}" if qualifier else self.name


@dataclass
class ResolveResult:
    """Divisions plus a human/AI readable trail of how they were found."""

    divisions: List[Division] = field(default_factory=list)
    notes: List[str] = field(default_factory=list)
    release: Optional[str] = None
    query: str = ""

    def as_dict(self) -> dict:
        return {
            "query": self.query,
            "release": self.release,
            "notes": list(self.notes),
            "matches": [d.as_dict() for d in self.divisions],
        }


class DataUnavailableError(LookupError):
    """The Overture release / division index could not be obtained.

    Deliberately a subclass of ``LookupError`` so that callers (and the CLI's
    existing ``LookupError`` handling around :func:`best_match`) print a clean,
    actionable message instead of a traceback.
    """


# ---------------------------------------------------------------------------
# Release + index acquisition (never raises a raw traceback)
# ---------------------------------------------------------------------------

_RELEASE_RE = re.compile(r"\d{4}-\d{2}-\d{2}(?:\.\d+)?")
_TRUEISH = {"1", "true", "yes", "on", "y"}

_release_cache: dict[str, str] = {}
_index_cache: dict[str, "pq.Table"] = {}
_warned: set[str] = set()


def _warn(message: str) -> None:
    if message in _warned:
        return
    _warned.add(message)
    try:
        print(f"botmap: {message}", file=sys.stderr)
    except Exception:  # pragma: no cover - stderr closed
        pass


def _short(exc: Optional[BaseException]) -> str:
    if exc is None:
        return "unknown error"
    text = str(exc).strip() or exc.__class__.__name__
    text = " ".join(text.split())
    if len(text) > 160:
        text = text[:157] + "..."
    return f"{exc.__class__.__name__}: {text}"


def _offline_requested() -> bool:
    return (os.environ.get("BOTMAP_OFFLINE") or "").strip().lower() in _TRUEISH


def _candidate_cache_roots() -> List[Path]:
    roots: List[Path] = []

    def add(value) -> None:
        if not value:
            return
        try:
            path = Path(str(value)).expanduser()
        except Exception:
            return
        if path not in roots:
            roots.append(path)

    try:
        from . import cache as _cache_mod
    except Exception:  # pragma: no cover
        _cache_mod = None

    if _cache_mod is not None:
        for attr in (
            "CACHE_DIR",
            "CACHE_ROOT",
            "DATA_DIR",
            "INDEX_DIR",
            "cache_dir",
            "cache_root",
            "get_cache_dir",
            "get_cache_root",
            "index_dir",
        ):
            value = getattr(_cache_mod, attr, None)
            if value is None:
                continue
            try:
                value = value() if callable(value) else value
            except Exception:
                continue
            add(value)

    for env in ("BOTMAP_CACHE_DIR", "BOTMAP_CACHE", "BOTMAP_HOME", "BOTMAP_DATA_DIR"):
        add(os.environ.get(env))

    add(Path.home() / ".cache" / "botmap")
    add(Path.home() / ".botmap")
    add(Path.cwd() / ".botmap")
    return roots


def _cached_releases() -> List[str]:
    """Release ids that already look present on local disk (newest first)."""
    found: set[str] = set()
    for root in _candidate_cache_roots():
        try:
            if not root.is_dir():
                continue
            entries = list(root.iterdir())
        except Exception:
            continue
        for entry in entries:
            for match in _RELEASE_RE.finditer(entry.name):
                found.add(match.group(0))
            if not entry.is_dir():
                continue
            try:
                children = list(entry.iterdir())
            except Exception:
                continue
            for child in children:
                for match in _RELEASE_RE.finditer(child.name):
                    found.add(match.group(0))
    return sorted(found, reverse=True)


def _unavailable_message(exc: Optional[BaseException], stage: str) -> str:
    return (
        f"Overture map data is unavailable: {stage} failed ({_short(exc)}) and no "
        "release is cached on this machine.\n"
        "This is a data-source/network problem, not a bad query — do not conclude "
        "that the place or the features do not exist.\n"
        "Try, in order:\n"
        "  1. check the catalog is reachable:\n"
        "       curl -sSI https://stac.overturemaps.org/catalog.json\n"
        "  2. pin a known release and re-run the SAME command:\n"
        "       BOTMAP_RELEASE=2024-11-13.0 botmap where 'Rhode Island, US'\n"
        "  3. use only what is already cached:\n"
        "       BOTMAP_OFFLINE=1 botmap where 'Rhode Island, US'\n"
        "(The release-catalog fetch itself lives in botmap/core.py.)"
    )


def _latest_release() -> str:
    """Best available release id.

    Order: ``BOTMAP_RELEASE`` → network catalog → newest locally cached release.
    Raises :class:`DataUnavailableError` (a LookupError) instead of letting a
    network traceback escape.
    """
    pinned = (os.environ.get("BOTMAP_RELEASE") or "").strip()
    if pinned:
        return pinned

    cached_value = _release_cache.get("release")
    if cached_value:
        return cached_value

    error: Optional[BaseException] = None
    if not _offline_requested():
        try:
            # Imported lazily so tests can monkeypatch without S3 calls.
            from .core import get_latest_release

            release = get_latest_release()
            if release:
                _release_cache["release"] = str(release)
                return str(release)
        except Exception as exc:  # network / HTTP / parse failures
            error = exc

    local = _cached_releases()
    if local:
        release = local[0]
        if not _offline_requested():
            _warn(
                "could not reach the Overture release catalog "
                f"({_short(error)}); falling back to cached release {release}"
            )
        _release_cache["release"] = release
        return release

    raise DataUnavailableError(
        _unavailable_message(error, "release-catalog lookup")
    ) from None


def current_release() -> Optional[str]:
    """Release id if it can be determined, else None (never raises)."""
    try:
        return _latest_release()
    except Exception:
        return None


def _load_index_table():
    release = _latest_release()
    if release in _index_cache:
        return _index_cache[release]

    path = None
    error: Optional[BaseException] = None
    try:
        path = ensure_index(release)
    except DataUnavailableError:
        raise
    except Exception as exc:
        error = exc
        for alternate in _cached_releases():
            if alternate == release:
                continue
            try:
                path = ensure_index(alternate)
            except Exception:
                continue
            _warn(
                f"division index for release {release} could not be fetched "
                f"({_short(exc)}); using cached release {alternate}"
            )
            release = alternate
            _release_cache["release"] = alternate
            break

    if path is None:
        raise DataUnavailableError(
            _unavailable_message(error, "division-index download")
        ) from None

    try:
        _index_cache[release] = pq.read_table(path)
    except Exception as exc:
        raise DataUnavailableError(
            f"the cached division index at {path} could not be read "
            f"({_short(exc)}).\nDelete it and retry, e.g.:\n"
            f"  rm -f {path} && botmap where 'Rhode Island, US'"
        ) from None
    return _index_cache[release]


# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------

# ISO-3166-1 alpha-3 → alpha-2 for the most common country names users type.
# Overture stores country as alpha-2 ("US", "GB"...), so a qualifier like
# "USA" or "United States" must be normalized before matching.
_COUNTRY_ALIASES = {
    "USA": "US", "UNITED STATES": "US", "UNITED STATES OF AMERICA": "US",
    "U.S.": "US", "U.S.A.": "US", "AMERICA": "US", "US": "US",
    "UK": "GB", "GBR": "GB", "BRITAIN": "GB", "GREAT BRITAIN": "GB",
    "UNITED KINGDOM": "GB", "ENGLAND": "GB",
    "CAN": "CA", "CANADA": "CA",
    "MEX": "MX", "MEXICO": "MX",
    "DEU": "DE", "GERMANY": "DE",
    "FRA": "FR", "FRANCE": "FR",
    "ITA": "IT", "ITALY": "IT",
    "ESP": "ES", "SPAIN": "ES",
    "PRT": "PT", "PORTUGAL": "PT",
    "NLD": "NL", "NETHERLANDS": "NL", "HOLLAND": "NL",
    "BEL": "BE", "BELGIUM": "BE",
    "CHE": "CH", "SWITZERLAND": "CH",
    "AUT": "AT", "AUSTRIA": "AT",
    "POL": "PL", "POLAND": "PL",
    "SWE": "SE", "SWEDEN": "SE",
    "NOR": "NO", "NORWAY": "NO",
    "DNK": "DK", "DENMARK": "DK",
    "FIN": "FI", "FINLAND": "FI",
    "IRL": "IE", "IRELAND": "IE",
    "ISL": "IS", "ICELAND": "IS",
    "RUS": "RU", "RUSSIA": "RU",
    "CHN": "CN", "CHINA": "CN",
    "JPN": "JP", "JAPAN": "JP",
    "KOR": "KR", "SOUTH KOREA": "KR", "KOREA": "KR",
    "IND": "IN", "INDIA": "IN",
    "AUS": "AU", "AUSTRALIA": "AU",
    "NZL": "NZ", "NEW ZEALAND": "NZ",
    "BRA": "BR", "BRAZIL": "BR",
    "ARG": "AR", "ARGENTINA": "AR",
    "CHL": "CL", "CHILE": "CL",
    "COL": "CO", "COLOMBIA": "CO",
    "ZAF": "ZA", "SOUTH AFRICA": "ZA",
    "EGY": "EG", "EGYPT": "EG",
    "TUR": "TR", "TURKEY": "TR", "TÜRKIYE": "TR",
    "ISR": "IL", "ISRAEL": "IL",
    "ARE": "AE", "UAE": "AE", "EMIRATES": "AE",
    "SAU": "SA", "SAUDI ARABIA": "SA",
    "THA": "TH", "THAILAND": "TH",
    "VNM": "VN", "VIETNAM": "VN",
    "IDN": "ID", "INDONESIA": "ID",
    "PHL": "PH", "PHILIPPINES": "PH",
    "MYS": "MY", "MALAYSIA": "MY",
    "SGP": "SG", "SINGAPORE": "SG",
}


# Full US state/territory names → USPS code. A qualifier like "New York" is
# normalized to "NY" so the region suffix match ("-NY" against "US-NY") fires,
# just like the short forms "NY"/"US-NY" already do.
_US_STATE_ALIASES = {
    "ALABAMA": "AL", "ALASKA": "AK", "ARIZONA": "AZ", "ARKANSAS": "AR",
    "CALIFORNIA": "CA", "COLORADO": "CO", "CONNECTICUT": "CT", "DELAWARE": "DE",
    "FLORIDA": "FL", "GEORGIA": "GA", "HAWAII": "HI", "IDAHO": "ID",
    "ILLINOIS": "IL", "INDIANA": "IN", "IOWA": "IA", "KANSAS": "KS",
    "KENTUCKY": "KY", "LOUISIANA": "LA", "MAINE": "ME", "MARYLAND": "MD",
    "MASSACHUSETTS": "MA", "MASS": "MA", "MICHIGAN": "MI", "MINNESOTA": "MN",
    "MISSISSIPPI": "MS", "MISSOURI": "MO", "MONTANA": "MT", "NEBRASKA": "NE",
    "NEVADA": "NV", "NEW HAMPSHIRE": "NH", "NEW JERSEY": "NJ",
    "NEW MEXICO": "NM", "NEW YORK": "NY", "NEW YORK STATE": "NY",
    "NORTH CAROLINA": "NC", "NORTH DAKOTA": "ND", "OHIO": "OH",
    "OKLAHOMA": "OK", "OREGON": "OR", "PENNSYLVANIA": "PA", "PENN": "PA",
    "RHODE ISLAND": "RI", "SOUTH CAROLINA": "SC", "SOUTH DAKOTA": "SD",
    "TENNESSEE": "TN", "TEXAS": "TX", "UTAH": "UT", "VERMONT": "VT",
    "VIRGINIA": "VA", "WASHINGTON": "WA", "WASHINGTON STATE": "WA",
    "WEST VIRGINIA": "WV", "WISCONSIN": "WI", "WYOMING": "WY",
    "DISTRICT OF COLUMBIA": "DC", "WASHINGTON DC": "DC", "WASHINGTON, D.C.": "DC",
    "D.C.": "DC", "DC": "DC",
    "PUERTO RICO": "PR", "GUAM": "GU", "AMERICAN SAMOA": "AS",
    "US VIRGIN ISLANDS": "VI", "U.S. VIRGIN ISLANDS": "VI",
    "NORTHERN MARIANA ISLANDS": "MP",
}

# Non-US subdivisions people commonly type as a qualifier.
_OTHER_REGION_ALIASES = {
    "ONTARIO": "ON", "QUEBEC": "QC", "QUÉBEC": "QC", "BRITISH COLUMBIA": "BC",
    "ALBERTA": "AB", "MANITOBA": "MB", "SASKATCHEWAN": "SK",
    "NOVA SCOTIA": "NS", "NEW BRUNSWICK": "NB",
    "NEWFOUNDLAND AND LABRADOR": "NL", "PRINCE EDWARD ISLAND": "PE",
    "NEW SOUTH WALES": "NSW", "VICTORIA AU": "VIC", "QUEENSLAND": "QLD",
    "WESTERN AUSTRALIA": "WA", "SOUTH AUSTRALIA": "SA", "TASMANIA": "TAS",
}


def _normalize_qualifier(q: str) -> str:
    """Apply common aliases so 'USA'/'United States' → 'US' and full US
    state names like 'New York' → 'NY' (matched as the '-NY' region suffix).

    Country aliases take precedence over state names where they would collide.
    """
    normalized = " ".join(q.strip().upper().split())
    if normalized in _COUNTRY_ALIASES:
        return _COUNTRY_ALIASES[normalized]
    if normalized in _US_STATE_ALIASES:
        return _US_STATE_ALIASES[normalized]
    if normalized in _OTHER_REGION_ALIASES:
        return _OTHER_REGION_ALIASES[normalized]
    return normalized


def _is_area_code(text: str) -> bool:
    code = _normalize_qualifier(text)
    return bool(re.fullmatch(r"[A-Z]{2}(?:-[A-Z0-9]{1,3})?", code))


# ---------------------------------------------------------------------------
# Query parsing / name variants
# ---------------------------------------------------------------------------

_LEAD_NOISE = re.compile(
    r"^(?:in|within|inside|around|near|the\s+city\s+of|city\s+of|all\s+of)\s+", re.I
)

_GENERIC_PREFIXES = (
    "city of ", "town of ", "village of ", "borough of ", "municipality of ",
    "county of ", "the ",
)
_GENERIC_SUFFIXES = (
    " city", " town", " village", " municipality", " county", " parish",
    " borough", " province", " prefecture", " district", " state",
    " region", " metropolitan area", " metro area", " metro", " area",
)


def _fold(text: str) -> str:
    """Strip accents/diacritics: 'Zürich' → 'Zurich'."""
    try:
        decomposed = unicodedata.normalize("NFKD", text)
        return "".join(ch for ch in decomposed if not unicodedata.combining(ch))
    except Exception:
        return text


def _clean(text: str) -> str:
    text = text.replace("\u2019", "'").replace("\u2018", "'")
    text = text.strip().strip("\"'")
    text = _LEAD_NOISE.sub("", text)
    return " ".join(text.split()).strip(" ,;")


def _parse_query(query: str) -> Tuple[str, List[str]]:
    """Split 'Boston, US-MA' into ('Boston', ['US-MA']).

    Also tolerates ';' / '/' separators and leading noise words ("in Boston").
    """
    text = _clean(query or "")
    parts = [p.strip() for p in re.split(r"[,;/]|\s+\|\s+", text)]
    parts = [p for p in parts if p]
    if not parts:
        return "", []
    name = parts[0]
    qualifiers = parts[1:]
    return name, qualifiers


def _split_trailing_qualifier(name: str) -> Optional[Tuple[str, str]]:
    """'Cambridge MA' → ('Cambridge', 'MA'); 'Paris France' → ('Paris','FR')."""
    words = name.split()
    if len(words) < 2:
        return None
    for take in (3, 2, 1):
        if take >= len(words):
            continue
        tail = " ".join(words[-take:])
        head = " ".join(words[:-take]).strip()
        if not head:
            continue
        upper = tail.upper()
        if (
            upper in _COUNTRY_ALIASES
            or upper in _US_STATE_ALIASES
            or upper in _OTHER_REGION_ALIASES
            or re.fullmatch(r"[A-Z]{2}(?:-[A-Z0-9]{1,3})?", upper)
        ):
            return head, tail
    return None


def _name_variants(name: str) -> List[str]:
    """Reasonable rewrites of a place name, most literal first."""
    out: List[str] = []
    seen: set[str] = set()

    def add(value: str) -> None:
        value = " ".join(value.split()).strip(" ,.-")
        if not value:
            return
        key = value.lower()
        if key in seen:
            return
        seen.add(key)
        out.append(value)

    add(name)
    add(re.sub(r"\s*\([^)]*\)", "", name))
    add(name.replace("&", " and "))
    add(name.replace(" and ", " & "))
    add(re.sub(r"^st\.?\s+", "Saint ", name, flags=re.I))
    add(re.sub(r"^saint\s+", "St. ", name, flags=re.I))
    add(re.sub(r"^saint\s+", "St ", name, flags=re.I))
    add(re.sub(r"^ste\.?\s+", "Sainte ", name, flags=re.I))
    add(re.sub(r"^mt\.?\s+", "Mount ", name, flags=re.I))
    add(re.sub(r"^mount\s+", "Mt. ", name, flags=re.I))
    add(re.sub(r"^ft\.?\s+", "Fort ", name, flags=re.I))

    low = name.lower()
    for prefix in _GENERIC_PREFIXES:
        if low.startswith(prefix) and len(low) > len(prefix) + 1:
            add(name[len(prefix):])
    for suffix in _GENERIC_SUFFIXES:
        if low.endswith(suffix) and len(low) > len(suffix) + 2:
            add(name[: -len(suffix)])

    add(_fold(name))
    return out


_ACCENT_CLASSES = {
    "a": "aàáâãäåāăą", "c": "cçćĉċč", "d": "dďđ", "e": "eèéêëēĕėęě",
    "g": "gĝğġģ", "h": "hĥħ", "i": "iìíîïĩīĭįı", "j": "jĵ", "k": "kķ",
    "l": "lĺļľłŀ", "n": "nñńņňŉ", "o": "oòóôõöøōŏőœ", "r": "rŕŗř",
    "s": "sśŝşš", "t": "tţťŧ", "u": "uùúûüũūŭůűų", "w": "wŵ",
    "y": "yýÿŷ", "z": "zźżž",
}


def _loose_regex(name: str) -> Optional[str]:
    """Regex matching `name` ignoring accents and punctuation differences."""
    folded = _fold(name).lower()
    if not folded:
        return None
    parts: List[str] = []
    for ch in folded:
        if ch in _ACCENT_CLASSES:
            parts.append("[" + _ACCENT_CLASSES[ch] + "]")
        elif ch.isalnum():
            parts.append(re.escape(ch))
        elif ch.isspace():
            parts.append(r"[\s\-'’.]+")
        else:
            parts.append(r"[\s\-'’.]*")
    return "^" + "".join(parts) + "$"


# ---------------------------------------------------------------------------
# Index helpers
# ---------------------------------------------------------------------------

_lowered_cache: dict[int, object] = {}
_ancestor_inflight: set[str] = set()


def _lowered_names(table):
    key = id(table)
    cached = _lowered_cache.get(key)
    if cached is None:
        cached = pc.utf8_lower(table.column("name_primary"))
        _lowered_cache[key] = cached
    return cached


def _mask_filter(table, mask):
    try:
        return table.filter(pc.fill_null(mask, False))
    except Exception:
        return table.filter(mask)


def _rank(table):
    """Best-match-first ordering.

    Prefer rows with a known population (real places people search for), then
    larger population, then innermost admin_level as a final tiebreaker.
    admin_level is mostly null in this index, so making it the primary key (an
    older behavior) let tiny administrative areas outrank major cities — e.g.
    the Saskatchewan "Alameda" outranked Alameda, CA.
    """
    if table.num_rows <= 1:
        return table
    try:
        annotated = table.append_column(
            "_has_pop", pc.is_valid(table.column("population"))
        )
        indices = pc.sort_indices(
            annotated,
            sort_keys=[
                ("_has_pop", "descending"),
                ("population", "descending"),
                ("admin_level", "descending"),
            ],
        )
        return annotated.take(indices).drop_columns(["_has_pop"])
    except Exception:
        return table


def _to_divisions(table, limit: Optional[int] = None) -> List[Division]:
    if limit is not None and table.num_rows > limit:
        table = table.slice(0, limit)
    rows = table.to_pylist()
    out: List[Division] = []
    for r in rows:
        try:
            out.append(
                Division(
                    id=r["id"],
                    name=r["name_primary"],
                    subtype=r["subtype"],
                    country=r["country"],
                    region=r["region"],
                    admin_level=r["admin_level"],
                    population=r["population"],
                    parent_division_id=r["parent_division_id"],
                    bbox=(
                        r["bbox_xmin"],
                        r["bbox_ymin"],
                        r["bbox_xmax"],
                        r["bbox_ymax"],
                    ),
                )
            )
        except Exception:
            continue
    return out


def _match_area_code(table, name: str):
    """Interpret the name itself as a country/region code ('RI', 'US-RI')."""
    code = _normalize_qualifier(name)
    if not re.fullmatch(r"[A-Z]{2}(?:-[A-Z0-9]{1,3})?", code):
        return None, None
    region = table.column("region")
    mask = pc.or_(pc.equal(region, code), pc.ends_with(region, f"-{code}"))
    subset = _mask_filter(table, mask)
    if subset.num_rows:
        preferred = _mask_filter(subset, pc.equal(subset.column("subtype"), "region"))
        if preferred.num_rows:
            return preferred, f"read {name!r} as the region code {code}"
        return subset, f"read {name!r} as the region code {code}"
    subset = _mask_filter(table, pc.equal(table.column("country"), code))
    if subset.num_rows:
        preferred = _mask_filter(subset, pc.equal(subset.column("subtype"), "country"))
        if preferred.num_rows:
            return preferred, f"read {name!r} as the country code {code}"
        return subset, f"read {name!r} as the country code {code}"
    return None, None


def _find_by_name(table, name: str, fuzzy: bool = True):
    """Return (subset_table_or_None, note_or_None) for a place name."""
    name = _clean(name)
    if not name:
        return None, None
    lowered = _lowered_names(table)

    # 1. exact, case-insensitive match on name_primary.
    #    (name_common was dropped from the index due to PyArrow join
    #     constraints on map<string,string> non-key fields — commit 2041f45.)
    exact = _mask_filter(table, pc.equal(lowered, name.lower()))
    if exact.num_rows:
        return exact, None

    if not fuzzy:
        return None, None

    # 2. common rewrites (Saint/St., "City of X", "X County", parentheticals).
    for variant in _name_variants(name)[1:]:
        subset = _mask_filter(table, pc.equal(lowered, variant.lower()))
        if subset.num_rows:
            return subset, f"matched {name!r} as {variant!r}"

    # 3. accent / punctuation insensitive full-name match.
    pattern = _loose_regex(name)
    if pattern:
        try:
            subset = _mask_filter(table, pc.match_substring_regex(lowered, pattern))
            if subset.num_rows:
                return subset, f"matched {name!r} ignoring accents/punctuation"
        except Exception:
            pass

    # 4. the "name" is really an area code.
    subset, note = _match_area_code(table, name)
    if subset is not None and subset.num_rows:
        return subset, note

    # 5. prefix match ("Cambr" → Cambridge, "New York" → "New York City").
    low = name.lower()
    if len(low) >= 3:
        try:
            subset = _mask_filter(table, pc.starts_with(lowered, low))
            if subset.num_rows:
                return subset, (
                    f"no division is named exactly {name!r}; used names starting "
                    f"with {name!r}"
                )
        except Exception:
            pass

    # 6. word-containment match, last resort.
    if len(low) >= 5:
        try:
            subset = _mask_filter(table, pc.match_substring(lowered, low))
            if subset.num_rows:
                return subset, (
                    f"no division is named exactly {name!r}; used names containing "
                    f"{name!r}"
                )
        except Exception:
            pass

    return None, None


def _bbox_subset(table, bbox):
    """Rows whose bbox centre falls inside `bbox` (with a small tolerance)."""
    xmin, ymin, xmax, ymax = bbox
    pad = 0.02
    cx = pc.divide(
        pc.add(table.column("bbox_xmin"), table.column("bbox_xmax")), 2.0
    )
    cy = pc.divide(
        pc.add(table.column("bbox_ymin"), table.column("bbox_ymax")), 2.0
    )
    mask = pc.and_(
        pc.and_(
            pc.greater_equal(cx, xmin - pad), pc.less_equal(cx, xmax + pad)
        ),
        pc.and_(
            pc.greater_equal(cy, ymin - pad), pc.less_equal(cy, ymax + pad)
        ),
    )
    return _mask_filter(table, mask)


def _resolve_containing_area(text: str) -> Optional[Division]:
    """Resolve a qualifier like 'Brooklyn' or 'Middlesex County' to a division."""
    key = _clean(text).lower()
    if not key or key in _ancestor_inflight:
        return None
    _ancestor_inflight.add(key)
    try:
        table = _load_index_table()
        subset, _ = _find_by_name(table, text, fuzzy=True)
        if subset is None or subset.num_rows == 0:
            return None
        divisions = _to_divisions(_rank(subset), limit=1)
        return divisions[0] if divisions else None
    except Exception:
        return None
    finally:
        _ancestor_inflight.discard(key)


def _apply_qualifier(table, qualifier: str):
    """Narrow candidates by a qualifier. Never returns an empty table.

    Returns (table, note). A note is set whenever the qualifier was
    re-interpreted or dropped, so the caller can explain itself instead of
    reporting a bare zero.
    """
    normalized = _normalize_qualifier(qualifier)
    country = table.column("country")
    region = table.column("region")
    mask = pc.or_(
        pc.or_(pc.equal(country, normalized), pc.equal(region, normalized)),
        pc.ends_with(region, f"-{normalized}"),
    )
    subset = _mask_filter(table, mask)
    if subset.num_rows:
        return subset, None

    # Not a country/region code that applies here — maybe it is a containing
    # place: "Williamsburg, Brooklyn, NY", "Downtown, Austin, TX".
    if not _is_area_code(qualifier):
        area = _resolve_containing_area(qualifier)
        if area is not None:
            inside = _bbox_subset(table, area.bbox)
            if inside.num_rows:
                return inside, (
                    f"qualifier {qualifier!r} treated as the containing area "
                    f"{area.label()}"
                )

    return table, (
        f"qualifier {qualifier!r} matched nothing and was ignored "
        "(it is not a country/region code for these candidates, and no "
        "containing area of that name was found)"
    )


# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------


def resolve_detailed(
    query: str, *, fuzzy: bool = True, limit: Optional[int] = None
) -> ResolveResult:
    """Resolve a query and report how it was interpreted."""
    raw = (query or "").strip()
    notes: List[str] = []
    name, qualifiers = _parse_query(raw)
    if not name:
        return ResolveResult([], ["empty place name"], current_release(), raw)

    table = _load_index_table()
    release = current_release()

    candidates, note = _find_by_name(table, name, fuzzy=fuzzy)

    if candidates is None or candidates.num_rows == 0:
        split = _split_trailing_qualifier(name)
        if split:
            head, tail = split
            alt, alt_note = _find_by_name(table, head, fuzzy=fuzzy)
            if alt is not None and alt.num_rows:
                candidates = alt
                note = alt_note
                qualifiers = [tail] + qualifiers
                notes.append(f"read {name!r} as {head!r} qualified by {tail!r}")

    if candidates is None or candidates.num_rows == 0:
        notes.append(f"no division in the {release or 'current'} index is named {name!r}")
        return ResolveResult([], notes, release, raw)

    if note:
        notes.append(note)

    for qualifier in qualifiers:
        candidates, qnote = _apply_qualifier(candidates, qualifier)
        if qnote:
            notes.append(qnote)

    ranked = _rank(candidates)
    divisions = _to_divisions(ranked, limit=limit)
    if len(divisions) > 1:
        notes.append(
            f"{len(divisions)} candidates; using {divisions[0].label()} — add a "
            "state/country qualifier to disambiguate, e.g. "
            f"'{divisions[0].suggested_query()}'"
        )
    return ResolveResult(divisions, notes, release, raw)


def resolve(query: str, *, fuzzy: bool = True, limit: Optional[int] = None) -> List[Division]:
    """Return all divisions matching the query (name + optional qualifiers).

    Ordered best-match-first. Unlike the previous exact-only implementation,
    this tolerates spelling/format differences and never silently returns an
    empty list just because a qualifier such as "Brooklyn" is not a region
    code — see :func:`resolve_detailed` for the interpretation notes.
    """
    return resolve_detailed(query, fuzzy=fuzzy, limit=limit).divisions


def suggest(query: str, limit: int = 8) -> List[Division]:
    """Closest real division names in the index (for error messages)."""
    try:
        table = _load_index_table()
    except Exception:
        return []
    name, _ = _parse_query(query)
    key = re.sub(r"[^a-z0-9 ]+", "", _fold(name).lower()).strip()
    if not key:
        return []
    lowered = _lowered_names(table)
    probes = [key]
    for size in (6, 5, 4, 3):
        if len(key) > size:
            probes.append(key[:size])
    for probe in probes:
        try:
            subset = _mask_filter(table, pc.starts_with(lowered, probe))
        except Exception:
            continue
        if subset.num_rows:
            return _to_divisions(_rank(subset), limit=limit)
    if len(key) >= 4:
        try:
            subset = _mask_filter(table, pc.match_substring(lowered, key))
            if subset.num_rows:
                return _to_divisions(_rank(subset), limit=limit)
        except Exception:
            pass
    return []


def no_match_message(query: str, notes: Optional[List[str]] = None) -> str:
    """A message that names the problem AND hands back a runnable command."""
    lines = [f"No map division matches {query!r}."]
    for note in (notes or [])[:4]:
        lines.append(f"  note: {note}")

    candidates = suggest(query, limit=6)
    if candidates:
        lines.append("Closest names that DO exist in the division index:")
        for division in candidates:
            lines.append(
                f"  - {division.label()}   ->  botmap where '{division.suggested_query()}'"
            )
        lines.append("Re-run with one of the names above.")
    else:
        lines.append(
            "Nothing similar is indexed. The place may be a neighborhood or an "
            "informal name."
        )
    lines.append("Other things that usually work:")
