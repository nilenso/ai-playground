@cli.command()
@click.option("-t", "--type", "type_", type=OVERTURE_TYPE, required=True)
@click.option("-r", "--release", default=None, callback=validate_release,
              required=False)
@click.option("--bbox", required=False, type=BboxParamType(),
              help="Where to pull the example feature from (default: Manhattan).")
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def schema(ctx, type_, release, bbox, json_flag):
    """Show the fields (and one example feature) for an Overture type."""
    sample_bbox = list(bbox) if bbox else [-74.020, 40.700, -73.930, 40.800]
    reader = _safe_reader(type_, sample_bbox, release, None, None, True)
    if reader is None:
        raise click.ClickException(
            f"No features available for type {type_!r} in the sample area. "
            f"Retry with --bbox over an area you know has data."
        )

    sample_row = None
    try:
        batch = reader.read_next_batch()
        if batch.num_rows > 0:
            sample_row = batch.slice(0, 1).to_pylist()[0]
    except StopIteration:
        pass

    if sample_row is not None and isinstance(sample_row.get("geometry"),
                                             (bytes, bytearray)):
        try:
            import shapely
            import shapely.wkb
            geom = shapely.wkb.loads(sample_row["geometry"])
            sample_row["geometry"] = orjson.loads(shapely.to_geojson(geom))
        except Exception:
            sample_row["geometry"] = sample_row["geometry"].hex()

    fields = flatten_schema(reader.schema)
    payload = {"type": type_, "fields": fields, "example": sample_row}

    if _json_mode(ctx, json_flag):
        _emit_json(ctx, payload)
        return

    click.secho(f"Schema for type {type_!r}", bold=True)
    for f in fields:
        click.echo(f"  {f['name']}: {f['type']}")
    click.echo()
    if sample_row is not None:
        click.secho("Example feature:", bold=True)
        click.echo(
            orjson.dumps(sample_row, default=_json_default,
                         option=orjson.OPT_INDENT_2).decode()
        )
    else:
        click.secho(
            "[botmap] No example feature found in the sample area — the field "
            "list above still applies.",
            fg="yellow", err=True,
        )


@cli.command()
@click.option("-t", "--type", "type_", type=str, default="place",
              show_default=True,
              help="Only `place` has categories; other types use `class`.")
@click.option("--bbox", required=False, type=BboxParamType())
@click.option("--in", "--place", "--location", "in_place", required=False, type=str)
@click.option("--top", default=20, show_default=True, type=int,
              help="How many values to show (use --top 300 before counting).")
@click.option("--like", required=False, type=str,
              help="Only show categories matching this substring/glob "
                   "(e.g. --like restaurant).")
@click.option("-r", "--release", default=None, callback=validate_release,
              required=False)
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.argument("extra", nargs=-1)
@click.pass_context
def categories(ctx, type_, bbox, in_place, top, like, release, json_flag, extra):
    """Enumerate `categories.primary` values in an area, most common first.

    Run this BEFORE counting a category: Overture stores only leaf categories,
    so "restaurants" or "Asian restaurants" means summing several values.
    """
    in_place, _ = _fix_unquoted(extra, in_place, [])
    type_ = OVERTURE_TYPE.convert(type_, None, ctx) if type_ else "place"
    if type_ != "place":
        verb = TYPE_TO_VERB.get(type_)
        if verb:
            raise click.UsageError(
                f"`categories` enumerates `categories.primary` for place "
                f"features. For `{type_}`, the classifying field is `class` — "
                f"run `botmap --json schema -t {type_}` to see the fields, or "
                f"filter directly with `botmap {verb} --class <value>`."
            )
        raise click.UsageError(
            f"`categories` only enumerates `categories.primary` for place "
            f"features. Run `botmap --json schema -t {type_}` to inspect fields."
        )

    bbox, loc_flag = _bbox_from_location(in_place, bbox, required=True)

    counts = _enumerate_categories(bbox, release)
    if not counts:
        click.secho(
            "[botmap] No place categories found in this area. Either the area "
            "has no POIs (check it with `botmap where <place>`) or the bbox is "
            "wrong. `botmap count -t place " + loc_flag + "` will tell you "
            "which.",
            fg="yellow", err=True,
        )
        if _json_mode(ctx, json_flag):
            _emit_json(ctx, [])
        return

    if like:
        pattern = like.lower()
        if not any(c in pattern for c in "*?"):
            pattern = f"*{pattern}*"
        counts = {k: v for k, v in counts.items()
                  if fnmatch.fnmatch(k.lower(), pattern)}
        if not counts:
            click.secho(
                f"[botmap] No categories here match {like!r}. Rerun without "
                f"--like to see the full list.",
                fg="yellow", err=True,
            )

    ranked = sorted(counts.items(), key=lambda kv: kv[1], reverse=True)
    shown = ranked[:top]
    payload = [{"value": v, "count": c} for v, c in shown]

    if _json_mode(ctx, json_flag):
        _emit_json(ctx, payload)
        return
    for row in payload:
        click.echo(f"  {row['count']:>8,}  {row['value']}")
    if len(ranked) > len(shown):
        click.secho(
            f"  … {len(ranked) - len(shown)} more values; rerun with "
            f"--top {len(ranked)} to see them all.",
            fg="yellow",
        )
    click.secho(
        f"  Count several at once: botmap count -t place {loc_flag} "
        f"--category \"a,b,c\"  (or --category @group, see `botmap groups`)",
        fg="bright_black",
    )


@cli.command()
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def capabilities(ctx, json_flag):
    """Emit a machine-readable manifest of all subcommands and flags."""
    payload = {
        "version": importlib.metadata.version("botmap"),
        "recipes": [{"question": q, "command": c} for q, c in RECIPES],
        "category_groups": sorted(CATEGORY_GROUPS),
        "commands": _walk_group(cli),
    }
    if _json_mode(ctx, json_flag):
        _emit_json(ctx, payload)
        return
    for c in payload["commands"]:
        click.secho(c["name"], bold=True)
        if c["help"]:
            click.echo(f"  {c['help'].splitlines()[0]}")


@cli.group()
def cache():
    """Manage the on-disk divisions index."""
    pass


@cache.command("info")
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def cache_info_cmd(ctx, json_flag):
    """Show cache location, current release, and up-to-date status."""
    latest = _latest_release_safe()
    try:
        data = cache_info(latest_release=latest or "unknown")
    except Exception as e:
        raise click.ClickException(
            f"Could not read the cache: {type(e).__name__}: {e}\n"
            f"Try `botmap cache clear` then `botmap cache build`."
        )
    if _json_mode(ctx, json_flag):
        _emit_json(ctx, data)
        return
    click.echo(f"Cache path:      {data['index_path']}")
    click.echo(f"Cached release:  {data['index_release'] or '(none)'}")
    click.echo(f"Latest release:  {data['latest_release']}")
    click.echo(f"Up to date:      {data['up_to_date']}")
    click.echo(f"Size:            {data['size_bytes']:,} bytes")


