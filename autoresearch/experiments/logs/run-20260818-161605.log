def suggest_commands(question: str) -> List[str]:
    """Best-guess commands for a plain-English question (keyword based)."""
    q = str(question).lower()
    out: List[str] = []
    for pattern, cmd in _QUESTION_KEYWORDS:
        if re.search(pattern, q) and cmd not in out:
            out.append(cmd)
    if not out:
        out.append("botmap themes    # then: botmap examples")
    return out


