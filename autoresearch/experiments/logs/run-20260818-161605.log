def is_ambiguous_place(name: str) -> Optional[str]:
    """Return a disambiguation note if this place name is famously ambiguous."""
    key = re.sub(r"[.\s]+", " ", str(name).strip().lower()).strip()
    key = re.sub(r"^(the )", "", key)
    if "," in key:  # already qualified by the caller
        return None
    return AMBIGUOUS_PLACE_NAMES.get(key)


def ambiguity_hint(name: str) -> List[str]:
    """Hints to print when a bare, ambiguous place name is used."""
    note = is_ambiguous_place(name)
    if not note:
        return []
    return [
        f"'{name}' is ambiguous: {note}.",
        f"List every candidate first:  botmap where '{name}' --all",
        "Then re-run with the qualified name, e.g. "
        f"--in '{name}, <region>, <country>'.",
    ]


# ---------------------------------------------------------------------------
# Zero-result explanations. Never let "0" be reported without a reason.
# ---------------------------------------------------------------------------

def explain_zero_results(
    type_name: Optional[str] = None,
    area: Optional[str] = None,
    filters: Optional[Dict[str, Any]] = None,
    where: Optional[str] = None,
) -> Dict[str, Any]:
    """Build a structured "0 results, and here is why it might be wrong" block.

    Returns {"result_count": 0, "warning": ..., "hints": [...], "try": [...]}.
    Callers (cli.py) should splice this into any empty response so an assistant
    never reads a bare 0 as "there are none here".
    """
    canon = resolve_type(type_name) if type_name else None
    filters = dict(filters or {})
    hints: List[str] = [
        "0 features matched. This may mean the filter vocabulary is wrong, "
        "not that the area is empty. Verify before answering 'none'.",
    ]
    tries: List[str] = []

    if area:
        for line in ambiguity_hint(area):
            hints.append(line)
        tries.append(f"botmap where {area!r} --all      # confirm the area resolved")

    enum_for_type = ENUM_FIELDS.get(canon or "", {})
    for field, value in filters.items():
        fkey = _norm(field)
        if fkey in enum_for_type and value is not None:
            vals = [v.strip() for v in str(value).split(",") if v.strip()]
            allowed = enum_for_type[fkey]
            bad = [v for v in vals if _norm(v) not in allowed]
            if bad:
                hints.append(
                    f"{canon}.{fkey}={bad[0]!r} is not a valid value. "
                    f"Valid: {', '.join(allowed)}."
                )
            if canon == "segment" and fkey == "class":
                hints.append(
                    "Small countries and dense cities often have zero "
                    "'motorway'; their main roads are 'trunk' or 'primary'."
                )
                tries.append(
                    f"botmap roads --in {area or '<area>'!r} --class trunk,primary"
                )
            elif allowed:
                tries.append(
                    f"botmap {'query --type ' + canon if canon else 'query'} "
                    f"--in {area or '<area>'!r} --{fkey} {allowed[0]}"
                )

    if canon == "place":
        cat = filters.get("category") or filters.get("categories")
        if cat:
            cands = resolve_place_category(str(cat))
            hints.append(
                f"Place categories are snake_case Overture values. "
                f"Candidates for {str(cat)!r}: {', '.join(cands) or 'unknown'}."
            )
            tries.append(
                f"botmap places --in {area or '<area>'!r} "
                f"--category-search {str(cat).split()[0]}   # loose match"
            )
        tries.append(
            f"botmap places --in {area or '<area>'!r} --top-categories   "
            "# what actually exists here"
        )

    if where:
        hints.append(
            f"Check the --where expression {where!r}: field names come from "
            f"'botmap schema {canon or '<type>'}', units are metres for height, "
            "and the expression must be single-quoted in the shell."
        )

    if canon:
        tries.append(f"botmap schema {canon}    # list queryable fields")
        tries.append(
            f"botmap query --type {canon} --in {area or '<area>'!r} --count   "
            "# is the area non-empty at all?"
        )
    else:
        tries.append("botmap examples    # task -> command table")

    seen: set = set()
    ordered_tries = [t for t in tries if not (t in seen or seen.add(t))]
    return {
        "result_count": 0,
        "warning": "no features matched -- do NOT report 'none' without checking",
        "hints": hints,
        "try": ordered_tries[:5],
    }


# ---------------------------------------------------------------------------
# Upstream / exception translation (used by cli.py's top-level handler).
# ---------------------------------------------------------------------------

# Known-good Overture release ids, newest first. core.py should fall back to
# these when the STAC catalog cannot be reached instead of raising HTTPError.
FALLBACK_RELEASES: List[str] = [
    "2025-01-22.0",
    "2024-11-13.0",
    "2024-09-18.0",
    "2024-07-22.0",
]

UPSTREAM_FAILURE_HINT = (
    "Could not reach the Overture release catalog. This is an upstream/network "
    "problem, not a bad command. Retry pinning a release explicitly, e.g. "
    "'botmap --release {release} <command>', or set "
    "OVERTURE_RELEASE={release} in the environment."
).format(release=FALLBACK_RELEASES[0])


def describe_exception(exc: BaseException, command: Optional[str] = None) -> Dict[str, Any]:
    """Turn an exception into a named problem + a ready-to-run replacement.

    cli.py should wrap its dispatch in
        except Exception as e: emit(describe_exception(e, argv_string)); exit(2)
    so no user ever sees a raw traceback.
    """
    name = type(exc).__name__
    msg = str(exc) or name
    low = msg.lower()
    status = getattr(exc, "code", None)

    info: Dict[str, Any] = {"error": name, "message": msg}

    is_http = name in ("HTTPError", "URLError", "TimeoutError", "socket.timeout") or (
        "urlopen" in low or "http error" in low or "connection" in low
        or "temporary failure in name resolution" in low or "timed out" in low
    )
    if is_http:
        info["problem"] = (
            "The Overture STAC release catalog could not be fetched"
            + (f" (HTTP {status})" if status else "")
            + ". The data endpoint is unreachable or has moved."
        )
        info["upstream"] = True
        info["hint"] = UPSTREAM_FAILURE_HINT
        base = command or "<command>"
        info["try"] = [
            f"botmap --release {FALLBACK_RELEASES[0]} {base}",
            f"OVERTURE_RELEASE={FALLBACK_RELEASES[1]} botmap {base}",
            "botmap releases      # list release ids the tool knows about",
        ]
        info["known_releases"] = list(FALLBACK_RELEASES)
        info["do_not"] = (
            "Do not answer from general knowledge as if it came from the map "
            "data; say the lookup failed, or retry with a pinned release."
        )
        return info

    if isinstance(exc, ValueError) or name in ("KeyError", "ValueError"):
        info["problem"] = msg
        info["try"] = ["botmap themes", "botmap examples"]
        return info

    info["problem"] = f"{name}: {msg}"
    info["try"] = ["botmap examples    # task -> command table"]
    return info


# ---------------------------------------------------------------------------
# Schema helpers
# ---------------------------------------------------------------------------

def flatten_schema(schema: pa.Schema, expand_lists: bool = True) -> List[dict]:
    """Flatten a (possibly nested) Arrow schema into a list of dotted field rows.

    Each row is {"name": "categories.primary", "type": "string"}.
    Lists are reported as themselves and, when ``expand_lists`` is set, their
    struct children are also reported using ``names.rules[].value`` notation so
    an assistant can see every queryable leaf.
    """
    out: List[dict] = []
    seen: set = set()

    def _emit(name: str, type_) -> None:
        if name and name not in seen:
            seen.add(name)
            out.append({"name": name, "type": str(type_)})

    def _element_type(type_):
        try:
            if pa.types.is_list(type_) or pa.types.is_large_list(type_) \
                    or pa.types.is_fixed_size_list(type_):
                return type_.value_type
        except Exception:
            pass
        return None

    def _walk(prefix: str, type_, depth: int = 0) -> None:
        if depth > 8:
            _emit(prefix, type_)
            return
        try:
            is_struct = pa.types.is_struct(type_)
        except Exception:
            is_struct = False
        if is_struct:
            for i in range(type_.num_fields):
                child = type_.field(i)
                child_name = f"{prefix}.{child.name}" if prefix else child.name
                _walk(child_name, child.type, depth + 1)
            return
        _emit(prefix, type_)
        if expand_lists:
            elem = _element_type(type_)
            if elem is not None:
                try:
                    if pa.types.is_struct(elem):
                        _walk(f"{prefix}[]", elem, depth + 1)
                except Exception:
                    pass

    for field in schema:
        _walk(field.name, field.type)
    return out


def search_schema(schema: pa.Schema, term: str) -> List[dict]:
    """Fields whose dotted name contains ``term`` (case-insensitive)."""
    needle = str(term).strip().lower()
    return [row for row in flatten_schema(schema) if needle in row["name"].lower()]


def schema_field_notes(type_name: Optional[str]) -> List[str]:
    """Practical notes to print alongside a schema dump."""
    canon = resolve_type(type_name) if type_name else None
    notes = [
        "Nested fields use dotted paths in --where, e.g. \"categories.primary='cafe'\".",
        "Always single-quote --where in the shell: --where 'height>100' "
        "(unquoted, '>' creates a file called 100).",
    ]
    if canon == "building":
        notes += [
            "height is in METRES and is often NULL -- 'height>100' silently "
            "drops buildings with unknown height.",
            "num_floors is a floor count; class values: "
            + ", ".join(BUILDING_CLASSES[:8]) + ", ...",
        ]
    elif canon == "segment":
        notes += ["class values: " + ", ".join(ROAD_CLASSES) + "."]
    elif canon == "place":
        notes += [
            "Filter POIs on categories.primary (snake_case), e.g. 'cafe', "
            "'hospital', 'gas_station'. names.primary is the display name.",
        ]
    elif canon in ("division", "division_area"):
        notes += ["subtype values: " + ", ".join(DIVISION_SUBTYPES) + "."]
    elif canon == "address":
        notes += ["Key fields: number, street, unit, postcode, country."]
    if canon and canon in TYPE_COMMAND_HINTS:
        notes.append("Typical command: " + TYPE_COMMAND_HINTS[canon])
    return notes


def describe_type(type_name: str) -> Dict[str, Any]:
    """Everything an assistant needs about one type, aliases accepted."""
    canon = resolve_type(type_name)
    if canon is None:
        raise ValueError(
            f"Unknown type {type_name!r}. Available: {', '.join(_all_types())}. "
            f"Run 'botmap types' (or 'botmap themes') to see them."
        )
    return {
        "name": canon,
        "theme": theme_of(canon),
        "description": TYPE_DESCRIPTIONS.get(canon, ""),
        "example": TYPE_COMMAND_HINTS.get(canon, ""),
        "enums": ENUM_FIELDS.get(canon, {}),
        "notes": schema_field_notes(canon),
    }


def unknown_type_error(type_name: str) -> ValueError:
    """A ValueError that names the problem and hands back a runnable command."""
    guess = resolve_type(type_name)
    if guess:
        return ValueError(
            f"{type_name!r} is not an Overture type name; you probably mean "
            f"{guess!r}. Try: {TYPE_COMMAND_HINTS.get(guess, 'botmap query --type ' + guess)}"
        )
    return ValueError(
        f"Unknown type {type_name!r}. Valid types: {', '.join(_all_types())}. "
        "Run 'botmap types' to list them, or 'botmap examples' for "
        "question -> command recipes."
    )


def unknown_theme_error(theme: str) -> ValueError:
    guess = resolve_theme(theme)
    if guess:
        return ValueError(
            f"{theme!r} is not a theme name; you probably mean {guess!r}. "
            f"Try: {THEME_COMMAND_HINTS.get(guess, 'botmap types --theme ' + guess)}"
        )
    return ValueError(
        f"Unknown theme {theme!r}. Valid themes: "
        f"{', '.join(sorted(THEME_DESCRIPTIONS))}. Run 'botmap themes'."
    )


