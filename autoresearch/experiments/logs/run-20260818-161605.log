def _norm_ws(s: str) -> str:
    return re.sub(r"\s+", " ", s.strip())


def _strip_quotes(s: str) -> str:
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
        return s[1:-1]
    return s


