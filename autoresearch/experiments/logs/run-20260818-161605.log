    """Remove all divisions-index files from the cache."""
    n = clear_cache()
    click.echo(f"Removed {n} cache file(s).")


@cache.command("build")
def cache_build_cmd():
    """Force a rebuild of the divisions index against the latest release."""
    release = _latest_release()
    click.secho(f"Building divisions index for release {release}...",
                fg="bright_black", err=True)
    p = build_index(release)
    click.secho(f"Wrote {p}", fg="green", err=True)


# ---------------------------------------------------------------------------
# Convenience verbs
# ---------------------------------------------------------------------------

def _finish_verb(ctx, type_, bbox, release, filters, output_format, output,
                 limit, loc_flag, json_flag, category=None):
    """Shared body for the per-type convenience verbs."""
    if json_flag and _param_default(ctx, "output_format"):
        output_format = "geojson"
    if output_format == "geoparquet" and output is None:
        raise click.UsageError("Output file (-o/--output) is required for geoparquet")
    output_file = sys.stdout if output is None else output

    reader = _safe_reader(
        type_, bbox, release, None, None, True, where_filters=filters or None,
    )
    if reader is None:
        _explain_zero(type_, bbox, release, filters, location_flag=loc_flag)
        return
    if limit is not None:
        reader = _limit_reader(reader, limit)

    with get_writer(output_format, output_file, schema=reader.schema) as writer:
        rows = copy(reader, writer)

    if rows == 0:
        _explain_zero(type_, bbox, release, filters, location_flag=loc_flag)
    elif category is not None:
        _umbrella_hint(category)


@cli.command()
@click.option("--in", "--place", "--location", "in_place", required=False, type=str,
              help='Place name, e.g. --in "Boston, MA".')
@click.option("--bbox", required=False, type=BboxParamType(),
              help="Bounding box xmin,ymin,xmax,ymax. Exclusive with --in.")
@click.option("--category", "--categories", required=False, type=str,
              help="Leaf category, comma list, @group or glob. "
                   "Examples: --category cafe / --category @asian / "
                   "--category '*restaurant*'")
@click.option("--where", "where_exprs", multiple=True)
@click.option("-n", "--limit", "limit", default=None, type=int,
              help="Maximum number of features to emit (default: all matches).")
@click.option("-f", "output_format",
              type=click.Choice(["geojson", "geojsonseq", "geoparquet"]),
              default="geojsonseq", show_default=True)
@click.option("-o", "--output", required=False, type=click.Path())
@click.option("-r", "--release", default=None, callback=validate_release,
              required=False)
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.argument("extra", nargs=-1)
@click.pass_context
def places(ctx, in_place, bbox, category, where_exprs, limit, output_format,
           output, release, json_flag, extra):
    """POIs/businesses in a place. Use --category for "how many X" style asks.

    Just need the number? `botmap count --in "PLACE" --category X` is cheaper.
    """
    in_place, where_exprs = _fix_unquoted(extra, in_place, where_exprs)
    bbox, loc_flag = _bbox_from_location(in_place, bbox, required=True)

    try:
        filters = [parse_where_expr(e) for e in where_exprs]
    except ValueError as e:
        raise click.UsageError(str(e))
    if category is not None:
        cf = _category_filter(category, bbox, release)
        if cf is not None:
            filters.append(cf)

    _finish_verb(ctx, "place", bbox, release, filters, output_format, output,
                 limit, loc_flag, json_flag, category=category)


