def _hint(msg: str) -> None:
    """One-line advisory on stderr (never on stdout, never JSON-polluting)."""
    if os.environ.get("BOTMAP_NO_HINTS"):
        return
    if msg in _HINTS_SHOWN:
        return
    _HINTS_SHOWN.add(msg)
    try:
        print("note: " + msg, file=sys.stderr)
    except Exception:  # pragma: no cover - stderr closed
        pass


def _is_stringish(t: Optional[pa.DataType]) -> bool:
    return t is not None and (pa.types.is_string(t) or pa.types.is_large_string(t))


def _is_listish(t: pa.DataType) -> bool:
    return (
        pa.types.is_list(t)
        or pa.types.is_large_list(t)
        or pa.types.is_fixed_size_list(t)
    )


def _quote_if_needed(v: Any) -> str:
    s = str(v)
    return f"'{s}'" if (" " in s or "," in s) else s


# ---------------------------------------------------------------------------
# value coercion
# ---------------------------------------------------------------------------

_NULL_LITERALS = {"null", "none", "nil", "nan", "na", "n/a"}

_UNIT_FACTORS = {
    "m": 1.0,
    "meter": 1.0,
    "meters": 1.0,
    "metre": 1.0,
    "metres": 1.0,
    "ft": 0.3048,
    "foot": 0.3048,
    "feet": 0.3048,
    "km": 1000.0,
    "mi": 1609.344,
    "mile": 1609.344,
    "miles": 1609.344,
}

_NUM_UNIT_RE = re.compile(
    r"^(-?\d+(?:\.\d+)?)\s*([a-zA-Z/]+)?$"
)


def _coerce_scalar(raw: str) -> Union[str, int, float, bool, None]:
    """Best-effort type guess for an unquoted --where value."""
    s = raw.strip()
    if not s:
        return ""
    low = s.lower()
    if low in ("true", "yes"):
        return True
    if low in ("false", "no"):
        return False
    if low in _NULL_LITERALS:
        return None
    try:
        return int(s)
    except ValueError:
        pass
    try:
        return float(s)
    except ValueError:
        pass
    return _strip_quotes(s)


def _parse_list_value(raw: str) -> List[Any]:
    """Accept [a,b,c], (a,b,c), a,b,c and even a bare single value."""
    s = raw.strip()
    if s.startswith("[") and s.endswith("]"):
        inner = s[1:-1]
    elif s.startswith("(") and s.endswith(")"):
        inner = s[1:-1]
    else:
        inner = s
    parts = [p for p in (chunk.strip() for chunk in inner.split(",")) if p]
    if not parts:
        raise ValueError(
            f"`in` needs at least one value; got {raw!r}. "
            "Try: --where 'categories.primary in [hospital,clinic]'"
        )
    return [_coerce_scalar(p) for p in parts]


# ---------------------------------------------------------------------------
# schema introspection: flatten to dotted paths
# ---------------------------------------------------------------------------

def _field_paths(
    schema: pa.Schema, max_depth: int = 3
) -> Dict[str, Tuple[pa.DataType, bool]]:
    """Map dotted path -> (type, filterable).

    Paths that live *inside* a list column are reported with filterable=False:
    pc.field() cannot reach them, and pretending otherwise produces silent
    zero-row results.
    """
    out: Dict[str, Tuple[pa.DataType, bool]] = {}

    def walk(fields, prefix: str, depth: int, in_list: bool) -> None:
        for f in fields:
            path = prefix + f.name
            t = f.type
            out[path] = (t, not in_list)
            if depth >= max_depth:
                continue
            if pa.types.is_struct(t):
                walk(
                    [t.field(i) for i in range(t.num_fields)],
                    path + ".",
                    depth + 1,
                    in_list,
                )
            elif _is_listish(t):
                vt = t.value_type
                if pa.types.is_struct(vt):
                    walk(
                        [vt.field(i) for i in range(vt.num_fields)],
                        path + ".",
                        depth + 1,
                        True,
                    )

    try:
        walk(list(schema), "", 0, False)
    except Exception:  # pragma: no cover - never let introspection crash a query
        for name in getattr(schema, "names", []):
            out.setdefault(name, (pa.string(), True))
    return out


# Common English/obvious spellings -> real Overture paths, in preference order.
_ALIASES: Dict[str, List[str]] = {
    "name": ["names.primary", "name", "names.common", "primary_name"],
