class OvertureTypeParamType(click.ParamType):
    """Accepts canonical Overture type names plus the obvious spellings."""

    name = "type"

    def convert(self, value, param, ctx):
        if value is None:
            return None
        if not isinstance(value, str):
            return value
        raw = value.strip()
        v = raw.lower().replace("-", "_").replace(" ", "_")
        try:
            types = list(get_all_overture_types())
        except Exception:
            types = []
        if v in types:
            return v
        if v in TYPE_ALIASES and TYPE_ALIASES[v] in types:
            return TYPE_ALIASES[v]
        if v in TYPE_ALIASES and not types:
            return TYPE_ALIASES[v]
        if v.endswith("s") and v[:-1] in types:
            return v[:-1]
        import difflib
        close = difflib.get_close_matches(v, types, n=3, cutoff=0.6)
        hint = f" Did you mean: {', '.join(close)}?" if close else ""
        self.fail(
            f"Unknown feature type {raw!r}.{hint} "
            f"Valid types: {', '.join(sorted(types))}. "
            f"Run `botmap types` for one-line descriptions.",
            param, ctx,
        )


OVERTURE_TYPE = OvertureTypeParamType()


# ---------------------------------------------------------------------------
# Release discovery, with an S3 fallback when STAC is unreachable
# ---------------------------------------------------------------------------

_RELEASE_CACHE: dict = {}


def _s3_release_list() -> list[str]:
    """List release directories straight off S3 (no STAC catalog needed)."""
    if "s3_list" in _RELEASE_CACHE:
        return _RELEASE_CACHE["s3_list"]
    releases: list[str] = []
    try:
        import pyarrow.fs as pafs
        fs = pafs.S3FileSystem(anonymous=True, region="us-west-2",
                               connect_timeout=15, request_timeout=30)
        sel = pafs.FileSelector("overturemaps-us-west-2/release", recursive=False)
        infos = fs.get_file_info(sel)
        releases = sorted(
            i.base_name for i in infos
            if i.type == pafs.FileType.Directory and i.base_name
        )
        releases.reverse()  # newest first
    except Exception:
        releases = []
    _RELEASE_CACHE["s3_list"] = releases
    return releases


def _available_releases_safe() -> list[str]:
    """Best-effort release list. Empty list means 'could not determine'."""
    if "available" in _RELEASE_CACHE:
        return _RELEASE_CACHE["available"]
    out: list[str] = []
    try:
        available, _ = get_available_releases()
        out = list(available)
    except Exception:
        out = _s3_release_list()
        if out:
            click.secho(
                "[botmap] stac.overturemaps.org unreachable; read the release "
                "list from S3 instead.",
                fg="yellow", err=True,
            )
    _RELEASE_CACHE["available"] = out
    return out


def _latest_release_safe() -> str | None:
    if "latest" in _RELEASE_CACHE:
        return _RELEASE_CACHE["latest"]
    latest = None
    try:
        latest = get_latest_release()
    except Exception:
        candidates = _s3_release_list()
        latest = candidates[0] if candidates else None
        if latest:
            click.secho(
                f"[botmap] stac.overturemaps.org unreachable; using latest "
                f"release {latest} discovered on S3.",
                fg="yellow", err=True,
            )
    _RELEASE_CACHE["latest"] = latest
    return latest


def _latest_release() -> str:
    latest = _latest_release_safe()
    if latest:
        return latest
    raise click.ClickException(
        "Could not determine the latest Overture release: both "
        "stac.overturemaps.org and the S3 release listing are unreachable.\n"
        "If you know a release id, pass it explicitly, e.g.:\n"
        f"  {_current_command_line()} -r 2025-01-22.0\n"
        "Release ids look like YYYY-MM-DD.N and are listed at "
        "https://docs.overturemaps.org/release-calendar"
    )


def validate_release(ctx, param, value):
    """Validate --release, degrading gracefully when the catalog is offline."""
    if value is None:
        return _latest_release()
    available = _available_releases_safe()
    if not available:
        click.secho(
            f"[botmap] Could not verify release {value!r} (release catalog "
            f"unreachable); using it as given.",
            fg="yellow", err=True,
        )
        return value
    if value not in available:
        raise click.UsageError(
            f"Release '{value}' is not available. Overture keeps only the last "
            f"two monthly releases (~60 days).\n\n"
            f"Available releases: {', '.join(available)}\n"
            f"Ready to run: "
            f"{_current_command_line().replace(value, available[0])}\n"
            f"Release notes: https://docs.overturemaps.org/release-calendar"
        )
    return value


# ---------------------------------------------------------------------------
# Data access wrappers (never leak a traceback; retry without STAC)
# ---------------------------------------------------------------------------

def _safe_reader(type_, bbox, release, ct, rt, stac, **kw):
    """record_batch_reader with schema errors -> UsageError and STAC fallback."""
    try:
        return record_batch_reader(type_, bbox, release, ct, rt, stac, **kw)
    except ValueError as e:
        raise click.UsageError(str(e))
    except click.ClickException:
        raise
    except Exception as e:
        if stac:
            click.secho(
                f"[botmap] STAC catalog unavailable ({type(e).__name__}); "
                f"retrying the same query with --no-stac.",
                fg="yellow", err=True,
            )
            try:
                return record_batch_reader(type_, bbox, release, ct, rt, False, **kw)
            except ValueError as e2:
                raise click.UsageError(str(e2))
            except Exception as e2:
                raise click.ClickException(_network_message(e2, "Reading features"))
        raise click.ClickException(_network_message(e, "Reading features"))


def _safe_count(type_, **kw):
    """count_rows with schema errors -> UsageError and STAC fallback."""
    try:
        return count_rows(type_, **kw)
    except ValueError as e:
        raise click.UsageError(str(e))
    except click.ClickException:
        raise
    except Exception as e:
        if kw.get("stac", False):
            click.secho(
                f"[botmap] STAC catalog unavailable ({type(e).__name__}); "
                f"retrying the count with --no-stac.",
                fg="yellow", err=True,
            )
            kw2 = dict(kw)
            kw2["stac"] = False
            try:
                return count_rows(type_, **kw2)
            except ValueError as e2:
                raise click.UsageError(str(e2))
            except Exception as e2:
                raise click.ClickException(_network_message(e2, "Counting features"))
        raise click.ClickException(_network_message(e, "Counting features"))


def _quiet_count(type_, bbox, release):
    """Unfiltered count for zero-result explanations; None if unavailable."""
    try:
        return count_rows(type_, bbox=bbox, release=release, stac=True)
    except Exception:
        try:
            return count_rows(type_, bbox=bbox, release=release, stac=False)
        except Exception:
            return None


