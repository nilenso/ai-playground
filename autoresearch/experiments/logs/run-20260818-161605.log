def _safe_reader(type_, bbox, release, ct, rt, stac, **kw):
    """Wrap record_batch_reader, converting schema-validation ValueError."""
    try:
        return record_batch_reader(type_, bbox, release, ct, rt, stac, **kw)
    except ValueError as e:
        raise click.UsageError(str(e))


def _safe_count(type_, **kw):
    """Wrap count_rows, converting schema-validation ValueError."""
    try:
        return count_rows(type_, **kw)
    except ValueError as e:
        raise click.UsageError(str(e))


def _parse_latlon(latlon: str) -> tuple[float, float]:
    """Parse 'LAT,LON' string into (lat, lon) floats."""
    parts = [p.strip() for p in str(latlon).replace(" ", ",").split(",") if p.strip()]
    if len(parts) != 2:
        raise click.UsageError(
            "LATLON must be 'LAT,LON' (latitude first). "
            "Example: botmap containing 37.80,-122.27"
        )
    try:
        lat, lon = float(parts[0]), float(parts[1])
    except ValueError:
        raise click.UsageError(
            "LATLON values must be numeric, e.g. 37.80,-122.27"
        )
    if not (-90 <= lat <= 90):
        if -90 <= lon <= 90:
            raise click.UsageError(
                f"Latitude {lat} is out of range. Arguments are LAT,LON "
                f"(latitude first) — did you mean {lon},{lat}?"
            )
        raise click.UsageError(f"Latitude must be between -90 and 90, got {lat}")
    if not (-180 <= lon <= 180):
        raise click.UsageError(f"Longitude must be between -180 and 180, got {lon}")
    return lat, lon


def _json_default(value):
    """Fallback serializer for orjson — hex-encode raw bytes."""
    if isinstance(value, (bytes, bytearray)):
        return value.hex()
    raise TypeError(f"Type is not JSON serializable: {type(value).__name__}")


def _emit_json(ctx, payload, file=None):
    """Print one JSON document to stdout."""
    out = orjson.dumps(
        payload, default=_json_default, option=orjson.OPT_INDENT_2
    ).decode()
    click.echo(out, file=file)


def _emit_error_json(message, code="error"):
    """Print a JSON error envelope to stderr."""
    err = {"error": {"code": code, "message": message}}
    click.echo(orjson.dumps(err).decode(), err=True)


def _json_mode(ctx, flag=False) -> bool:
    obj = getattr(ctx, "obj", None) or {}
    return bool(flag or obj.get("json"))


def _fmt_bbox(bbox) -> str:
    if bbox is None:
        return "(none)"
    return ",".join(f"{float(v):.5f}" for v in bbox)


def _describe_division(d) -> str:
    """One-line label like 'Alameda (locality, US-CA, pop 78,280)'."""
    qual = d.region or d.country or "?"
    pop = f"pop {d.population:,}" if d.population is not None else "pop ?"
    return f"{d.name} ({d.subtype}, {qual}, {pop})"


# ---------------------------------------------------------------------------
# Value scanning / fuzzy suggestions (0-result recovery machinery)
# ---------------------------------------------------------------------------

_MAX_DIAG_BATCHES = 40


def _field_array(batch, field: str):
    """Return the (possibly nested) column `field` from `batch`, or None."""
    parts = str(field).split(".")
    names = set(batch.schema.names)
    if parts[0] not in names:
        return None
    col = batch.column(parts[0])
    for p in parts[1:]:
        try:
            col = pc.struct_field(col, p)
        except Exception:
            return None
    return col


def _schema_has_field(schema, field: str) -> bool:
    return str(field).split(".")[0] in set(schema.names)


def _scan_values(type_, bbox, release, field: str,
                 max_batches: int = _MAX_DIAG_BATCHES):
    """Scan `bbox` and tally distinct values of `field`.

    Returns (counts_dict, truncated). counts_dict is None when the field does
    not exist on this type. Bounded on purpose: this only ever runs on a
    failure/diagnostic path, and must not turn a fast query into a timeout.
    """
    try:
        reader = record_batch_reader(type_, bbox, release, None, None, True)
    except Exception:
        return {}, False
    if reader is None:
        return {}, False
    counts: dict = {}
    truncated = False
    seen_batches = 0
    while seen_batches < max_batches:
        try:
            batch = reader.read_next_batch()
        except StopIteration:
            break
        except Exception:
            break
        seen_batches += 1
        if batch.num_rows == 0:
            continue
        arr = _field_array(batch, field)
        if arr is None:
            return None, False
        try:
            for item in pc.value_counts(arr).to_pylist():
                v = item["values"]
                if v is None:
                    continue
                counts[v] = counts.get(v, 0) + item["counts"]
        except Exception:
            continue
    else:
        truncated = True
    return counts, truncated


def _rank_candidates(target, values, n: int = 5) -> list:
    """Token-aware fuzzy ranking of `values` against `target`."""
    import difflib

    t = str(target).lower()
    ttok = set(t.replace("_", " ").replace("-", " ").split())
    matcher = difflib.SequenceMatcher(autojunk=False)
    matcher.set_seq1(t)
    scored = []
    for v in values:
        vl = str(v).lower()
        matcher.set_seq2(vl)
        ratio = matcher.ratio()
        vtok = set(vl.replace("_", " ").replace("-", " ").split())
        overlap = len(ttok & vtok)
        sub = int(t in vl or vl in t)
        if overlap or sub or ratio >= 0.70:
            scored.append((ratio + 0.2 * overlap + 0.15 * sub, str(v)))
    scored.sort(key=lambda x: x[0], reverse=True)
    return [v for _, v in scored[:n]]


def _suggest_categories(type_: str, bbox, release, target: str, n: int = 3):
    """Back-compat helper: closest `categories.primary` values in bbox."""
    counts, _ = _scan_values(type_, bbox, release, "categories.primary")
    if not counts:
        return []
    return _rank_candidates(target, counts.keys(), n=n)


