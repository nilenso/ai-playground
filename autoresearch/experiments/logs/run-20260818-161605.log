# Frequently asked-for place categories -> the Overture `categories.primary`
# value(s) that actually match. Plain-English on the left.
PLACE_CATEGORY_ALIASES: Dict[str, List[str]] = {
    "coffee shop": ["cafe", "coffee_shop"],
    "coffee shops": ["cafe", "coffee_shop"],
    "coffee": ["cafe", "coffee_shop"],
