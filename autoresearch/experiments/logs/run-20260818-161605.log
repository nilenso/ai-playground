# ---------------------------------------------------------------------------
# Operator vocabulary
# ---------------------------------------------------------------------------

# Canonical operators understood by ParsedFilter.to_pyarrow_expression().
#   =  !=  <  <=  >  >=          comparisons
#   in / not in                  membership against a [a,b,c] list
#   ~  / !~                      case-insensitive substring (contains)
#   ^= / $=                      case-insensitive starts-with / ends-with
#   is_null / not_null           null tests (value is None)
SUPPORTED_OPS = (
    "=", "!=", "<", "<=", ">", ">=",
    "in", "not in",
    "~", "!~", "^=", "$=",
    "is_null", "not_null",
)

# Symbol operators, longest first so `>=` is not mistaken for `>`.
_SYMBOL_OPS: Tuple[str, ...] = (
    "!=", "<>", ">=", "<=", "==", "!~", "=~", "^=", "$=",
    "=", "<", ">", "~",
)

# Only consulted if nothing above matched, so `website=http://x` still splits
# on the `=` rather than on the colon.
_FALLBACK_SYMBOL_OPS: Tuple[str, ...] = (":",)

# Word operators, matched case-insensitively and requiring whitespace around
# them, so `is_bridge=true` / `min_height>2` are never mis-split.
_WORD_OP_RE = re.compile(
    r"\s+(not\s+in|is\s+not|not\s+like|starts?[_\s]?with|ends?[_\s]?with|"
    r"in|is|like|ilike|contains|matches|eq|neq|ne|gte|lte|gt|lt|ge|le)\s+",
    re.IGNORECASE,
)

_OP_CANONICAL: Dict[str, str] = {
    "=": "=", "==": "=", ":": "=", "eq": "=",
    "!=": "!=", "<>": "!=", "ne": "!=", "neq": "!=",
    "<": "<", "lt": "<",
    "<=": "<=", "le": "<=", "lte": "<=",
    ">": ">", "gt": ">",
    ">=": ">=", "ge": ">=", "gte": ">=",
    "in": "in",
    "not in": "not in",
    "~": "~", "=~": "~", "like": "~", "ilike": "~",
    "contains": "~", "matches": "~",
    "!~": "!~", "not like": "!~",
    "^=": "^=", "startswith": "^=", "starts with": "^=", "starts_with": "^=",
    "$=": "$=", "endswith": "$=", "ends with": "$=", "ends_with": "$=",
    "is": "is", "is not": "is not",
}

# Values that mean "missing" when written unquoted.
_NULL_WORDS = {"null", "none", "nil", "nan", "na", "n/a", "missing", "empty"}

# Backwards compatibility: some callers imported this name.
_OPERATORS = ["<=", ">=", "!=", " in ", "=", "<", ">"]


