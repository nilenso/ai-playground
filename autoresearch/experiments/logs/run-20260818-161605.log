# Leaf names that mean "restrict to an area" -- the area flag does this properly.
_AREA_LEAVES = {
    "locality", "city", "town", "region", "state", "country",
    "postcode", "postal_code", "zip", "zipcode",
}


# ---------------------------------------------------------------------------
# ParsedFilter
# ---------------------------------------------------------------------------

@dataclass(frozen=True)
class ParsedFilter:
    key: str
    # User-facing ops: = != < <= > >= in "not in" ~ !~ ^ $ isnull notnull
    # (~ is also synthesized internally by subcommands such as `addresses --street`)
    op: str
    value: Any  # str | int | float | bool | list | None
    raw: Optional[str] = None  # original text of the value, if it came from --where

    # -- rendering -------------------------------------------------------
    def render(self, key: Optional[str] = None, value: Any = None) -> str:
        k = key if key is not None else self.key
        v = self.value if value is None else value
        if self.op in _NULL_OPS:
            word = "is null" if self.op == "isnull" else "is not null"
            return f"{k} {word}"
        if self.op in ("in", "not in"):
            items = ",".join(str(x) for x in (v if isinstance(v, list) else [v]))
            return f"{k} {self.op} [{items}]"
        return f"{k}{self.op}{v}"

    def suggest(self, key: Optional[str] = None, value: Any = None) -> str:
        return f"--where '{self.render(key, value)}'"

    # -- schema resolution ----------------------------------------------
    def _resolve(self, schema: pa.Schema) -> Tuple[str, Optional[pa.DataType]]:
        paths = _field_paths(schema)
        key = (self.key or "").strip()
        if not key:
            raise ValueError(
                "--where expression has an empty field name. "
                f"Use KEY OP VALUE, e.g. --where 'height>150'. {_OP_HELP}"
            )

        lower_map: Dict[str, str] = {}
        for p in paths:
            lower_map.setdefault(p.lower(), p)

        candidates: List[str] = []

        # 1. exact / case-insensitive exact
        if key in paths:
            candidates.append(key)
        elif key.lower() in lower_map:
            candidates.append(lower_map[key.lower()])

        # 2. alias table
        for alias_target in _ALIASES.get(key.lower(), []):
            if alias_target in paths:
                candidates.append(alias_target)
            elif alias_target.lower() in lower_map:
                candidates.append(lower_map[alias_target.lower()])

        # 3. unique suffix match ("primary" -> "names.primary" if unambiguous)
        suffix_hits = [
            p for p in paths
            if p.lower() == key.lower() or p.lower().endswith("." + key.lower())
        ]
        filterable_suffix = [p for p in suffix_hits if paths[p][1]]
        if len(filterable_suffix) == 1:
            candidates.append(filterable_suffix[0])
        candidates.extend(suffix_hits)

        # first filterable candidate wins
        for cand in candidates:
            if cand in paths and paths[cand][1]:
                if cand != key:
                    _hint(
                        f"field {key!r} resolved to {cand!r} "
                        f"(use {self.suggest(cand)} next time)"
                    )
                return cand, paths[cand][0]

        # candidate exists but lives inside a list column -> explain + replace
        for cand in candidates:
            if cand in paths and not paths[cand][1]:
                raise ValueError(self._list_field_error(cand, paths))

        raise ValueError(self._unknown_field_error(key, paths, suffix_hits))

    # -- error text -------------------------------------------------------
    def _list_field_error(self, path: str, paths) -> str:
        top = path.split(".")[0]
        leaf = path.split(".")[-1].lower()
        lines = [
            f"Cannot use --where on {path!r}: {top!r} is a list column, so "
            "--where cannot reach inside it (a dotted filter here would silently "
            "match 0 rows).",
        ]
        if leaf in _AREA_LEAVES:
            lines.append(
                "  To restrict results to a place, use the area flag instead, e.g.:"
            )
            lines.append(
                f"    --in '{_strip_quotes(str(self.value))}'   "
                "(also accepts 'Cambridge, MA', a country, a county, a bbox)"
            )
        if leaf in ("street", "number", "housenumber", "house_number"):
            lines.append(
                "  For street/house-number lookups use the addresses command:"
            )
            lines.append(
                f"    botmap addresses --street {_quote_if_needed(self.value)} "
                "--in 'Cambridge, MA'"
            )
        top_type = paths.get(top, (None, True))[0]
        if top_type is not None and _is_stringish(top_type):
            lines.append(f"  Or match the text column directly: {self.suggest(top)}")
        lines.append(
            "  Filterable fields: "
            + ", ".join(sorted(p for p, (_t, ok) in paths.items() if ok)[:40])
        )
        return "\n".join(lines)

    def _unknown_field_error(self, key: str, paths, suffix_hits) -> str:
        filterable = sorted(p for p, (_t, ok) in paths.items() if ok)
        close = difflib.get_close_matches(key.lower(), [p.lower() for p in filterable],
                                          n=3, cutoff=0.5)
        lower_map = {p.lower(): p for p in filterable}
        close_real = [lower_map[c] for c in close]
        lines = [f"Unknown --where field {key!r} for this data type."]
        if close_real:
            lines.append("  Did you mean: " + ", ".join(repr(c) for c in close_real))
            lines.append(f"  Ready to run: {self.suggest(close_real[0])}")
        if len(suffix_hits) > 1:
            lines.append(
                "  Ambiguous short name; qualify it: "
                + ", ".join(repr(p) for p in sorted(suffix_hits)[:6])
            )
        lines.append(
            "  Filterable fields here: " + (", ".join(filterable[:40]) or "(none)")
        )
        lines.append(
            "  List every field with:  botmap schema -t <TYPE>   "
            "(e.g. botmap schema -t place | botmap schema -t building)"
        )
        lines.append(
            "  Common shortcuts: name -> names.primary, category -> "
            "categories.primary, city -> use --in 'City, ST' instead of --where."
        )
        return "\n".join(lines)

    # -- value typing -----------------------------------------------------
    def _coerce_value(self, value: Any, t: Optional[pa.DataType], key: str) -> Any:
        if value is None or t is None:
            return value

        if _is_stringish(t):
            if isinstance(value, str):
                out = value
            elif isinstance(value, bool):
                out = "true" if value else "false"
            elif self.raw is not None:
                out = _strip_quotes(self.raw)  # keeps leading zeros: 02139
            else:
                out = str(value)
            return self._normalize_text_value(out, key)

        if pa.types.is_boolean(t):
            if isinstance(value, bool):
                return value
            s = str(value).strip().lower()
            if s in ("true", "yes", "y", "t", "1"):
                return True
            if s in ("false", "no", "n", "f", "0"):
                return False
            raise ValueError(
                f"{key!r} is a boolean field but the value is {value!r}. "
                f"Try: {self.suggest(key, 'true')}"
            )

        if pa.types.is_integer(t) or pa.types.is_floating(t) or pa.types.is_decimal(t):
            num = self._to_number(value, key)
            if pa.types.is_integer(t) and isinstance(num, float) and num.is_integer():
                return int(num)
            if pa.types.is_integer(t) and isinstance(num, int):
                return num
            return float(num)

        return value

    def _to_number(self, value: Any, key: str) -> Union[int, float]:
        if isinstance(value, bool):
            return int(value)
        if isinstance(value, (int, float)):
            return value
        s = str(value).strip().replace(",", "").replace("_", "")
        m = _NUM_UNIT_RE.match(s)
        if m:
            num = float(m.group(1))
            unit = (m.group(2) or "").lower()
            if unit:
                factor = _UNIT_FACTORS.get(unit)
                if factor is None:
                    raise ValueError(
                        f"{key!r} is numeric; cannot understand the unit in "
                        f"{value!r}. Use a plain number, e.g. "
                        f"{self.suggest(key, int(num))}"
                    )
                if factor != 1.0:
                    _hint(
                        f"converted {value!r} to {num * factor:g} "
                        f"({key} is stored in metres)"
                    )
                num = num * factor
            return int(num) if float(num).is_integer() else num
        raise ValueError(
            f"{key!r} is a numeric field but the value {value!r} is not a number.\n"
            f"  Numbers: {self.suggest(key, 150)}\n"
            f"  For text matching use a text field instead, e.g. "
            f"--where 'names.primary~{_strip_quotes(str(value))}'"
        )

    def _normalize_text_value(self, value: str, key: str) -> str:
        """Nudge obviously-wrong enum spellings into Overture's snake_case."""
        klow = key.lower()
        enumish = (
            klow.endswith("categories.primary")
            or klow in ("subtype", "class", "category")
            or klow.endswith(".class")
            or klow.endswith(".subtype")
        )
        if not enumish or self.op not in ("=", "!=", "in", "not in"):
            return value
        norm = re.sub(r"[^a-z0-9]+", "_", value.strip().lower()).strip("_")
        if norm and norm != value.strip().lower():
            _hint(
                f"{key} values are lowercase snake_case; matching {norm!r} "
                f"instead of {value!r}"
            )
            value = norm
        if "categories" in klow or klow == "category":
            _hint(
                "if a category filter returns 0 rows the value is probably not a "
                "real Overture category -- list the real ones with: "
                "botmap categories -t place --in 'AREA' --top 400"
            )
        return value

    # -- expression -------------------------------------------------------
    def to_pyarrow_expression(self, schema: pa.Schema) -> pc.Expression:
        """Build a pc.Expression resolving (and repairing) keys against `schema`."""
        key, t = self._resolve(schema)
        parts = key.split(".")
        ref = pc.field(*parts) if len(parts) > 1 else pc.field(parts[0])
        op = self.op

        # normalize legacy / alternate op spellings
        op = {"is null": "isnull", "is not null": "notnull", "==": "=",
              "<>": "!=", "notin": "not in"}.get(op, op)

        if op == "isnull":
            return ref.is_null()
        if op == "notnull":
            return ref.is_valid()

        if self.value is None:
            if op == "=":
                return ref.is_null()
            if op == "!=":
                return ref.is_valid()

        if op in _TEXT_ONLY_OPS and t is not None and not _is_stringish(t):
            raise ValueError(
                f"Operator {op!r} only works on text fields, and {key!r} is "
                f"{t}.\n  For numbers use a comparison: {self.suggest(key, 150)}"
            )

        if op in ("in", "not in"):
            values = self.value if isinstance(self.value, list) else [self.value]
            values = [self._coerce_value(v, t, key) for v in values]
            if _is_stringish(t):
                lowered = [str(v).strip().lower() for v in values if v is not None]
                expr = self._lower(ref).isin(lowered)
            else:
                expr = ref.isin(values)
            return ~expr if op == "not in" else expr

        value = self._coerce_value(self.value, t, key)

        if _is_stringish(t) and isinstance(value, str):
            v = value.strip()
            if op == "=":
                return self._lower(ref) == v.lower()
            if op == "!=":
                return self._lower(ref) != v.lower()
            if op == "~":
                return pc.match_substring(ref, v, ignore_case=True)
            if op == "!~":
                return ~pc.match_substring(ref, v, ignore_case=True)
            if op == "^":
                try:
                    return pc.starts_with(ref, pattern=v, ignore_case=True)
                except TypeError:
                    return pc.match_substring_regex(ref, "^" + re.escape(v),
                                                    ignore_case=True)
            if op == "$":
                try:
                    return pc.ends_with(ref, pattern=v, ignore_case=True)
                except TypeError:
                    return pc.match_substring_regex(ref, re.escape(v) + "$",
                                                    ignore_case=True)

        if op == "=":
            return ref == value
        if op == "!=":
            return ref != value
        if op == "<":
            return ref < value
        if op == "<=":
            return ref <= value
        if op == ">":
            return ref > value
        if op == ">=":
            return ref >= value
        if op == "~":
            return pc.match_substring(ref, str(value), ignore_case=True)
        if op == "!~":
            return ~pc.match_substring(ref, str(value), ignore_case=True)

        raise ValueError(
            f"Unsupported operator {self.op!r} in --where. {_OP_HELP}"
        )

    @staticmethod
    def _lower(ref: pc.Expression) -> pc.Expression:
        """Case-folded field reference; falls back to the raw field if unsupported."""
        try:
            return pc.utf8_lower(ref)
        except Exception:  # pragma: no cover - very old pyarrow
            return ref

    # -- validation -------------------------------------------------------
    def validate_against_schema(self, schema: pa.Schema) -> None:
        """Verify the key resolves (after alias repair); raise ValueError otherwise."""
        self._resolve(schema)


# ---------------------------------------------------------------------------
# parsing
# ---------------------------------------------------------------------------

def parse_where_expr(expr: str) -> ParsedFilter:
    """Parse a single --where expression of the form 'KEY OP VALUE'."""
    if expr is None:
        raise ValueError("--where needs an expression, e.g. --where 'height>150'")
    text = expr.strip()
    if not text:
        raise ValueError("--where got an empty expression, e.g. --where 'height>150'")

    best: Optional[Tuple[int, int, str, str]] = None  # (start, end, canon, literal)

    for literal, canon in _SYMBOL_OPS:
        idx = text.find(literal)
        if idx <= 0:  # 0 would mean an empty key
            continue
        cand = (idx, idx + len(literal), canon, literal)
        if (
            best is None
            or cand[0] < best[0]
            or (cand[0] == best[0] and len(literal) > len(best[3]))
        ):
            best = cand

    m = _WORD_OP_PATTERN.search(text)
    if m:
        word = _norm_ws(m.group(1)).lower()
        canon = _WORD_OPS.get(word)
        if canon and m.start(1) > 0:
            cand = (m.start(1), m.end(1), canon, m.group(1))
            if best is None or cand[0] < best[0]:
                best = cand

    if best is None:
        looks_like_place = ("," in text) or (" " in text and not any(
            c in text for c in "=<>~"))
        extra = ""
        if looks_like_place:
            extra = (
                f"\n  If you meant 'restrict to this area', that is not --where:\n"
                f"    --in '{text}'          (e.g. --in 'Cambridge, MA')\n"
                f"    botmap where '{text}'  (just resolve the area / bbox)"
            )
        raise ValueError(
            f"--where {expr!r} has no operator.\n"
            f"  Use KEY OP VALUE, for example:\n"
            f"    --where 'height>150'\n"
            f"    --where 'subtype=residential'\n"
            f"    --where 'names.primary~cambridge'      (~ = contains, any case)\n"
            f"    --where 'categories.primary in [hospital,clinic]'\n"
            f"  {_OP_HELP}\n"
            f"  Always wrap the expression in single quotes so the shell does not "
            f"turn > or < into a file redirect."
            f"{extra}"
        )

    key = text[: best[0]].strip()
    raw_value = text[best[1]:].strip()
    op = best[2]

    if not key:
        raise ValueError(
            f"--where {expr!r} has an empty field name. "
            f"Use KEY OP VALUE, e.g. --where 'height>150'."
        )

    if op in _NULL_OPS:
        return ParsedFilter(key=key, op=op, value=None, raw=None)

    if not raw_value:
        word = "is null" if op == "=" else "is not null"
        raise ValueError(
            f"--where {expr!r} has no value after {op!r}.\n"
            f"  Did you want a null check?  --where '{key} {word}'\n"
            f"  Otherwise supply a value:   --where '{key}{op}VALUE'"
        )

    if op in ("in", "not in"):
        value: Any = _parse_list_value(raw_value)
    else:
        value = _coerce_scalar(raw_value)
        if value is None and op in ("=", "!="):
            return ParsedFilter(
                key=key, op="isnull" if op == "=" else "notnull",
                value=None, raw=raw_value,
            )

    return ParsedFilter(key=key, op=op, value=value, raw=raw_value)


# ---------------------------------------------------------------------------
# combining
# ---------------------------------------------------------------------------

def combine(
    filters: Union[List[ParsedFilter], ParsedFilter, None], schema: pa.Schema
) -> Optional[pc.Expression]:
    """AND-combine filters, validating/repairing each against the schema."""
    if filters is None:
        return None
    if isinstance(filters, ParsedFilter):
        filters = [filters]
    if not filters:
        return None

    exprs: List[pc.Expression] = []
    for f in filters:
        try:
            exprs.append(f.to_pyarrow_expression(schema))
        except ValueError:
            raise
        except Exception as exc:  # never leak a raw traceback to the assistant
            raise ValueError(
                f"Could not build a filter from --where "
                f"'{f.render()}': {type(exc).__name__}: {exc}\n"
                f"  Check the field with:  botmap schema -t <TYPE>\n"
                f"  {_OP_HELP}"
            ) from None

    result = exprs[0]
    for e in exprs[1:]:
        result = result & e
    return result


