              help="Street name (case-insensitive substring).")
@click.option("--number", required=False, type=str,
              help="House/building number (exact; field is a string, so "
                   "\"1208\" or \"1208A\").")
@click.option("--postcode", required=False, type=str,
              help="Postal code (exact match).")
@click.pass_context
def addresses(ctx, in_place, bbox, where_exprs, limit, count_only,
              output_format, output, release, json_flag, street, number,
              postcode):
    """Addresses in a named place or bbox.

    --street uses case-insensitive substring match ("Fountain" matches
    "Fountain St", "E Fountain Blvd"). --number and --postcode are exact.
    An area (--in/--bbox) is required: the global address dataset is too large
    to scan unfiltered.
    """
    filters = _parse_where(where_exprs)
    if street:
        filters.append(ParsedFilter(key="street", op="~", value=street))
    if number:
        filters.append(ParsedFilter(key="number", op="=", value=str(number)))
    if postcode:
        filters.append(ParsedFilter(key="postcode", op="=", value=str(postcode)))
    _run_features(
        ctx, "address", in_place, bbox, filters, None, limit, output_format,
        output, release, count_only=count_only, json_flag=json_flag,
        example='botmap addresses --in "Providence, RI" --street Fountain',
    )


# ---------------------------------------------------------------------------
# at (nearest neighbour)
# ---------------------------------------------------------------------------

@cli.command()
@click.argument("latlon", type=str)
@click.option("-t", "--type", "type_", type=OvertureTypeParam(),
              default="place", show_default=True)
@click.option("-n", default=10, show_default=True, type=int)
@click.option("-r", "--radius", type=int, required=False,
              help="Radius in meters; defaults per type.")
@click.option("--category", "categories_", multiple=True,
              help="POI category filter (repeatable).")
@click.option("--name", required=False, type=str,
              help="Substring on names.primary or brand.names.primary.")
@click.option("--where", "where_exprs", multiple=True,
              help="Attribute filter K OP V (repeatable).")
@click.option("-f", "output_format",
              type=click.Choice(["geojson", "geojsonseq", "geoparquet"]),
              default="geojsonseq", show_default=True)
@click.option("-o", "--output", required=False, type=click.Path())
@click.option("--release", default=None, callback=validate_release,
              required=False)
@click.option("--json", "json_flag", is_flag=True, default=False, hidden=True)
def at(latlon, type_, n, radius, categories_, name, where_exprs, output_format,
       output, release, json_flag):
    """Nearest features to a point. LATLON is 'LAT,LON' (latitude first).

    \b
    botmap at 40.75,-73.99 --category coffee_shop -n 5
    botmap at 37.80,-122.27 -t building -r 200
    """
    lat, lon = _parse_latlon(latlon)

    if radius is None:
        radius = DEFAULT_RADIUS_BY_TYPE.get(type_, 100)
    bbox = list(bbox_around_point(lat, lon, radius))

    filters = _parse_where(where_exprs)
    cats = [c for c in (categories_ or []) if c]
    row_parts = []
    if len(cats) == 1:
        filters.append(ParsedFilter(key="categories.primary", op="=", value=cats[0]))
    elif len(cats) > 1:
        row_parts.append(FieldSetFilter("categories.primary", cats))
    if name:
        row_parts.append(NameFilter(name=name))
    row_filter = _combine_filters(row_parts)

    reader = _safe_reader(
        type_, bbox, release, None, None, True, where_filters=filters or None,
    )
    if reader is None:
        _explain_zero(type_, bbox, release, filters, row_filter, None)
        return
    if row_filter is not None:
        row_filter.validate(reader.schema, type_)

    import shapely.wkb

    stats: dict = {"rows": 0}
    rows: list[tuple[float, dict, bytes]] = []
    while True:
        try:
            batch = reader.read_next_batch()
        except StopIteration:
            break
        if batch.num_rows == 0:
            continue
        if row_filter is not None:
            batch = row_filter.apply(batch, stats)
            if batch.num_rows == 0:
                continue
        geom_blobs = batch.column("geometry").to_pylist()
        prop_cols = [c for c in batch.schema.names if c not in ("geometry", "bbox")]
        prop_rows = batch.select(prop_cols).to_pylist()
        for blob, prop in zip(geom_blobs, prop_rows):
            try:
                geom = shapely.wkb.loads(blob)
                centroid = geom.centroid
                d = haversine_meters(lat, lon, centroid.y, centroid.x)
            except Exception:
                continue
            rows.append((d, prop, blob))

    rows.sort(key=lambda x: x[0])
    rows = rows[:n]

    if output_format == "geoparquet" and output is None:
        raise click.UsageError("Output file (-o/--output) is required for geoparquet")
    output_file = sys.stdout if output is None else output

    if not rows:
        click.secho(
            f"[botmap] 0 features within {radius} m of {lat},{lon}. "
            f"Retry with a larger --radius (e.g. -r {radius * 5}) — "
            f"then diagnostics below.",
            fg="yellow", err=True,
        )
        _explain_zero(type_, bbox, release, filters, row_filter, None)
        return

    kept_names = [nm for nm in reader.schema.names if nm not in ("bbox",)]
    new_schema = pa.schema(
        [(nm, reader.schema.field(nm).type) for nm in kept_names]
    )
    if reader.schema.metadata:
        new_schema = new_schema.with_metadata(reader.schema.metadata)

    out_rows = []
    for _, prop, blob in rows:
        row = dict(prop)
        row["geometry"] = blob
        out_rows.append(row)
    batch = pa.RecordBatch.from_pylist(out_rows, schema=new_schema)
    one_shot = pa.RecordBatchReader.from_batches(new_schema, iter([batch]))

    with get_writer(output_format, output_file, schema=new_schema) as writer:
        copy(one_shot, writer)

    click.secho(
        f"[botmap] {len(rows)} nearest `{type_}` feature(s); closest "
        f"{rows[0][0]:.0f} m, farthest {rows[-1][0]:.0f} m "
        f"(search radius {radius} m).",
        fg="bright_black", err=True,
    )


# ---------------------------------------------------------------------------
# division_area polygon plumbing
# ---------------------------------------------------------------------------

def _get_division_area_files(release: str, candidate_bbox: tuple) -> list:
    """Return S3 paths for division_area files that intersect candidate_bbox."""
    import io
    import pyarrow.parquet as _pq
    import pyarrow.compute as _pc
    from urllib.request import urlopen

    stac_cache = _get_division_area_files._stac_cache  # type: ignore[attr-defined]
    stac_table = stac_cache.get(release)
    if release not in stac_cache:
        stac_url = f"https://stac.overturemaps.org/{release}/collections.parquet"
        try:
            with urlopen(stac_url, timeout=30) as response:
                buf = io.BytesIO(response.read())
            stac_table = _pq.read_table(buf)
        except Exception:
            stac_table = None
        stac_cache[release] = stac_table

    if stac_table is None:
        return []

    xmin, ymin, xmax, ymax = candidate_bbox
    type_filter = (
        (_pc.field("collection") == "division_area")
        & (_pc.field("type") == "Feature")
    )
    bbox_filter = (
        (_pc.field("bbox", "xmin") < xmax)
        & (_pc.field("bbox", "xmax") > xmin)
        & (_pc.field("bbox", "ymin") < ymax)
        & (_pc.field("bbox", "ymax") > ymin)
    )
    try:
        rows = stac_table.filter(type_filter & bbox_filter).to_pylist()
    except Exception:
        return []
    result = []
    for r in rows:
        try:
            href = r["assets"]["aws"]["alternate"]["s3"]["href"]
            result.append(href[len("s3://"):])
        except (KeyError, TypeError):
            continue
    return result


_get_division_area_files._stac_cache = {}  # type: ignore[attr-defined]


_polygon_cache: dict[str, object] = {}


def _s3_division_area_dataset(release, bbox_hint=None):
    import pyarrow.dataset as ds
    import pyarrow.fs as _fs

    fs = _fs.S3FileSystem(
        anonymous=True, region="us-west-2",
        connect_timeout=30, request_timeout=120,
    )
    files = []
    if bbox_hint is not None:
        try:
            files = _get_division_area_files(release, tuple(bbox_hint))
        except Exception:
            files = []
    if files:
        return ds.dataset(files, filesystem=fs, format="parquet")
    path = (
        f"overturemaps-us-west-2/release/{release}"
        "/theme=divisions/type=division_area/"
    )
    return ds.dataset(path, filesystem=fs)


def _prefetch_polygons(division_ids: list[str], lon: float, lat: float,
                       release: str, bbox_hint=None) -> None:
    """Batch-fetch division_area polygons into the polygon cache."""
    import shapely.wkb
    from shapely.ops import unary_union

    cache = _polygon_cache
    uncached = [did for did in division_ids if did not in cache]
    if not uncached:
        return

    dataset = _s3_division_area_dataset(release, bbox_hint)
    filter_expr = pc.field("division_id").isin(uncached)
    table = dataset.to_table(columns=["division_id", "geometry"],
                             filter=filter_expr)

    by_id: dict[str, list] = {did: [] for did in uncached}
    for row in table.to_pylist():
        by_id.setdefault(row["division_id"], []).append(row["geometry"])

    for did in uncached:
        geom_blobs = by_id.get(did, [])
        if geom_blobs:
            geoms = [shapely.wkb.loads(b) for b in geom_blobs]
            cache[did] = unary_union(geoms)
        else:
            cache[did] = None


def _polygon_contains(division_id: str, lon: float, lat: float,
                      candidate_bbox: tuple | None = None,
                      geometry_wkb: bytes | None = None) -> bool:
    """True if the division_area polygon for `division_id` contains the point."""
    import shapely.wkb

    cache = _polygon_cache
    if division_id in cache:
        poly = cache[division_id]
    elif geometry_wkb is not None:
        poly = shapely.wkb.loads(geometry_wkb)
        cache[division_id] = poly
    else:
        release = get_latest_release()
        dataset = _s3_division_area_dataset(release, candidate_bbox)
        filter_expr = (
            (pc.field("division_id") == division_id)
            & (pc.field("bbox", "xmin") <= lon)
            & (pc.field("bbox", "xmax") >= lon)
            & (pc.field("bbox", "ymin") <= lat)
            & (pc.field("bbox", "ymax") >= lat)
        )
        table = dataset.to_table(columns=["geometry"], filter=filter_expr)
        if table.num_rows == 0:
            cache[division_id] = None
            return False
        geoms = [shapely.wkb.loads(b) for b in table.column("geometry").to_pylist()]
        from shapely.ops import unary_union
        poly = unary_union(geoms)
        cache[division_id] = poly

    if poly is None:
        return False
    from shapely.geometry import Point
    return poly.contains(Point(lon, lat))


def _fetch_division_polygon(division, release):
    """Return a shapely polygon for `division`, or None.

    Order of attempts (cheapest first, so `boundary` stays fast):
      1. process cache
      2. geometry stored in the local divisions index, if present
      3. S3 division_area, narrowed to the 1-3 Parquet files that intersect
         the division's own bbox via the STAC catalog
    """
    did = division.id
    if did in _polygon_cache and _polygon_cache[did] is not None:
        return _polygon_cache[did]

    import shapely.wkb
    from shapely.ops import unary_union

    # 2. local index
    try:
        from .cache import ensure_index
        p = ensure_index(release)
        tbl = pq.read_table(p)
        if "geometry_wkb" in tbl.schema.names and "id" in tbl.schema.names:
            sub = tbl.filter(pc.field("id") == did)
            if sub.num_rows:
                blobs = [b for b in sub.column("geometry_wkb").to_pylist() if b]
                if blobs:
                    poly = unary_union([shapely.wkb.loads(b) for b in blobs])
                    _polygon_cache[did] = poly
                    return poly
    except Exception:
        pass

    # 3. S3, narrowed by STAC using the division's bbox
    try:
        _prefetch_polygons([did], 0.0, 0.0, release, bbox_hint=tuple(division.bbox))
    except Exception as e:
        raise click.ClickException(
            f"Could not fetch the boundary polygon for "
            f"{_describe_division(division)}: {e}. Retry, or use the bbox "
            f"from `botmap where \"{division.name}\"` as an approximation "
            f"(--bbox {_fmt_bbox(division.bbox)})."
        )
    return _polygon_cache.get(did)


def _emit_division_geometry(ctx, division, output=None) -> None:
    """Print `division`'s polygon as a GeoJSON Feature (stdout or file)."""
    from shapely.geometry import mapping

    release = get_latest_release()
    poly = _fetch_division_polygon(division, release)
    if poly is None:
        raise click.UsageError(
            f"No division_area polygon is published for "
            f"{_describe_division(division)} (id {division.id}). "
            f"Fallbacks: use its bounding box "
            f"(--bbox {_fmt_bbox(division.bbox)}), or try a different admin "
            f"level, e.g. `botmap boundary \"{division.name} County\"` or the "
            f"parent region."
        )
    feature = {
        "type": "Feature",
        "geometry": mapping(poly),
        "properties": {
            "id": division.id,
            "name": division.name,
            "subtype": division.subtype,
            "country": division.country,
            "region": division.region,
        },
    }
    if output:
        path = os.path.abspath(os.path.expanduser(output))
        with open(path, "wb") as fh:
            fh.write(orjson.dumps(feature, default=_json_default,
                                  option=orjson.OPT_INDENT_2))
        click.secho(
            f"[botmap] Wrote boundary polygon for "
            f"{_describe_division(division)} to {path} "
            f"(bbox {_fmt_bbox(division.bbox)}).",
            fg="green", err=True,
        )
        return
    _emit_json(ctx, feature)
    click.secho(
        f"[botmap] Boundary of {_describe_division(division)}; "
        f"bbox {_fmt_bbox(division.bbox)}.",
        fg="bright_black", err=True,
    )


@cli.command()
@click.argument("latlon", type=str)
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def containing(ctx, latlon, json_flag):
    """Reverse geocode: which divisions contain this point?

    Innermost (highest admin_level) first. LATLON is 'LAT,LON'.
    """
    lat, lon = _parse_latlon(latlon)

    release = get_latest_release()
    from .cache import ensure_index
    index_p = ensure_index(release)
    table = pq.read_table(index_p)

    expr = (
        (pc.field("bbox_xmin") <= lon)
        & (pc.field("bbox_xmax") >= lon)
        & (pc.field("bbox_ymin") <= lat)
        & (pc.field("bbox_ymax") >= lat)
    )
    candidates = table.filter(expr).to_pylist()

    if not candidates:
        click.secho(
            f"[botmap] No division bbox even contains {lat},{lon}. "
            f"Check the argument order (LAT,LON — latitude first; "
            f"did you mean {lon},{lat}?) or the point is at sea.",
            fg="yellow", err=True,
        )
        if _json_mode(ctx, json_flag):
            _emit_json(ctx, [])
        return

    try:
        _prefetch_polygons([c["id"] for c in candidates], lon, lat, release)
    except Exception:
        pass
    matches = []
    for c in candidates:
        try:
            hit = _polygon_contains(
                c["id"], lon, lat,
                candidate_bbox=(c["bbox_xmin"], c["bbox_ymin"],
                                c["bbox_xmax"], c["bbox_ymax"]),
                geometry_wkb=c.get("geometry_wkb"),
            )
        except Exception:
            hit = False
        if hit:
            matches.append(c)

    if not matches:
        click.secho(
            f"[botmap] {len(candidates)} division bbox(es) contain {lat},{lon} "
            f"but no polygon test succeeded (point may be just offshore, or "
            f"polygons unavailable). Nearest candidates by bbox: "
            + ", ".join(
                f"{c['name_primary']} ({c['subtype']})" for c in candidates[:5]
            ),
            fg="yellow", err=True,
        )

    matches.sort(key=lambda c: c["admin_level"] or 0, reverse=True)
    payload = [
        {
            "id": c["id"],
            "name": c["name_primary"],
            "subtype": c["subtype"],
            "admin_level": c["admin_level"],
            "country": c["country"],
            "region": c["region"],
        }
        for c in matches
    ]

    if _json_mode(ctx, json_flag):
        _emit_json(ctx, payload)
        return
    for row in payload:
        loc = row["region"] or row["country"] or "?"
        click.secho(f"  {row['name']} ({row['subtype']}, {loc})", fg="cyan")


