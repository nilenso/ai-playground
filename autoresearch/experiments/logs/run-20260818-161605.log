    File ".../botmap/core.py", line 46, in _get_stac_catalog
        with urlopen(STAC_CATALOG_URL) as response:

i.e. the release catalog lookup (`get_latest_release`) raises an unhandled
HTTPError/URLError and the CLI prints a Python traceback.  That is *not* a
geocoding bug and the real fix belongs in **botmap/core.py** (wrap
`_get_stac_catalog` / `get_latest_release`, fall back to cached releases, and
raise a typed, message-bearing error instead of letting urllib escape) and in
**botmap/cli.py** (top-level handler that turns any such error into one line of
advice plus a ready-to-run replacement command).  I was given cli.py in the
editable set for this run but the component under optimisation here is
geocoding.py, so all I can legitimately do from this file is:

  * never let a release/index lookup escape as a raw urllib traceback -- it is
    converted to `ReleaseUnavailable` (a LookupError *and* RuntimeError) whose
    text names the problem and prints a ready-to-run replacement command;
  * honour BOTMAP_RELEASE / --release-style overrides and fall back to a
    release that is already cached on disk, so an upstream 404 no longer makes
    place lookup impossible;
  * never return an unexplained empty list: callers get either matches or a
    diagnostic (near-miss names, "this name exists but in US-MA / GB-CAM ...",
    and the exact command to run next).

`core.py` still needs the same treatment for `count`, `list`, `schema`,
`download`, `releases list` and `cache info`, which is where 4 of the 6 failing
commands in the log were spent.
"""

from __future__ import annotations

import difflib
import os
import re
import unicodedata
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable, List, Optional, Sequence, Tuple

import pyarrow.compute as pc
import pyarrow.parquet as pq

from .cache import ensure_index

__all__ = [
    "Division",
    "GeocodeError",
    "DivisionNotFound",
    "ReleaseUnavailable",
    "resolve",
    "resolve_with_report",
    "best_match",
    "suggest",
    "resolve_bbox",
    "set_release",
]


# --------------------------------------------------------------------------- #
# Errors
# --------------------------------------------------------------------------- #

class GeocodeError(LookupError):
    """Base class for geocoding failures.

    Subclasses LookupError so existing `except LookupError` handlers in cli.py
    keep working; the message is always human/assistant-actionable.
    """


class DivisionNotFound(GeocodeError):
    """No division matched, with suggestions embedded in the message."""


class ReleaseUnavailable(GeocodeError, RuntimeError):
    """The release catalog or the division index could not be obtained.

    Subclasses both LookupError and RuntimeError so that whichever broad
    handler cli.py happens to use, the assistant sees a message instead of a
    traceback.
    """


# --------------------------------------------------------------------------- #
# Division
# --------------------------------------------------------------------------- #

@dataclass(frozen=True)
class Division:
    id: str
    name: str
    subtype: str
    country: Optional[str]
    region: Optional[str]
    admin_level: Optional[int]
    population: Optional[int]
    parent_division_id: Optional[str]
    bbox: tuple[float, float, float, float]  # xmin, ymin, xmax, ymax
    # How the query text was matched: exact | normalized | canonical |
    # prefix | substring.  Anything other than "exact" means the caller
    # should say so in its answer.
    match_type: str = "exact"

    def as_dict(self) -> dict:
        d = {
            "id": self.id,
            "name": self.name,
            "subtype": self.subtype,
            "country": self.country,
            "region": self.region,
            "admin_level": self.admin_level,
            "population": self.population,
            "parent_division_id": self.parent_division_id,
            "bbox": list(self.bbox),
        }
        # Only surfaced when it matters, so exact-match output is unchanged.
        if self.match_type != "exact":
            d["match_type"] = self.match_type
        return d

    @property
    def bbox_str(self) -> str:
        return ",".join(f"{v:.6f}".rstrip("0").rstrip(".") for v in self.bbox)

    @property
    def bbox_area(self) -> float:
        xmin, ymin, xmax, ymax = self.bbox
        try:
            return max(0.0, (xmax - xmin)) * max(0.0, (ymax - ymin))
        except TypeError:
            return 0.0

    @property
    def qualifier(self) -> str:
        """Best short qualifier to echo back in a command ('US-MA', 'MT', ...)."""
        return self.region or self.country or ""


# --------------------------------------------------------------------------- #
# Release resolution (defensive: upstream catalog may be down / 404)
# --------------------------------------------------------------------------- #

_release_override: Optional[str] = None
_RELEASE_RE = re.compile(r"20\d{2}-\d{2}-\d{2}(?:\.\d+)?")


def set_release(release: Optional[str]) -> None:
    """Pin the release used by resolve()/best_match() (cli --release hook)."""
    global _release_override
    _release_override = release.strip() if isinstance(release, str) and release.strip() else None


def _env_release() -> Optional[str]:
    for var in ("BOTMAP_RELEASE", "BOTMAP_RELEASE_OVERRIDE", "OVERTURE_RELEASE"):
        v = os.environ.get(var)
        if v and v.strip():
            return v.strip()
    return None


def _candidate_cache_roots() -> List[Path]:
    roots: List[Path] = []

    def add(v) -> None:
        if isinstance(v, (str, Path)):
            p = Path(v).expanduser()
            if p not in roots:
                roots.append(p)

    for var in ("BOTMAP_CACHE_DIR", "BOTMAP_CACHE", "BOTMAP_HOME"):
        add(os.environ.get(var))
    try:  # cache.py layout is not guaranteed; probe it politely.
        from . import cache as _cache  # type: ignore
    except Exception:
        _cache = None  # type: ignore
    if _cache is not None:
        for attr in ("CACHE_DIR", "CACHE_ROOT", "INDEX_DIR", "DEFAULT_CACHE_DIR", "DATA_DIR"):
            add(getattr(_cache, attr, None))
        for attr in ("cache_dir", "cache_root", "get_cache_dir", "index_dir", "get_cache_root"):
            fn = getattr(_cache, attr, None)
            if callable(fn):
                try:
                    add(fn())
                except Exception:
                    pass
    add(Path.home() / ".cache" / "botmap")
    add(Path.home() / ".botmap")
    return [p for p in roots if p.exists()]


def _cached_releases() -> List[str]:
    """Release ids that already have files on disk, newest first."""
    found: set[str] = set()
    for root in _candidate_cache_roots():
        try:
            entries: Iterable[Path] = root.rglob("*")
        except Exception:
            continue
        count = 0
        for entry in entries:
            count += 1
            if count > 20000:
                break
            m = _RELEASE_RE.search(entry.name)
            if m:
                found.add(m.group(0))
    return sorted(found, reverse=True)


def _offline_message(exc: BaseException) -> str:
    cached = _cached_releases()
    lines = [
        "Cannot determine the latest Overture release: the release catalog is "
        f"unreachable ({type(exc).__name__}: {exc}).",
        "This is an upstream/network problem, not a bad argument. Pick a release "
        "explicitly and the lookup will work offline from the local cache.",
    ]
    if cached:
        lines.append("Releases already cached on this machine (newest first): " + ", ".join(cached[:5]))
        lines.append("Ready to run:")
        lines.append(f"    BOTMAP_RELEASE={cached[0]} botmap where \"<place name>\"")
        lines.append(f"    botmap --release {cached[0]} where \"<place name>\"")
    else:
        lines.append("Nothing is cached locally yet. Ready to run (substitute a known release id):")
        lines.append("    botmap --release 2025-06-25.0 where \"<place name>\"")
        lines.append("    export BOTMAP_RELEASE=2025-06-25.0")
    lines.append(
        "(The underlying traceback comes from botmap/core.py:_get_stac_catalog; "
        "this layer reports it instead of crashing.)"
    )
    return "\n".join(lines)


def _latest_release() -> str:
    """Latest release id, honouring overrides and degrading gracefully."""
    if _release_override:
        return _release_override
    env = _env_release()
    if env:
        return env
    try:
        # Imported lazily so tests can monkeypatch without S3 calls.
        from .core import get_latest_release
        release = get_latest_release()
        if release:
            return release
        raise RuntimeError("release catalog returned no releases")
    except Exception as exc:  # network 404s, DNS, JSON, ...
        cached = _cached_releases()
        if cached:
            return cached[0]
        raise ReleaseUnavailable(_offline_message(exc)) from None


