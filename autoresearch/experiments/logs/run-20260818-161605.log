# ---------------------------------------------------------------------------
# Error containment
# ---------------------------------------------------------------------------

_NETWORK_HINTS = (
    "urlopen", "urlerror", "httperror", "timed out", "timeout", "connection",
    "network", "name resolution", "temporary failure", "unreachable",
    "ssl", "socket", "getaddrinfo", "no route to host", "stac.overturemaps",
    "aws error", "curl", "s3",
)


def _looks_network(exc: BaseException) -> bool:
    if isinstance(exc, OSError):
        return True
    text = f"{type(exc).__name__}: {exc}".lower()
    return any(h in text for h in _NETWORK_HINTS)


def _current_command_line() -> str:
    args = sys.argv[1:]
    return "botmap " + " ".join(shlex.quote(a) for a in args) if args else "botmap"


def _network_message(exc: BaseException, what: str) -> str:
    return (
        f"{what} failed: {type(exc).__name__}: {exc}\n"
        f"This looks like a network problem reaching Overture's metadata "
        f"service (stac.overturemaps.org). The map data itself lives on S3 and "
        f"is often still reachable, so retry the same command with the STAC "
        f"catalog disabled and an explicit release:\n"
        f"  {_current_command_line()} --no-stac\n"
        f"To see the release list without STAC: botmap releases list\n"
        f"(Set BOTMAP_DEBUG=1 for a traceback.)"
    )


def _friendly_failure(exc: BaseException) -> str:
    if _looks_network(exc):
        return _network_message(exc, "Command")
    return (
        f"Unexpected internal error: {type(exc).__name__}: {exc}\n"
        f"This is a bug in botmap, not in your command. Things worth trying:\n"
        f"  * add --no-stac (skips the STAC catalog)\n"
        f"  * narrow the area with --bbox or a smaller --in place\n"
        f"  * run `botmap --json capabilities` to see every command and flag\n"
        f"(Set BOTMAP_DEBUG=1 for a traceback.)"
    )


