_SCHEMA_SAMPLE_BBOXES = [
    [-74.020, 40.700, -73.930, 40.800],   # Manhattan
    [-0.130, 51.495, -0.075, 51.525],     # central London
    [-122.45, 37.74, -122.38, 37.80],     # San Francisco
]


@cli.command()
@click.option("-t", "--type", "type_", type=OvertureTypeParam(), required=True)
@click.option("-r", "--release", default=None, callback=validate_release,
              required=False)
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def schema(ctx, type_, release, json_flag):
    """Show the fields (and one example feature) for an Overture type."""
    reader = None
    sample_row = None
    for sample_bbox in _SCHEMA_SAMPLE_BBOXES:
        try:
            reader = record_batch_reader(type_, sample_bbox, release, None, None, True)
        except Exception:
            reader = None
        if reader is None:
            continue
        try:
            batch = reader.read_next_batch()
            if batch.num_rows > 0:
                sample_row = batch.slice(0, 1).to_pylist()[0]
        except StopIteration:
            pass
        except Exception:
            pass
        if sample_row is not None:
            break

    if reader is None:
        raise click.ClickException(
            f"Could not open the {type_!r} dataset to read its schema. "
            f"Check connectivity, then retry; or run `botmap types` to confirm "
            f"the type name."
        )

    if sample_row is not None and isinstance(sample_row.get("geometry"),
                                             (bytes, bytearray)):
        try:
            import shapely
            import shapely.wkb
            geom = shapely.wkb.loads(sample_row["geometry"])
            sample_row["geometry"] = orjson.loads(shapely.to_geojson(geom))
        except Exception:
            sample_row["geometry"] = sample_row["geometry"].hex()

    fields = flatten_schema(reader.schema)
    payload = {"type": type_, "fields": fields, "example": sample_row}

    if _json_mode(ctx, json_flag):
        _emit_json(ctx, payload)
        return

    click.secho(f"Schema for type {type_!r}", bold=True)
    for f in fields:
        click.echo(f"  {f['name']}: {f['type']}")
    click.echo()
    if sample_row is not None:
        click.secho("Example feature:", bold=True)
        click.echo(
            orjson.dumps(sample_row, default=_json_default,
                         option=orjson.OPT_INDENT_2).decode()
        )
    else:
        click.secho(
            "[botmap] No example feature found in the probe bboxes; field list "
            "above is still authoritative.",
            fg="bright_black", err=True,
        )


@cli.command()
@click.option("-t", "--type", "type_", type=OvertureTypeParam(),
              default="place", show_default=True,
              help="Feature type. For non-place types the classifying field is "
                   "`class`, and this command enumerates that instead.")
@click.option("--bbox", required=False, type=BboxParamType())
@click.option("--in", "in_place", required=False, type=str)
@click.option("--top", default=20, show_default=True, type=int)
@click.option("-r", "--release", default=None, callback=validate_release,
              required=False)
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def categories(ctx, type_, bbox, in_place, top, release, json_flag):
    """List the POI categories present in an area, sorted by count desc."""
    field = "categories.primary"
    if type_ != "place":
        field = "class"
        click.secho(
            f"[botmap] `{type_}` features have no categories; enumerating "
            f"`class` instead (equivalent to "
            f"`botmap values -t {type_} --field class`).",
            fg="bright_black", err=True,
        )
    bbox = _resolve_area(
        in_place, bbox, 'botmap categories --in "Cambridge, MA"'
    )
    counts, truncated = _scan_values(type_, bbox, release, field, max_batches=200)
    if counts is None:
        raise click.UsageError(
            f"Field {field!r} does not exist on `{type_}`. Run "
            f"`botmap --json schema -t {type_}` to see the available fields."
        )
    if not counts:
        _explain_zero(type_, bbox, release, None, None, in_place)
        if _json_mode(ctx, json_flag):
            _emit_json(ctx, [])
        return
    ranked = sorted(counts.items(), key=lambda kv: kv[1], reverse=True)[:top]
    payload = [{"value": v, "count": c} for v, c in ranked]
    if _json_mode(ctx, json_flag):
        _emit_json(ctx, payload)
        return
    for row in payload:
        click.echo(f"  {row['count']:>8,}  {row['value']}")
    if truncated:
        click.secho("[botmap] Note: scan truncated for speed; counts are a "
                    "lower bound.", fg="bright_black", err=True)


@cli.command()
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def capabilities(ctx, json_flag):
    """Emit a machine-readable manifest of all subcommands and their flags."""
    payload = {
        "version": importlib.metadata.version("botmap"),
        "examples": [{"question": q, "command": c} for q, c in CHEATSHEET],
        "commands": _walk_group(cli),
    }
    if _json_mode(ctx, json_flag):
        _emit_json(ctx, payload)
        return
    for c in payload["commands"]:
        click.secho(c["name"], bold=True)
        if c["help"]:
            click.echo(f"  {c['help'].splitlines()[0]}")


