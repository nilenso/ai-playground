# ---------------------------------------------------------------------------
# Row filters applied client-side (name/brand/value-set matching)
# ---------------------------------------------------------------------------

def _mask_true(mask) -> int:
    if mask is None:
        return 0
    try:
        return int(pc.sum(pc.cast(mask, pa.int64())).as_py() or 0)
    except Exception:
        return 0


def _substr_mask(arr, needle):
    if arr is None or needle is None:
        return None
    try:
        m = pc.match_substring(arr, str(needle), ignore_case=True)
        return pc.fill_null(m, False)
    except Exception:
        return None


def _mask_or(a, b):
    if a is None:
        return b
    if b is None:
        return a
    return pc.or_kleene(a, b)


def _mask_and(a, b):
    if a is None:
        return b
    if b is None:
        return a
    return pc.and_kleene(a, b)


class RowFilter:
    """Client-side filter applied to each RecordBatch."""

    def validate(self, schema, type_):
        return None

    def apply(self, batch, stats):
        return batch

    def describe(self) -> str:
        return ""

    def targets(self) -> list:
        """(field, target) pairs used to build 0-result suggestions."""
        return []


class NameFilter(RowFilter):
    """Case-insensitive substring match on names.primary and/or brand.

    `--name Starbucks` deliberately matches EITHER names.primary OR
    brand.names.primary, because Overture records chains inconsistently
    (a store may be named "Starbucks", "Starbucks Coffee", or carry the brand
    only). The per-field breakdown is reported on stderr so the caller can see
    which field actually carried the match.
    """

    def __init__(self, name=None, brand=None):
        self.name = name
        self.brand = brand

    def describe(self):
        bits = []
        if self.name:
            bits.append(
                f"names.primary or brand.names.primary containing "
                f"{str(self.name)!r} (case-insensitive)"
            )
        if self.brand:
            bits.append(f"brand.names.primary containing {str(self.brand)!r}")
        return " and ".join(bits)

    def targets(self):
        out = []
        if self.name:
            out.append(("names.primary", self.name))
        if self.brand:
            out.append(("brand.names.primary", self.brand))
        return out

    def validate(self, schema, type_):
        names = set(schema.names)
        if self.name and not ({"names", "brand"} & names):
            raise click.UsageError(
                f"--name is not supported for type {type_!r}: its rows have no "
                f"`names` field. Inspect the fields with "
                f"`botmap --json schema -t {type_}`, then filter with --where."
            )
        if self.brand and "brand" not in names:
            raise click.UsageError(
                f"--brand is not supported for type {type_!r} (no `brand` "
                f"field). Brands exist on `place` features — try "
                f"`botmap places --brand \"{self.brand}\" ...`."
            )

    def apply(self, batch, stats):
        mask = None
        if self.name:
            nm = _substr_mask(_field_array(batch, "names.primary"), self.name)
            bm = _substr_mask(_field_array(batch, "brand.names.primary"), self.name)
            if nm is not None:
                stats["name_hits"] = stats.get("name_hits", 0) + _mask_true(nm)
            if bm is not None:
                stats["brand_hits"] = stats.get("brand_hits", 0) + _mask_true(bm)
            if nm is not None and bm is not None:
                stats["both_hits"] = stats.get("both_hits", 0) + _mask_true(
                    pc.and_kleene(nm, bm)
                )
            m = _mask_or(nm, bm)
            if m is None:
                return batch.slice(0, 0)
            mask = _mask_and(mask, m)
        if self.brand:
            bm2 = _substr_mask(_field_array(batch, "brand.names.primary"), self.brand)
            if bm2 is None:
                return batch.slice(0, 0)
            mask = _mask_and(mask, bm2)
        if mask is None:
            return batch
        try:
            return batch.filter(mask)
        except Exception:
            return batch


class FieldSetFilter(RowFilter):
    """Membership test on a (possibly nested) string field."""

    def __init__(self, field, values):
        self.field = field
        self.values = [str(v) for v in values]

    def describe(self):
        return f"{self.field} in {{{', '.join(self.values)}}}"

    def targets(self):
        return [(self.field, v) for v in self.values]

    def validate(self, schema, type_):
        if not _schema_has_field(schema, self.field):
            raise click.UsageError(
                f"Field {self.field!r} does not exist on type {type_!r}. "
                f"Run `botmap --json schema -t {type_}` to see the fields."
            )

    def apply(self, batch, stats):
        arr = _field_array(batch, self.field)
        if arr is None:
            return batch.slice(0, 0)
        try:
            mask = pc.fill_null(pc.is_in(arr, value_set=pa.array(self.values)), False)
        except Exception:
            return batch.slice(0, 0)
        try:
            by_value = stats.setdefault("by_value", {})
            kept = arr.filter(mask)
            for item in pc.value_counts(kept).to_pylist():
                v = item["values"]
                if v is None:
                    continue
                by_value[v] = by_value.get(v, 0) + item["counts"]
        except Exception:
            pass
        try:
            return batch.filter(mask)
        except Exception:
            return batch.slice(0, 0)


class CompositeFilter(RowFilter):
    def __init__(self, parts):
        self.parts = [p for p in parts if p is not None]

    def describe(self):
        return " and ".join(p.describe() for p in self.parts if p.describe())

    def targets(self):
        out = []
        for p in self.parts:
            out.extend(p.targets())
        return out

    def validate(self, schema, type_):
        for p in self.parts:
            p.validate(schema, type_)

    def apply(self, batch, stats):
        for p in self.parts:
            batch = p.apply(batch, stats)
            if batch.num_rows == 0:
                return batch
        return batch


def _combine_filters(parts):
    parts = [p for p in parts if p is not None]
    if not parts:
        return None
    if len(parts) == 1:
        return parts[0]
    return CompositeFilter(parts)


# ---------------------------------------------------------------------------
# Place-name resolution
# ---------------------------------------------------------------------------

def _no_match_help(query: str) -> str:
    """Actionable message when a place query resolves to nothing."""
    parts = [p.strip() for p in query.split(",")]
    name = parts[0]
    qualifiers = [p for p in parts[1:] if p]
    base = f"No division found for {query!r}."
    if qualifiers:
        try:
            fallback = resolve(name)
        except Exception:
            fallback = None
        if fallback:
            top = fallback[0]
            return (
                f"{base} The qualifier {', '.join(qualifiers)!r} matched "
                f"nothing, but {name!r} alone resolves to "
                f"{_describe_division(top)}. Ready-to-run: "
                f"`botmap where \"{name}\" --all` to pick, then re-run with "
                f"`--in \"{name}\"`, or use `--bbox`."
            )
    return (
        f"{base} It may be a neighborhood or informal name that is not in "
        f"Overture's divisions index. Recovery options:\n"
        f"  1) try the parent locality: `botmap where \"<city>, <state>\"`\n"
        f"  2) reverse-geocode a point inside it: `botmap containing LAT,LON`\n"
        f"  3) pass coordinates directly: `--bbox xmin,ymin,xmax,ymax`"
    )


def _resolve_in_place(in_place: str):
    """Resolve a --in query to a Division, warning to stderr on ambiguity."""
    try:
        matches = resolve(in_place)
    except Exception as e:
        raise click.UsageError(
            f"Could not search the divisions index for {in_place!r} ({e}). "
            f"Try `botmap cache build`, or pass --bbox instead."
        )
    if not matches:
        parts = [p.strip() for p in in_place.split(",")]
        name, qualifiers = parts[0], [p for p in parts[1:] if p]
        for qualifier in qualifiers:
            try:
                parent_matches = resolve(qualifier)
            except Exception:
                parent_matches = None
            if not parent_matches:
                continue
            parent = parent_matches[0]
            if parent.region:
                try:
                    scoped = resolve(f"{name}, {parent.region}")
                except Exception:
                    scoped = None
                if scoped:
                    result = scoped[0]
                    click.secho(
                        f"[botmap] {in_place!r} not in divisions index; "
                        f"resolved via parent {qualifier!r} → "
                        f"using {_describe_division(result)}",
                        fg="yellow", err=True,
                    )
                    return result
            click.secho(
                f"[botmap] {in_place!r} not in divisions index; "
                f"using parent {qualifier!r} "
                f"({_describe_division(parent)}) bbox instead",
                fg="yellow", err=True,
            )
            return parent
        raise click.UsageError(_no_match_help(in_place))
    picked = matches[0]
    if len(matches) > 1:
        alt = matches[1]
        more = f" (+{len(matches) - 2} more)" if len(matches) > 2 else ""
        click.secho(
            f"[botmap] Ambiguous --in {in_place!r}: picked "
            f"{_describe_division(picked)} over "
            f"{_describe_division(alt)}{more}. "
            f"Run `botmap where \"{in_place}\" --all` to see all.",
            fg="yellow", err=True,
        )
    return picked


def _resolve_area(in_place, bbox, example: str):
    """Turn --in/--bbox into a bbox list, echoing what was used."""
    if bbox is not None and in_place is not None:
        raise click.UsageError(
            "--bbox and --in are mutually exclusive; pass only one."
        )
    if bbox is None and in_place is None:
        raise click.UsageError(
            f"An area is required. Pass --in \"<place name>\" or "
            f"--bbox xmin,ymin,xmax,ymax.\nExample: {example}"
        )
    if in_place is not None:
        division = _resolve_in_place(in_place)
        b = list(division.bbox)
        click.secho(
            f"[botmap] --in {in_place!r} → {_describe_division(division)}; "
            f"bbox {_fmt_bbox(b)}",
            fg="bright_black", err=True,
        )
        return b
    return list(bbox)


# ---------------------------------------------------------------------------
# 0-result explanation
# ---------------------------------------------------------------------------

def _describe_filters(filters, row_filter) -> str:
    bits = []
    for f in (filters or []):
        bits.append(f"{f.key}{f.op}{f.value}")
    if row_filter is not None and row_filter.describe():
        bits.append(row_filter.describe())
    return " and ".join(bits)


def _filter_targets(filters, row_filter):
    out = []
    for f in (filters or []):
        if f.op in ("=", "==", "~", "in"):
            val = f.value
            if isinstance(val, (list, tuple)):
                for v in val:
                    out.append((f.key, v))
            else:
                out.append((f.key, val))
    if row_filter is not None:
        out.extend(row_filter.targets())
    # de-dup, preserve order
    seen = set()
    uniq = []
    for field, target in out:
        key = (field, str(target))
        if key in seen:
            continue
        seen.add(key)
        uniq.append((field, target))
    return uniq[:3]


def _area_flag(in_place, bbox) -> str:
    if in_place:
        return f'--in "{in_place}"'
    return f"--bbox {_fmt_bbox(bbox)}"


def _explain_zero(type_, bbox, release, filters=None, row_filter=None,
                  in_place=None):
    """Never let a zero stand alone. Explain it and hand back a next command."""
    bstr = _fmt_bbox(bbox)
    area = _area_flag(in_place, bbox)
    try:
        total = count_rows(type_, bbox=bbox, release=release, stac=True)
    except Exception:
        total = None

    lines = []
    has_filters = bool(filters) or (row_filter is not None)

    if total == 0:
        lines.append(
            f"0 rows. Overture has NO `{type_}` features at all in bbox {bstr}, "
            f"so changing the filters will not help."
        )
        if in_place:
            lines.append(
                f"Confirm the area resolved as you expected: "
                f"`botmap where \"{in_place}\" --all` (a wrong match is the "
                f"usual cause)."
            )
        lines.append(
            f"Cross-check coverage in this same area with "
            f"`botmap count -t place --bbox {bstr}`."
        )
    elif total is None:
        lines.append(
            f"0 rows matched in bbox {bstr}, and the total `{type_}` count for "
            f"this area could not be verified. Do NOT report this as "
            f"\"there are none\" — retry, or check with "
            f"`botmap count -t {type_} --bbox {bstr}`."
        )
    elif has_filters:
        desc = _describe_filters(filters, row_filter) or "the given filters"
        lines.append(
            f"0 rows matched. {total:,} `{type_}` features DO exist in bbox "
            f"{bstr}, but none satisfy {desc}. This is a filter mismatch, not "
            f"an empty area."
        )
    else:
        lines.append(
            f"0 rows written even though {total:,} `{type_}` features exist in "
            f"bbox {bstr}. Something went wrong — retry with "
            f"`botmap count -t {type_} --bbox {bstr}`."
        )

    if total and has_filters:
        for field, target in _filter_targets(filters, row_filter):
            counts, truncated = _scan_values(type_, bbox, release, field)
            if counts is None:
                lines.append(
                    f"Field {field!r} does not exist on `{type_}` — run "
                    f"`botmap --json schema -t {type_}` for the real field names."
                )
                continue
            if not counts:
                continue
            near = _rank_candidates(target, counts.keys(), n=5)
            if near:
                lines.append(
                    f"Closest {field} values actually present here: "
                    f"{', '.join(near)}."
                )
            else:
                top = sorted(counts.items(), key=lambda kv: kv[1], reverse=True)[:8]
                lines.append(
                    f"{field} values present here (top by count): "
                    f"{', '.join(v for v, _ in top)}."
                )
            lines.append(
                f"Full list: `botmap values -t {type_} --field {field} "
                f"{area} --top 50`"
                + ("  (scan was partial)" if truncated else "")
            )
            if type_ == "place" and any(
                w in str(target).lower() for w in TRANSIT_WORDS
            ):
                lines.append(
                    f"Transit stops live in BOTH `place` and `infrastructure` "
                    f"in Overture — run `botmap transit {area} "
                    f"--class {target}` to check both at once."
                )

    click.secho("[botmap] " + " ".join(lines), fg="yellow", err=True)


# ---------------------------------------------------------------------------
# Feature query execution (shared by every verb)
# ---------------------------------------------------------------------------

def _count_features(type_, bbox, release, filters, row_filter, stats):
    if row_filter is None:
        return _safe_count(
            type_, bbox=bbox, release=release, stac=True,
            where_filters=filters or None,
        )
    reader = _safe_reader(
        type_, bbox, release, None, None, True, where_filters=filters or None,
    )
    if reader is None:
        return 0
    row_filter.validate(reader.schema, type_)
    n = 0
    while True:
        try:
            batch = reader.read_next_batch()
        except StopIteration:
            break
        if batch.num_rows == 0:
            continue
        kept = row_filter.apply(batch, stats)
        n += kept.num_rows
    stats["rows"] = n
    return n


def _stream_features(reader, row_filter, limit, stats, output_format, output):
    schema = reader.schema

    def _gen():
        remaining = limit
        while True:
            if remaining is not None and remaining <= 0:
                return
            try:
                batch = reader.read_next_batch()
            except StopIteration:
                return
            if batch.num_rows == 0:
                continue
            if row_filter is not None:
                batch = row_filter.apply(batch, stats)
                if batch.num_rows == 0:
                    continue
            if remaining is not None and batch.num_rows > remaining:
                batch = batch.slice(0, remaining)
            if remaining is not None:
                remaining -= batch.num_rows
            stats["rows"] = stats.get("rows", 0) + batch.num_rows
            yield batch

    limited = pa.RecordBatchReader.from_batches(schema, _gen())
    out_file = sys.stdout if output is None else output
    with get_writer(output_format, out_file, schema=schema) as writer:
        copy(limited, writer)


def _report_name_breakdown(stats):
    nh = stats.get("name_hits")
    bh = stats.get("brand_hits")
    if nh is None and bh is None:
        return
    both = stats.get("both_hits", 0)
    click.secho(
        f"[botmap] name/brand breakdown: names.primary matched {nh or 0:,}, "
        f"brand.names.primary matched {bh or 0:,}, both {both:,} "
        f"(a row matching either is kept once).",
        fg="bright_black", err=True,
    )


def _run_features(ctx, type_, in_place, bbox, filters, row_filter, limit,
                  output_format, output, release, count_only=False,
                  json_flag=False, example=""):
    """Shared body for places/buildings/roads/water/landuse/addresses."""
    bbox = _resolve_area(in_place, bbox, example or "botmap count --in \"Boston, MA\"")
    stats: dict = {"rows": 0}

    if count_only:
        n = _count_features(type_, bbox, release, filters, row_filter, stats)
        _report_name_breakdown(stats)
        if n == 0:
            _explain_zero(type_, bbox, release, filters, row_filter, in_place)
        if _json_mode(ctx, json_flag):
            _emit_json(ctx, {
                "type": type_,
                "area": in_place,
                "bbox": bbox,
                "filters": _describe_filters(filters, row_filter),
                "count": n,
                "name_hits": stats.get("name_hits"),
                "brand_hits": stats.get("brand_hits"),
            })
        else:
            click.echo(f"{n:,}")
        return n

    if output_format == "geoparquet" and output is None:
        raise click.UsageError(
            "Output file (-o/--output) is required for geoparquet. "
            "Either add `-o out.parquet` or use `-f geojson`."
        )

    reader = _safe_reader(
        type_, bbox, release, None, None, True, where_filters=filters or None,
    )
    if reader is None:
        _explain_zero(type_, bbox, release, filters, row_filter, in_place)
        return 0
    if row_filter is not None:
        row_filter.validate(reader.schema, type_)

    _stream_features(reader, row_filter, limit, stats, output_format, output)
    _report_name_breakdown(stats)
    n = stats.get("rows", 0)
    if n == 0:
        _explain_zero(type_, bbox, release, filters, row_filter, in_place)
    else:
        where = f" -> {output}" if output else ""
        click.secho(
            f"[botmap] {n:,} `{type_}` feature(s) written{where}.",
            fg="bright_black", err=True,
        )
    return n


def _parse_where(where_exprs):
    try:
        return [parse_where_expr(e) for e in (where_exprs or [])]
    except ValueError as e:
        raise click.UsageError(
            f"{e}\nWhere syntax is KEY OP VALUE with no spaces, e.g. "
            f"--where height>50 or --where class=motorway. "
            f"For names use --name, for POI kinds use --category."
        )


def _limit_reader(reader, n):
    """Yield a new RecordBatchReader emitting at most `n` rows."""
    def _batches():
        remaining = n
        while remaining > 0:
            try:
                batch = reader.read_next_batch()
            except StopIteration:
                return
            if batch.num_rows == 0:
                continue
            if batch.num_rows > remaining:
                batch = batch.slice(0, remaining)
            remaining -= batch.num_rows
            yield batch

    return pa.RecordBatchReader.from_batches(reader.schema, _batches())


# ---------------------------------------------------------------------------
# Introspection helpers for `capabilities`
# ---------------------------------------------------------------------------

def _describe_param(param: click.Parameter) -> dict:
    out: dict = {
        "name": param.name,
        "required": getattr(param, "required", False),
    }
    if isinstance(param, click.Option):
        out["flags"] = list(param.opts)
        out["help"] = param.help or ""
        out["multiple"] = param.multiple
        out["is_flag"] = param.is_flag
    if param.default is not None and param.default is not False:
        try:
            if isinstance(param.default, (str, int, float, bool, list, tuple, type(None))):
                out["default"] = param.default
        except Exception:
            pass
    if isinstance(param.type, click.Choice):
        out["choices"] = list(param.type.choices)
    return out


def _describe_command(name: str, command: click.Command) -> dict:
    return {
        "name": name,
        "help": command.help or command.short_help or "",
        "params": [_describe_param(p) for p in command.params],
    }


def _walk_group(group: click.Group, prefix: str = "") -> list[dict]:
    out: list[dict] = []
    for name, cmd in group.commands.items():
        full = f"{prefix}{name}" if not prefix else f"{prefix} {name}"
        if isinstance(cmd, click.Group):
            out.extend(_walk_group(cmd, prefix=full))
        else:
            out.append(_describe_command(full, cmd))
    return out


# Earth's total surface area in square degrees (360 * 180).
EARTH_AREA_SQ_DEG = 64800
LARGE_BBOX_THRESHOLD = 0.01  # 1% of Earth

TYPE_TO_VERB = {
    "place": "places",
    "segment": "roads",
    "building": "buildings",
    "address": "addresses",
    "water": "water",
    "land_use": "landuse",
    "division_area": "boundary",
}


def _suggest_verb_command(
    verb: str, in_place, bbox, where_exprs, output_format, output
) -> str:
    """Build a concrete ready-to-run verb command from download flags."""
    parts = [f"botmap {verb}"]
    if in_place:
        parts.append(f'--in "{in_place}"')
    elif bbox is not None:
        parts.append(f"--bbox {bbox[0]},{bbox[1]},{bbox[2]},{bbox[3]}")
    leftover = []
    for expr in (where_exprs or []):
        if expr.startswith("categories.primary="):
            parts.append(f"--category {expr.split('=', 1)[1]}")
        elif expr.startswith("class="):
            parts.append(f"--class {expr.split('=', 1)[1]}")
        else:
            leftover.append(expr)
    for expr in leftover:
        parts.append(f'--where "{expr}"')
    if output_format:
        parts.append(f"-f {output_format}")
    if output:
        parts.append(f"-o {output}")
    return " ".join(parts)


def _print_banner():
    try:
        import pyfiglet
        banner = pyfiglet.figlet_format("Overture Maps", font="slant")
    except Exception:
        banner = "Overture Maps\n"
    try:
        version = importlib.metadata.version("botmap")
    except Exception:
        version = "?"
    click.secho(banner.rstrip(), fg="blue", bold=True, err=True)
    click.secho(f"  v{version}  |  overturemaps.org\n", fg="bright_blue", err=True)


def _bbox_area_sq_deg(xmin: float, ymin: float, xmax: float, ymax: float) -> float:
    return abs(xmax - xmin) * abs(ymax - ymin)


# ---------------------------------------------------------------------------
# Param types
# ---------------------------------------------------------------------------

class BboxParamType(click.ParamType):
    name = "bbox"

    def convert(self, value, param, ctx):
        if isinstance(value, (list, tuple)):
            parts = [str(v) for v in value]
        else:
            parts = str(value).replace(" ", ",").split(",")
        parts = [p for p in parts if p.strip() != ""]
        if len(parts) != 4:
            self.fail(
                f"bbox requires exactly 4 values (xmin,ymin,xmax,ymax), "
                f"got {len(parts)}. Example: --bbox -71.10,42.34,-71.05,42.36. "
                f"If you only know a place name, use --in \"<place>\" instead."
            )
        try:
            bbox = [float(x.strip()) for x in parts]
        except ValueError:
            self.fail(
                f"All bbox values must be numbers. Got '{value}'. "
                f"Example: --bbox -71.10,42.34,-71.05,42.36"
            )

        xmin, ymin, xmax, ymax = bbox

        if not (-180 <= xmin <= 180 and -180 <= xmax <= 180):
            self.fail(
                f"Longitude values must be between -180 and 180. "
                f"Got xmin={xmin}, xmax={xmax}. bbox order is "
                f"xmin(lon),ymin(lat),xmax(lon),ymax(lat)."
            )
        if not (-90 <= ymin <= 90 and -90 <= ymax <= 90):
            self.fail(
                f"Latitude values must be between -90 and 90. "
                f"Got ymin={ymin}, ymax={ymax}. bbox order is "
                f"xmin(lon),ymin(lat),xmax(lon),ymax(lat) — longitude first."
            )
        if xmin > xmax:
            self.fail(
                f"xmin ({xmin}) must be <= xmax ({xmax}). "
                f"Try --bbox {xmax},{ymin},{xmin},{ymax}"
            )
        if ymin > ymax:
            self.fail(
                f"ymin ({ymin}) must be <= ymax ({ymax}). "
                f"Try --bbox {xmin},{ymax},{xmax},{ymin}"
            )
        return bbox


class OvertureTypeParam(click.ParamType):
    """Accept official type names plus the obvious spellings (plural etc.)."""

    name = "type"

    def convert(self, value, param, ctx):
        if value is None:
            return None
        if not isinstance(value, str):
            return value
        v = value.strip().lower().replace("-", "_")
        try:
            valid = list(get_all_overture_types())
        except Exception:
            return v
        if v in valid:
            return v
        alias = TYPE_ALIASES.get(v)
        if alias in valid:
            return alias
        import difflib
        close = difflib.get_close_matches(v, valid, n=3, cutoff=0.5)
        hint = f" Did you mean: {', '.join(close)}?" if close else ""
        self.fail(
            f"Unknown feature type {value!r}.{hint} Valid types: "
            f"{', '.join(sorted(valid))}. Run `botmap types` for descriptions. "
            f"If {value!r} is a kind of POI (hospital, cafe, school), it is a "
            f"category, not a type: `botmap count --category {v} --in \"<place>\"`.",
            param, ctx,
        )


def validate_release(ctx, param, value):
    """Validate release; tolerate network failure instead of crashing."""
    if value is None:
        try:
            return get_latest_release()
        except Exception:
            return None
    try:
        available_releases, _ = get_available_releases()
    except Exception:
        return value
    if value not in available_releases:
        raise click.UsageError(
            f"Release '{value}' is no longer available. Overture keeps only the "
            f"last two monthly releases (~60 days).\n\n"
            f"Available releases: {', '.join(available_releases)}\n"
            f"Ready-to-run: drop -r/--release entirely to use the latest "
            f"({available_releases[0] if available_releases else 'latest'})."
        )
    return value


def validate_gers_id(ctx, param, value):
    if not value:
        raise click.BadParameter("GERS ID cannot be empty")
    try:
        parsed_uuid = uuid.UUID(value)
        return str(parsed_uuid)
    except ValueError:
        raise click.BadParameter(f"GERS ID must be a valid UUID. Got: '{value}'")


# ---------------------------------------------------------------------------
# Group with alias resolution and traceback suppression
# ---------------------------------------------------------------------------

class BotmapGroup(click.Group):
    def get_command(self, ctx, name):
        cmd = super().get_command(ctx, name)
        if cmd is not None:
            return cmd
        key = str(name).strip().lower().replace("_", "-")
        target = COMMAND_ALIASES.get(key)
        if target:
            return super().get_command(ctx, target)
        return None

    def resolve_command(self, ctx, args):
        try:
            return super().resolve_command(ctx, args)
        except click.UsageError:
            name = args[0] if args else ""
            import difflib
            pool = sorted(set(list(self.commands) + list(COMMAND_ALIASES)))
            close = difflib.get_close_matches(
                str(name).lower(), pool, n=3, cutoff=0.4
            )
            bits = [f"No such command {name!r}."]
            if close:
                bits.append(f"Closest commands: {', '.join(close)}.")
            bits.append(
                f"If {name!r} is a kind of place (hospital, cafe, bus_stop), it "
                f"is a category: `botmap count --in \"<place>\" "
                f"--category {name}`."
            )
            bits.append("Run `botmap examples` for question -> command mappings.")
            raise click.UsageError(" ".join(bits))

    def invoke(self, ctx):
        try:
            return super().invoke(ctx)
        except (click.ClickException, click.exceptions.Exit, click.Abort, SystemExit):
            raise
        except Exception as e:  # never show a raw traceback to an agent
            raise click.ClickException(
                f"Unexpected {type(e).__name__}: {e}\n"
                f"This is a tool-level failure, not an answer of 'zero'. "
                f"Retry, or run `botmap examples` for a known-good command shape."
            )


@click.group(cls=BotmapGroup, invoke_without_command=True, help=GROUP_HELP)
@click.version_option(
    version=importlib.metadata.version("botmap"),
    prog_name="botmap",
)
@click.option("--json", "json_output", is_flag=True, default=False,
              help="Emit machine-readable JSON where the command supports it.")
@click.pass_context
def cli(ctx, json_output):
    ctx.ensure_object(dict)
    ctx.obj["json"] = json_output
    if ctx.invoked_subcommand is None:
        _print_banner()
        click.echo(ctx.get_help())


# ---------------------------------------------------------------------------
# examples / cheatsheet
# ---------------------------------------------------------------------------

@cli.command()
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def examples(ctx, json_flag):
    """Show plain-English questions mapped to ready-to-run botmap commands."""
    if _json_mode(ctx, json_flag):
        _emit_json(ctx, [{"question": q, "command": c} for q, c in CHEATSHEET])
        return
    click.echo(_cheatsheet_text())


# ---------------------------------------------------------------------------
# count — the workhorse for "how many ...?" questions
# ---------------------------------------------------------------------------

@cli.command()
@click.option("-t", "--type", "type_", type=OvertureTypeParam(),
              default="place", show_default=True,
              help="Feature type (place, building, segment, address, water, "
                   "land_use, infrastructure, ...). Plurals accepted.")
@click.option("--in", "in_place", required=False, type=str,
              help="Place name, resolved via the divisions index.")
@click.option("--bbox", required=False, type=BboxParamType(),
              help="xmin,ymin,xmax,ymax. Mutually exclusive with --in.")
@click.option("--category", "categories_", multiple=True,
              help="POI category, e.g. hospital, coffee_shop (repeatable). "
                   "Shortcut for --where categories.primary=VAL.")
@click.option("--class", "class_", required=False, type=str,
              help="Shortcut for --where class=VAL (roads/water/land_use/...).")
@click.option("--name", required=False, type=str,
              help="Case-insensitive substring on names.primary OR "
                   "brand.names.primary (good for chains: --name Starbucks).")
@click.option("--brand", required=False, type=str,
              help="Case-insensitive substring on brand.names.primary only.")
@click.option("--street", required=False, type=str,
              help="Street name substring (addresses/segments).")
@click.option("--postcode", required=False, type=str)
@click.option("--where", "where_exprs", multiple=True,
              help="Raw attribute filter K OP V (repeatable), e.g. height>50.")
@click.option("-r", "--release", default=None, callback=validate_release,
              required=False)
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def count(ctx, type_, in_place, bbox, categories_, class_, name, brand, street,
          postcode, where_exprs, release, json_flag):
    """How many features match? Prints a single number on stdout.

    \b
    botmap count --in "Rhode Island" --category hospital
    botmap count --in "Seattle, WA" --name Starbucks
    botmap count -t building --in "Provincetown, MA"
    botmap count -t segment --in "Rhode Island" --class motorway

    A zero is always explained on stderr (empty area vs. wrong filter value),
    so a 0 here is never a silent "there are none".
    """
    filters = _parse_where(where_exprs)
    row_filter_parts = []

    cats = [c for c in (categories_ or []) if c]
    if len(cats) == 1:
        filters.append(ParsedFilter(key="categories.primary", op="=", value=cats[0]))
    elif len(cats) > 1:
        row_filter_parts.append(FieldSetFilter("categories.primary", cats))
    if class_:
        filters.append(ParsedFilter(key="class", op="=", value=class_))
    if street:
        filters.append(ParsedFilter(key="street", op="~", value=street))
    if postcode:
        filters.append(ParsedFilter(key="postcode", op="=", value=str(postcode)))
    if name or brand:
        row_filter_parts.append(NameFilter(name=name, brand=brand))

    _run_features(
        ctx, type_, in_place, bbox, filters,
        _combine_filters(row_filter_parts), None, None, None, release,
        count_only=True, json_flag=json_flag,
        example='botmap count --in "Rhode Island" --category hospital',
    )


# ---------------------------------------------------------------------------
# values — enumerate the real values of any field in an area
# ---------------------------------------------------------------------------

@cli.command()
@click.option("-t", "--type", "type_", type=OvertureTypeParam(),
              default="place", show_default=True)
@click.option("--field", "-F", "field", default=None,
              help="Field to enumerate. Default: categories.primary for place, "
                   "class for everything else. Nested paths allowed "
                   "(e.g. brand.names.primary).")
@click.option("--in", "in_place", required=False, type=str)
@click.option("--bbox", required=False, type=BboxParamType())
@click.option("--top", default=25, show_default=True, type=int)
@click.option("-r", "--release", default=None, callback=validate_release,
              required=False)
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def values(ctx, type_, field, in_place, bbox, top, release, json_flag):
    """List the distinct values of a field in an area, with counts.

    Use this before guessing a filter value:

    \b
    botmap values --in "Cambridge, MA" --field categories.primary --top 40
    botmap values -t segment --in "Rhode Island" --field class
    """
    bbox = _resolve_area(
        in_place, bbox,
        'botmap values --in "Cambridge, MA" --field categories.primary',
    )
    if field is None:
        field = "categories.primary" if type_ == "place" else "class"

    counts, truncated = _scan_values(type_, bbox, release, field, max_batches=200)
    if counts is None:
        try:
            reader = record_batch_reader(type_, bbox, release, None, None, True)
            available = list(reader.schema.names) if reader is not None else []
        except Exception:
            available = []
        raise click.UsageError(
            f"Field {field!r} does not exist on type {type_!r}."
            + (f" Available top-level fields: {', '.join(available)}."
               if available else "")
            + f" Run `botmap --json schema -t {type_}` for the full schema."
        )
    if not counts:
        _explain_zero(type_, bbox, release, None, None, in_place)
        if _json_mode(ctx, json_flag):
            _emit_json(ctx, [])
        return

    ranked = sorted(counts.items(), key=lambda kv: kv[1], reverse=True)[:top]
    payload = [{"value": v, "count": c} for v, c in ranked]
    if _json_mode(ctx, json_flag):
        _emit_json(ctx, {
            "type": type_, "field": field, "bbox": bbox,
            "partial_scan": truncated, "values": payload,
        })
        return
    for row in payload:
        click.echo(f"  {row['count']:>8,}  {row['value']}")
    if truncated:
        click.secho(
            "[botmap] Note: scan was truncated for speed; counts are a lower "
            "bound and rare values may be missing.",
            fg="bright_black", err=True,
        )


# ---------------------------------------------------------------------------
# transit — bus stops & stations live in TWO Overture types
# ---------------------------------------------------------------------------

@cli.command()
@click.option("--in", "in_place", required=False, type=str)
@click.option("--bbox", required=False, type=BboxParamType())
@click.option("--class", "transit_class", required=False, type=str,
              help="bus_stop, bus_station, train_station, subway_station, "
                   "tram_stop, platform, ferry_terminal, ... "
                   "Omit to count all transit stop kinds.")
@click.option("--source", type=click.Choice(["auto", "place", "infrastructure",
                                             "both"]),
              default="auto", show_default=True,
              help="Which Overture type to read features from when exporting.")
@click.option("-n", "--limit", "limit", default=None, type=int)
@click.option("-f", "output_format",
              type=click.Choice(["geojson", "geojsonseq", "geoparquet"]),
              default=None,
              help="Provide to export features instead of just counting.")
@click.option("-o", "--output", required=False, type=click.Path())
@click.option("-r", "--release", default=None, callback=validate_release,
              required=False)
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def transit(ctx, in_place, bbox, transit_class, source, limit, output_format,
            output, release, json_flag):
    """Count/export transit stops (bus stops, stations, platforms).

    Overture stores transit stops in TWO different types depending on the
    source data: `place` features (categories.primary=bus_stop) and
    `infrastructure` features (subtype=transit, class=bus_stop). This command
    checks both and reports each, so you never get a misleading zero.

    \b
    botmap transit --in "Cambridge, MA" --class bus_stop
    botmap transit --in "Cambridge, MA"            # all stop kinds
    """
    bbox = _resolve_area(
        in_place, bbox, 'botmap transit --in "Cambridge, MA" --class bus_stop'
    )

    place_values = [transit_class] if transit_class else TRANSIT_PLACE_CATEGORIES
    place_filter = FieldSetFilter("categories.primary", place_values)
    place_stats: dict = {"rows": 0}
    place_n = 0
    try:
        place_n = _count_features("place", bbox, release, None, place_filter,
                                  place_stats)
    except click.ClickException:
        place_n = 0

    infra_filters = None
    if transit_class:
        infra_filters = [ParsedFilter(key="class", op="=", value=transit_class)]
    else:
        infra_filters = [ParsedFilter(key="subtype", op="=", value="transit")]
    infra_n = 0
    try:
        infra_n = _safe_count(
            "infrastructure", bbox=bbox, release=release, stac=True,
            where_filters=infra_filters,
        )
    except click.ClickException:
        infra_n = 0

    label = transit_class or "any transit stop kind"
    payload = {
        "area": in_place,
        "bbox": bbox,
        "class": transit_class,
        "place_count": place_n,
        "place_breakdown": place_stats.get("by_value", {}),
        "infrastructure_count": infra_n,
        "total_both_sources": place_n + infra_n,
    }

    if place_n == 0 and infra_n == 0:
        cat_counts, _ = _scan_values("place", bbox, release, "categories.primary")
        cls_counts, _ = _scan_values("infrastructure", bbox, release, "class")
        near = []
        for counts in (cat_counts or {}, cls_counts or {}):
            for v in counts:
                if any(w in str(v).lower() for w in TRANSIT_WORDS):
                    near.append(str(v))
        near = sorted(set(near))[:8]
        msg = (
            f"0 transit stops found for {label} in bbox {_fmt_bbox(bbox)} in "
            f"either `place` or `infrastructure`. "
        )
        if near:
            msg += (
                f"Transit-ish values that DO exist here: {', '.join(near)}. "
                f"Retry with `botmap transit {_area_flag(in_place, bbox)} "
                f"--class {near[0]}`."
            )
        else:
            msg += (
                f"No transit-like values exist here at all — verify the area "
                f"with `botmap where \"{in_place}\"` and check overall "
                f"coverage with `botmap count -t place --bbox "
                f"{_fmt_bbox(bbox)}`."
            )
        click.secho("[botmap] " + msg, fg="yellow", err=True)

    if output_format is None:
        if _json_mode(ctx, json_flag):
            _emit_json(ctx, payload)
        else:
            click.echo(f"place ({label}):           {place_n:,}")
            click.echo(f"infrastructure ({label}):  {infra_n:,}")
            click.echo(f"total (both sources):      {place_n + infra_n:,}")
            for v, c in sorted(place_stats.get("by_value", {}).items(),
                               key=lambda kv: kv[1], reverse=True):
                click.secho(f"    place categories.primary={v}: {c:,}",
                            fg="bright_black", err=True)
        return

    chosen = source
    if chosen == "auto":
        chosen = "place" if place_n >= infra_n else "infrastructure"
        click.secho(
            f"[botmap] exporting from `{chosen}` (place={place_n:,}, "
            f"infrastructure={infra_n:,}); override with --source.",
            fg="bright_black", err=True,
        )

    if chosen in ("place", "both"):
        _run_features(
            ctx, "place", None, bbox, None, place_filter, limit, output_format,
            output, release, count_only=False, json_flag=json_flag,
        )
    if chosen in ("infrastructure", "both") and not (chosen == "both" and output):
        _run_features(
            ctx, "infrastructure", None, bbox, infra_filters, None, limit,
            output_format, output if chosen != "both" else None, release,
            count_only=False, json_flag=json_flag,
        )


# ---------------------------------------------------------------------------
# download (bulk escape hatch)
# ---------------------------------------------------------------------------

@cli.command()
@click.option("--bbox", required=False, type=BboxParamType())
@click.option("--in", "in_place", required=False, type=str,
              help="Resolve a place name to a bbox via the divisions index.")
@click.option("--where", "where_exprs", multiple=True,
              help="Attribute filter K OP V (repeatable). Example: --where height>50")
@click.option(
    "-f",
    "output_format",
    type=click.Choice(["geojson", "geojsonseq", "geoparquet"]),
    required=True,
)
@click.option("-o", "--output", required=False, type=click.Path())
@click.option("-t", "--type", "type_", type=OvertureTypeParam(), required=True)
@click.option("-r", "--release", default=None, callback=validate_release,
              required=False, help="Release version (defaults to latest)")
@click.option(
    "--stac/--no-stac",
    required=False,
    type=bool,
    is_flag=True,
    default=True,
    help="By default, uses the STAC catalog to limit which Parquet files are "
         "downloaded. Pass --no-stac to read the full S3 dataset directly.",
)
@click.option("--connect_timeout", required=False, type=int)
@click.option("--request_timeout", required=False, type=int)
def download(
    bbox, in_place, where_exprs, output_format, output, type_, release,
    connect_timeout, request_timeout, stac,
):
    """Bulk export of one feature type. Prefer the verbs (see `botmap examples`)."""
    if bbox is not None and in_place is not None:
        raise click.UsageError("--bbox and --in are mutually exclusive")

    verb = TYPE_TO_VERB.get(type_)
    if verb is not None:
        suggestion = _suggest_verb_command(
            verb, in_place, bbox, where_exprs, output_format, output
        )
        if type_ == "division_area":
            raise click.UsageError(
                f"division_area is not downloadable this way — for a boundary "
                f"polygon (e.g. to clip layers in QGIS) run: {suggestion}"
            )
        click.secho(
            f"[botmap] Tip: try instead: {suggestion}",
            fg="bright_black", err=True,
        )
    elif type_ == "infrastructure":
        loc_flag = (
            f'--in "{in_place}"' if in_place
            else (f"--bbox {_fmt_bbox(bbox)}" if bbox else "--in <place>")
        )
        click.secho(
            f"[botmap] Tip: transit stops appear as BOTH `place` "
            f"(categories.primary=bus_stop) and `infrastructure` "
            f"(subtype=transit) features. To cover both run: "
            f"botmap transit {loc_flag} --class bus_stop",
            fg="bright_black", err=True,
        )

    if in_place is not None:
        division = _resolve_in_place(in_place)
        bbox = list(division.bbox)
        click.secho(
            f"Resolved {in_place!r} -> {_describe_division(division)}; "
            f"bbox {_fmt_bbox(bbox)}",
            fg="bright_black", err=True,
        )

    where_filters = _parse_where(where_exprs) or None

    if bbox is None:
        click.secho(
            "Warning: No bounding box provided. Downloading the entire dataset "
            "for this type. The full Overture dataset is approximately "
            "1.2 TB as GeoJSON and 400 GB as GeoParquet. Add --in \"<place>\" "
            "or --bbox to bound it.",
            fg="yellow", bold=True, err=True,
        )
    else:
        area = _bbox_area_sq_deg(bbox[0], bbox[1], bbox[2], bbox[3])
        fraction = area / EARTH_AREA_SQ_DEG
        if fraction >= LARGE_BBOX_THRESHOLD:
            click.secho(
                f"Warning: The bounding box covers ~{fraction * 100:.1f}% of "
                f"Earth's surface. This may take a long time. Consider "
                f"`botmap count` first to size the result.",
                fg="yellow", bold=True, err=True,
            )

    if output_format == "geoparquet" and output is None:
        raise click.UsageError(
            "Output file (-o/--output) is required when using geoparquet format"
        )

    output_file = sys.stdout if output is None else output

    reader = _safe_reader(
        type_, bbox, release, connect_timeout, request_timeout, stac,
        where_filters=where_filters,
    )

    if reader is None:
        if bbox is not None:
            _explain_zero(type_, bbox, release, where_filters, None, in_place)
        return

    stats = {"rows": 0}
    _stream_features(reader, None, None, stats, output_format, output_file)
    if stats["rows"] == 0 and bbox is not None:
        _explain_zero(type_, bbox, release, where_filters, None, in_place)
    else:
        click.secho(f"[botmap] {stats['rows']:,} feature(s) written.",
                    fg="bright_black", err=True)

    if output is not None:
        output_path = os.path.abspath(os.path.expanduser(output))
        backend = Backend(output_format)
        theme = type_theme_map.get(type_)
        if theme is None:
            click.secho(
                f"Warning: Could not determine theme for type {type_}",
                fg="yellow", bold=True, err=True,
            )
            return

        state = PipelineState(
            last_release=release,
            last_run=datetime.now(timezone.utc).isoformat(),
            theme=theme,
            type=type_,
            bbox=(
                BBox(xmin=bbox[0], ymin=bbox[1], xmax=bbox[2], ymax=bbox[3])
                if bbox is not None
                else None
            ),
            backend=backend,
            output=output_path,
        )
        state_path = get_state_path(output)
        save_state(state, state_path)
        click.secho(f"State saved to {state_path}", fg="bright_black", err=True)


# ---------------------------------------------------------------------------
# gers
# ---------------------------------------------------------------------------

@cli.command()
@click.argument("gers_id", required=True, callback=validate_gers_id)
@click.option("-f", "output_format",
              type=click.Choice(["geojson", "geojsonseq", "geoparquet"]),
              default=None, required=False,
              help="Output format. If omitted, only registry info is shown.")
@click.option("-o", "--output", required=False, type=click.Path())
@click.option("--connect_timeout", required=False, type=int)
@click.option("--request_timeout", required=False, type=int)
@click.pass_context
def gers(ctx, gers_id, output_format, output, connect_timeout, request_timeout):
    """Query the GERS registry for a feature by its GERS ID."""
    from .core import query_gers_registry

    result = query_gers_registry(gers_id)
    if result is None:
        click.secho(
            f"No registry entry for GERS ID {gers_id!r}. GERS IDs change "
            f"between releases; confirm the id with the feature's source data.",
            fg="yellow", err=True,
        )
        ctx.exit(1)

    if output_format is None:
        click.secho(
            f"\nRegistry lookup complete for GERS ID: {gers_id}",
            fg="bright_black", err=True,
        )
        click.secho("To download the feature data, use -f/--format option.",
                    fg="bright_black", err=True)
        return

    if output_format == "geoparquet" and output is None:
        raise click.UsageError(
            "Output file (-o/--output) is required when using geoparquet format"
        )
    if output is None:
        output = sys.stdout

    reader = record_batch_reader_from_gers(
        gers_id, connect_timeout, request_timeout, registry_result=result
    )
    if reader is None:
        click.secho(
            f"Could not fetch feature data for GERS ID '{gers_id}'",
            fg="red", err=True,
        )
        ctx.exit(1)

    with get_writer(output_format, output, schema=reader.schema) as writer:
        copy(reader, writer)


# ---------------------------------------------------------------------------
# where / boundary
# ---------------------------------------------------------------------------

@cli.command()
@click.argument("query", type=str)
@click.option("--all", "show_all", is_flag=True, default=False,
              help="Show all matching divisions, not just the best one.")
@click.option("--geometry", "--geojson", "geometry", is_flag=True, default=False,
              help="Emit the division's polygon as a GeoJSON Feature on stdout.")
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def where(ctx, query, show_all, geometry, json_flag):
    """Resolve a place name to an Overture division (name, subtype, bbox, id)."""
    json_mode = _json_mode(ctx, json_flag)
    try:
        matches = resolve(query)
    except Exception:
        matches = []
    if not matches:
        try:
            pick = _resolve_in_place(query)
            matches = [pick]
        except click.UsageError as e:
            msg = str(e)
            if json_mode:
                _emit_error_json(msg, code="no_match")
            else:
                click.secho(msg, fg="red", err=True)
            ctx.exit(1)
            return
    pick = matches[0]

    if geometry:
        _emit_division_geometry(ctx, pick)
        return

    if json_mode:
        payload = pick.as_dict()
        payload["candidates"] = [d.as_dict() for d in matches]
        _emit_json(ctx, payload)
        return

    def _print_one(d, prefix=""):
        qual = d.region or d.country or "?"
        click.secho(f"{prefix}{d.name}, {qual}", bold=True)
        click.echo(f"  subtype: {d.subtype}")
        click.echo(f"  bbox: {d.bbox[0]:.4f}, {d.bbox[1]:.4f}, "
                   f"{d.bbox[2]:.4f}, {d.bbox[3]:.4f}")
        if d.population is not None:
            click.echo(f"  population: {d.population:,}")
        click.echo(f"  id: {d.id}")

    if show_all:
        for i, d in enumerate(matches, start=1):
            _print_one(d, prefix=f"[{i}] ")
    else:
        _print_one(pick)
        if len(matches) > 1:
            click.secho(
                f"\n  ({len(matches) - 1} other match"
                f"{'es' if len(matches) - 1 != 1 else ''}; "
                f"rerun with --all to see them.)",
                fg="yellow",
            )


@cli.command()
@click.argument("query", type=str)
@click.option("-o", "--output", required=False, type=click.Path(),
              help="Write the GeoJSON Feature to this file instead of stdout "
                   "(handy for QGIS/ogr2ogr clipping).")
@click.option("--json", "json_flag", is_flag=True, default=False, hidden=True)
@click.pass_context
def boundary(ctx, query, output, json_flag):
    """Emit a division's polygon as GeoJSON (for clipping / spatial joins).

    QUERY is a place name, e.g. 'Alameda County, CA' or 'Brooklyn, NY'.

    \b
    botmap boundary "Alameda County, CA" -o alameda.geojson
    botmap boundary "Rhode Island" > ri.geojson

    This is the correct replacement for `download -t division_area`.
    """
    division = _resolve_in_place(query)
    _emit_division_geometry(ctx, division, output=output)


