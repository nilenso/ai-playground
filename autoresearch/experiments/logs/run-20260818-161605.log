# leaf value -> group name, used to warn about umbrella / undercount asks
_LEAF_TO_GROUP: dict[str, str] = {}
for _g, _members in CATEGORY_GROUPS.items():
    for _m in _members:
        _LEAF_TO_GROUP.setdefault(_m, _g)


def _lookup_group(name: str) -> tuple[str, list[str]] | None:
    key = name.strip().lower().lstrip("@").replace("-", "_").replace(" ", "_")
    if key in CATEGORY_GROUPS:
        return key, list(CATEGORY_GROUPS[key])
    if key in _GROUP_ALIASES:
        g = _GROUP_ALIASES[key]
        return g, list(CATEGORY_GROUPS[g])
    if key.endswith("s") and key[:-1] in CATEGORY_GROUPS:
        return key[:-1], list(CATEGORY_GROUPS[key[:-1]])
    return None


def _enumerate_categories(bbox, release) -> dict[str, int]:
    """Count `categories.primary` values inside bbox. {} when unavailable."""
    reader = _safe_reader("place", bbox, release, None, None, True)
    counts: dict[str, int] = {}
    if reader is None:
        return counts
    while True:
        try:
            batch = reader.read_next_batch()
        except StopIteration:
            break
        except Exception:
            break
        if batch.num_rows == 0:
            continue
        try:
            cat_col = batch.column("categories")
            primary = pc.struct_field(cat_col, "primary")
        except Exception:
            return {}
        for item in pc.value_counts(primary).to_pylist():
            val = item["values"]
            if val is None:
                continue
            counts[val] = counts.get(val, 0) + item["counts"]
    return counts


def _suggest_categories(type_: str, bbox, release, target: str, n: int = 5):
    """Up to `n` categories present in bbox that look like `target`.

    Token-aware so `ferry_terminal` matches `ferry_service`, not `cafeteria`.
    Only called on the failure path.
    """
    if type_ != "place":
        return []
    seen = set(_enumerate_categories(bbox, release))
    if not seen:
        return []

    import difflib
    target_lower = target.lower()
    target_tokens = set(target_lower.replace("_", " ").split())
    matcher = difflib.SequenceMatcher(autojunk=False)
    matcher.set_seq1(target_lower)

    scored = []
    for v in seen:
        v_lower = v.lower()
        matcher.set_seq2(v_lower)
        ratio = matcher.ratio()
        v_tokens = set(v_lower.replace("_", " ").split())
        token_overlap = len(target_tokens & v_tokens)
        substring_hit = int(target_lower in v_lower or v_lower in target_lower)
        if token_overlap or substring_hit or ratio >= 0.75:
            score = ratio + 0.2 * token_overlap + 0.15 * substring_hit
            scored.append((score, v))
    if not scored:
        return []
    scored.sort(key=lambda x: x[0], reverse=True)
    return [v for _, v in scored[:n]]


def _resolve_category_values(category: str, bbox, release) -> list[str]:
    """Expand --category into a list of leaf values.

    Accepts: 'cafe', 'cafe,coffee_shop', '@asian', 'asian', '*restaurant*'.
    """
    raw = str(category).strip()
    if not raw:
        return []

    if raw.startswith("@") or "," not in raw and not any(c in raw for c in "*?"):
        grp = _lookup_group(raw)
        if grp is not None and (raw.startswith("@") or raw.lower() not in _LEAF_TO_GROUP
                                or raw.lower().lstrip("@") in CATEGORY_GROUPS):
            name, members = grp
            click.secho(
                f"[botmap] --category {raw!r} expanded to group @{name} "
                f"({len(members)} leaf categories).",
                fg="bright_black", err=True,
            )
            return members

    if "," in raw:
        return [v.strip() for v in raw.split(",") if v.strip()]

    if any(c in raw for c in "*?"):
        present = _enumerate_categories(bbox, release)
        pattern = raw.lower()
        hits = sorted(v for v in present if fnmatch.fnmatch(v.lower(), pattern))
        if hits:
            click.secho(
                f"[botmap] --category {raw!r} matched {len(hits)} categories "
                f"present here: {', '.join(hits[:12])}"
                f"{' …' if len(hits) > 12 else ''}",
                fg="bright_black", err=True,
            )
            return hits
        click.secho(
            f"[botmap] --category {raw!r} matched no categories in this area. "
            f"Run `botmap categories --in <place> --top 300` to see what exists.",
            fg="yellow", err=True,
        )
        return [raw.replace("*", "")]

    return [raw]


def _category_filter(category: str, bbox, release) -> ParsedFilter | None:
    values = _resolve_category_values(category, bbox, release)
    if not values:
        return None
    if len(values) == 1:
        return ParsedFilter(key="categories.primary", op="=", value=values[0])
    return ParsedFilter(key="categories.primary", op="in", value=values)


def _umbrella_hint(category: str) -> None:
    """Warn when a single leaf category is really a cuisine/umbrella ask."""
    raw = str(category).strip().lower()
    if raw.startswith("@") or "," in raw or any(c in raw for c in "*?"):
        return
    group = _LEAF_TO_GROUP.get(raw)
    if not group:
        return
    members = CATEGORY_GROUPS[group]
    if len(members) < 3 or raw not in members:
        return
    click.secho(
        f"[botmap] Note: {raw!r} is ONE leaf category. Overture stores only "
        f"leaf categories, so this usually undercounts by a lot. The curated "
        f"group @{group} covers {len(members)} related categories — rerun with "
        f"`--category @{group}`, or enumerate with "
        f"`botmap categories --in <place> --top 300`.",
        fg="yellow", err=True,
    )


def _explain_zero(type_, bbox, release, filters, *, location_flag: str) -> None:
    """Never let a zero go out unexplained (worst failure mode in the system)."""
    filters = list(filters or [])
    if not filters:
        click.secho(
            f"[botmap] 0 {type_} features in this area. The area itself may be "
            f"wrong — verify it with `botmap where <place>` (check the bbox and "
            f"subtype), or widen the search area.",
            fg="yellow", err=True,
        )
        return

    total = _quiet_count(type_, bbox, release)
    if total == 0:
        click.secho(
            f"[botmap] 0 rows — and there are 0 {type_} features here even with "
            f"no filters. The area is probably wrong: check it with "
            f"`botmap where <place> --all` (name may resolve to the wrong "
            f"subtype), then rerun.",
            fg="yellow", err=True,
        )
        return

    total_txt = f"{total:,}" if isinstance(total, int) else "some"
    cat_filters = [f for f in filters
                   if f.key == "categories.primary" and f.op in ("=", "in")]
    if cat_filters and type_ == "place":
        target = cat_filters[0].value
        if isinstance(target, list):
            target = target[0] if target else None
        hits = _suggest_categories("place", bbox, release, str(target)) if target else []
        if hits:
            click.secho(
                f"[botmap] 0 rows. {total_txt} places exist here, but none have "
                f"categories.primary={target!r}. Did you mean: "
                f"{', '.join(hits)}? Full list: "
                f"`botmap categories {location_flag} --top 300`.",
                fg="yellow", err=True,
            )
        else:
            click.secho(
                f"[botmap] 0 rows. {total_txt} places exist here, but "
                f"categories.primary={target!r} is not among them. See the real "
                f"values with `botmap categories {location_flag} --top 300` "
                f"(Overture stores only leaf categories).",
                fg="yellow", err=True,
            )
        return

    keys = ", ".join(sorted({f.key for f in filters}))
    click.secho(
        f"[botmap] 0 rows. {total_txt} {type_} features exist in this area, so "
        f"the filter on {keys} is what excluded everything — not an empty map. "
        f"Inspect valid values with `botmap --json schema -t {type_}`, or drop "
        f"the filter to confirm.",
        fg="yellow", err=True,
    )


# ---------------------------------------------------------------------------
# Place resolution
# ---------------------------------------------------------------------------

def _safe_resolve(query):
    try:
        return resolve(query)
    except click.ClickException:
        raise
    except Exception as e:
        raise click.ClickException(
            _network_message(e, f"Resolving place name {query!r}")
            if _looks_network(e) else
            f"Could not resolve {query!r}: {type(e).__name__}: {e}\n"
            f"Try `botmap cache build` to rebuild the divisions index, or pass "
            f"--bbox directly."
        )


def _no_match_help(query: str) -> str:
    parts = [p.strip() for p in query.split(",")]
    name = parts[0]
    qualifiers = [p for p in parts[1:] if p]
    base = f"No division found for {query!r}."
    if qualifiers:
        fallback = _safe_resolve(name)
        if fallback:
            top = fallback[0]
            return (
                f"{base} The qualifier {', '.join(qualifiers)!r} matched "
                f"nothing, but {name!r} alone resolves to "
                f"{_describe_division(top)}.\n"
                f"Ready to run: botmap where \"{name}\" --all\n"
                f"Then use `--in \"{name}\"`, `botmap containing LAT,LON`, "
                f"or `--bbox xmin,ymin,xmax,ymax`."
            )
    return (
        f"{base} It may be a neighborhood that is not in Overture's divisions "
        f"index. Options:\n"
        f"  * try the parent locality (city -> county -> state -> country)\n"
        f"  * botmap where \"{name}\" --all      # see every candidate\n"
        f"  * botmap containing LAT,LON          # name the divisions at a point\n"
        f"  * pass --bbox xmin,ymin,xmax,ymax    # any rectangle works"
    )


def _resolve_in_place(in_place: str):
    """Resolve a --in query to a Division, warning to stderr on ambiguity."""
    matches = _safe_resolve(in_place)
    if not matches:
        parts = [p.strip() for p in in_place.split(",")]
        name, qualifiers = parts[0], [p for p in parts[1:] if p]
        for qualifier in qualifiers:
            parent_matches = _safe_resolve(qualifier)
            if not parent_matches:
                continue
            parent = parent_matches[0]
            if parent.region:
                scoped = _safe_resolve(f"{name}, {parent.region}")
                if scoped:
                    result = scoped[0]
                    click.secho(
                        f"[botmap] {in_place!r} not in divisions index; "
                        f"resolved via parent {qualifier!r} → "
                        f"using {_describe_division(result)}",
                        fg="yellow", err=True,
                    )
                    return result
            click.secho(
                f"[botmap] {in_place!r} not in divisions index; "
                f"using parent {qualifier!r} "
                f"({_describe_division(parent)}) bbox instead",
                fg="yellow", err=True,
            )
            return parent
        raise click.UsageError(_no_match_help(in_place))
    picked = matches[0]
    if len(matches) > 1:
        alt = matches[1]
        more = f" (+{len(matches) - 2} more)" if len(matches) > 2 else ""
        click.secho(
            f"[botmap] Ambiguous --in {in_place!r}: picked "
            f"{_describe_division(picked)} over "
            f"{_describe_division(alt)}{more}. "
            f"Run `botmap where \"{in_place}\" --all` to see all.",
            fg="yellow", err=True,
        )
        subtypes = {m.subtype for m in matches[:4]}
        if len(subtypes) > 1:
            click.secho(
                f"[botmap] Careful: candidates have different subtypes "
                f"({', '.join(sorted(subtypes))}). A country and a city of the "
                f"same name are not comparable — qualify the name if you meant "
                f"the other one.",
                fg="yellow", err=True,
            )
    return picked


def _bbox_from_location(in_place, bbox, *, required=True):
    """Common --in / --bbox handling. Returns (bbox_list, location_flag)."""
    if bbox is not None and in_place is not None:
        raise click.UsageError(
            "--bbox and --in are mutually exclusive; pick one.\n"
            'Example: botmap count -t place --in "Cambridge, MA" --category cafe'
        )
    if bbox is None and in_place is None:
        if required:
            raise click.UsageError(
                "Provide a location with --in \"<place name>\" or "
                "--bbox xmin,ymin,xmax,ymax.\n"
                'Example: botmap count -t place --in "Rhode Island" '
                "--category hospital"
            )
        return None, ""
    if in_place is not None:
        division = _resolve_in_place(in_place)
        out = list(division.bbox)
        loc = division.region or division.country or "unknown"
        pop = (f"pop {division.population:,}"
               if division.population is not None else "pop unknown")
        click.secho(
            f"[botmap] Resolved {in_place!r} -> {division.name} "
            f"({division.subtype}, {loc}, {pop}); bbox "
            f"{out[0]:.4f},{out[1]:.4f},{out[2]:.4f},{out[3]:.4f}",
            fg="bright_black", err=True,
        )
        return out, f'--in "{in_place}"'
    out = list(bbox)
    return out, f"--bbox {out[0]},{out[1]},{out[2]},{out[3]}"


def _limit_reader(reader, n):
    """Yield a new RecordBatchReader emitting at most `n` rows."""
    import pyarrow as pa

    def _batches():
        remaining = n
        while remaining > 0:
            try:
                batch = reader.read_next_batch()
            except StopIteration:
                return
            if batch.num_rows == 0:
                continue
            if batch.num_rows > remaining:
                batch = batch.slice(0, remaining)
            remaining -= batch.num_rows
            yield batch

    return pa.RecordBatchReader.from_batches(reader.schema, _batches())


def _describe_param(param: click.Parameter) -> dict:
    out: dict = {
        "name": param.name,
        "required": getattr(param, "required", False),
    }
    if isinstance(param, click.Option):
        out["flags"] = list(param.opts)
        out["help"] = param.help or ""
        out["multiple"] = param.multiple
        out["is_flag"] = param.is_flag
    if param.default is not None and param.default is not False:
        try:
            if isinstance(param.default,
                          (str, int, float, bool, list, tuple, type(None))):
                out["default"] = param.default
        except Exception:
            pass
    if isinstance(param.type, click.Choice):
        out["choices"] = list(param.type.choices)
    return out


def _describe_command(name: str, command: click.Command) -> dict:
    return {
        "name": name,
        "help": command.help or command.short_help or "",
        "params": [_describe_param(p) for p in command.params],
    }


def _walk_group(group: click.Group, prefix: str = "") -> list[dict]:
    out: list[dict] = []
    for name, cmd in group.commands.items():
        full = f"{prefix}{name}" if not prefix else f"{prefix} {name}"
        if isinstance(cmd, click.Group):
            out.extend(_walk_group(cmd, prefix=full))
        else:
            out.append(_describe_command(full, cmd))
    return out


# Earth's total surface area in square degrees (360 * 180).
EARTH_AREA_SQ_DEG = 64800
LARGE_BBOX_THRESHOLD = 0.01  # 1% of Earth

TYPE_TO_VERB = {
    "place": "places",
    "segment": "roads",
    "building": "buildings",
    "address": "addresses",
    "water": "water",
    "land_use": "landuse",
    "division_area": "boundary",
}


def _suggest_verb_command(verb, in_place, bbox, where_exprs, output_format, output) -> str:
    parts = [f"botmap {verb}"]
    if in_place:
        parts.append(f'--in "{in_place}"')
    elif bbox is not None:
        parts.append(f"--bbox {bbox[0]},{bbox[1]},{bbox[2]},{bbox[3]}")
    leftover = []
    for expr in (where_exprs or []):
        if expr.startswith("categories.primary="):
            parts.append(f"--category {expr.split('=', 1)[1]}")
        elif expr.startswith("class="):
            parts.append(f"--class {expr.split('=', 1)[1]}")
        else:
            leftover.append(expr)
    for expr in leftover:
        parts.append(f'--where "{expr}"')
    if output_format:
        parts.append(f"-f {output_format}")
    if output:
        parts.append(f"-o {output}")
    return " ".join(parts)


def _print_banner():
    try:
        import pyfiglet
        banner = pyfiglet.figlet_format("Overture Maps", font="slant")
    except Exception:
        banner = "Overture Maps\n"
    try:
        version = importlib.metadata.version("botmap")
    except Exception:
        version = "?"
    click.secho(banner.rstrip(), fg="blue", bold=True, err=True)
    click.secho(f"  v{version}  |  overturemaps.org\n", fg="bright_blue", err=True)


def _bbox_area_sq_deg(xmin, ymin, xmax, ymax) -> float:
    return abs(xmax - xmin) * abs(ymax - ymin)


class BboxParamType(click.ParamType):
    name = "bbox"

    def convert(self, value, param, ctx):
        if isinstance(value, (list, tuple)):
            return list(value)
        text = str(value).strip().strip("()[]")
        if "," not in text:
            text = ",".join(text.split())
        parts = text.split(",")
        if len(parts) != 4:
            self.fail(
                f"bbox requires exactly 4 values (xmin,ymin,xmax,ymax), "
                f"got {len(parts)}. Example: --bbox -71.10,42.34,-71.05,42.36 "
                f"(longitude first). Don't know the box? Run "
                f"`botmap where \"<place>\"`."
            )
        try:
            bbox = [float(x.strip()) for x in parts]
        except ValueError:
            self.fail(
                f"All bbox values must be numbers. Got '{value}'. "
                f"Example: --bbox -71.10,42.34,-71.05,42.36"
            )
        xmin, ymin, xmax, ymax = bbox
        if not (-180 <= xmin <= 180 and -180 <= xmax <= 180):
            self.fail(
                f"Longitude values must be between -180 and 180 "
                f"(got xmin={xmin}, xmax={xmax}). bbox order is "
                f"xmin,ymin,xmax,ymax = lon,lat,lon,lat."
            )
        if not (-90 <= ymin <= 90 and -90 <= ymax <= 90):
            self.fail(
                f"Latitude values must be between -90 and 90 "
                f"(got ymin={ymin}, ymax={ymax}). bbox order is "
                f"xmin,ymin,xmax,ymax = lon,lat,lon,lat."
            )
        if xmin > xmax:
            self.fail(
                f"xmin ({xmin}) must be <= xmax ({xmax}). "
                f"Ready to run: --bbox {xmax},{ymin},{xmin},{ymax}"
            )
        if ymin > ymax:
            self.fail(
                f"ymin ({ymin}) must be <= ymax ({ymax}). "
                f"Ready to run: --bbox {xmin},{ymax},{xmax},{ymin}"
            )
        return bbox


def validate_gers_id(ctx, param, value):
    if not value:
        raise click.BadParameter("GERS ID cannot be empty")
    try:
        parsed_uuid = uuid.UUID(value)
        return str(parsed_uuid)
    except ValueError:
        raise click.BadParameter(f"GERS ID must be a valid UUID. Got: '{value}'")


