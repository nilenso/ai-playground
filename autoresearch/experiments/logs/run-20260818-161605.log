def _cheatsheet_text() -> str:
    width = max(len(q) for q, _ in CHEATSHEET)
    lines = ["QUESTION -> COMMAND", ""]
    for q, c in CHEATSHEET:
        lines.append(f"  {q.ljust(width)}   {c}")
    lines += [
        "",
        "Any verb accepts --in \"<place name>\" or --bbox xmin,ymin,xmax,ymax.",
        "Add --count to any verb to get just a number. Add --json for machine output.",
        "Never trust a silent zero: botmap always explains a 0-row result on stderr.",
    ]
    return "\n".join(lines)


