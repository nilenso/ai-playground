# --------------------------------------------------------------------------
# small helpers
# --------------------------------------------------------------------------
def _norm(name: str) -> str:
    return re.sub(r"[^a-z0-9]", "", str(name).lower())


def _variants(name: str) -> set:
    n = _norm(name)
    out = {n}
    if n.endswith("ies") and len(n) > 3:
        out.add(n[:-3] + "y")
    if n.endswith("es") and len(n) > 2:
        out.add(n[:-2])
    if n.endswith("s") and len(n) > 1:
        out.add(n[:-1])
    out.add(n + "s")
    out.add(n + "es")
    return {v for v in out if v}


def _is_stringish(t: Optional[pa.DataType]) -> bool:
    if t is None:
        return False
    try:
        return (
            pa.types.is_string(t)
            or pa.types.is_large_string(t)
            or (hasattr(pa.types, "is_string_view") and pa.types.is_string_view(t))
        )
    except Exception:
        return False


def _is_listish(t: Optional[pa.DataType]) -> bool:
    if t is None:
        return False
    try:
        return (
            pa.types.is_list(t)
            or pa.types.is_large_list(t)
            or pa.types.is_fixed_size_list(t)
            or (hasattr(pa.types, "is_list_view") and pa.types.is_list_view(t))
        )
    except Exception:
        return False


def _is_container(t: Optional[pa.DataType]) -> bool:
    if t is None:
        return False
    try:
        return pa.types.is_struct(t) or _is_listish(t) or pa.types.is_map(t)
    except Exception:
        return False


def _children(t: Optional[pa.DataType]) -> List[Tuple[str, pa.DataType, bool]]:
    """Return [(name, type, parent_was_a_list), ...] for struct / list<struct>."""
    if t is None:
        return []
    try:
        if pa.types.is_struct(t):
            return [(t.field(i).name, t.field(i).type, False) for i in range(t.num_fields)]
        if _is_listish(t):
            vt = t.value_type
            if pa.types.is_struct(vt):
                return [(vt.field(i).name, vt.field(i).type, True) for i in range(vt.num_fields)]
            return []
    except Exception:
        return []
    return []


def _schema_names(schema: Any) -> List[str]:
    try:
        return list(schema.names)
    except Exception:
        return []


def _top_field_type(schema: Any, name: str) -> Optional[pa.DataType]:
    try:
        return schema.field(name).type
    except Exception:
        return None


def _walk_paths(schema: Any, max_depth: int = 3) -> List[Tuple[str, pa.DataType, bool]]:
    """All dotted paths in the schema: (path, type, crosses_a_list)."""
    out: List[Tuple[str, pa.DataType, bool]] = []

    def rec(prefix: List[str], t: pa.DataType, crossed: bool, depth: int) -> None:
        for cname, ctype, parent_list in _children(t):
            path = prefix + [cname]
            crossed_now = crossed or parent_list
            out.append((".".join(path), ctype, crossed_now))
            if _is_container(ctype) and depth < max_depth:
                rec(path, ctype, crossed_now, depth + 1)

    for name in _schema_names(schema):
        t = _top_field_type(schema, name)
        out.append((name, t, False))
        if _is_container(t):
            rec([name], t, False, 1)
    return out


def filterable_fields(schema: Any, limit: int = 28) -> List[str]:
    """Dotted paths that `--where` can actually compare (no list traversal)."""
    good = []
    for path, t, crossed in _walk_paths(schema, max_depth=2):
        if crossed or _is_container(t):
            continue
        good.append(path)
    good.sort(key=lambda p: (p.count("."), p))
    return good[:limit]


def _field_list_hint(schema: Any) -> str:
    fields = filterable_fields(schema)
    if not fields:
        return ""
    return "Filterable fields here: " + ", ".join(fields) + "."


# --------------------------------------------------------------------------
# field-name aliases: the spellings an assistant actually types
# --------------------------------------------------------------------------
_ALIASES = {
    # names
    "name": ["names.primary", "name", "primary_name"],
    "names": ["names.primary", "name"],
    "title": ["names.primary"],
    "label": ["names.primary"],
    "primaryname": ["names.primary"],
    "placename": ["names.primary"],
    "poiname": ["names.primary"],
    "roadname": ["names.primary", "street"],
    "commonname": ["names.primary"],
    "brand": ["brand.names.primary", "brand"],
    "brandname": ["brand.names.primary"],
    "operator": ["operator", "names.primary"],
    # categories / classification
    "category": ["categories.primary", "class", "subtype"],
    "categories": ["categories.primary"],
