def _feature_verb_options(fn):
    """Shared decorators for the feature verbs."""
    fn = click.option("--json", "json_flag", is_flag=True, default=False)(fn)
    fn = click.option("-r", "--release", default=None, callback=validate_release,
                      required=False)(fn)
    fn = click.option("-o", "--output", required=False, type=click.Path())(fn)
    fn = click.option("-f", "output_format",
                      type=click.Choice(["geojson", "geojsonseq", "geoparquet"]),
                      default="geojsonseq", show_default=True)(fn)
    fn = click.option("-c", "--count", "count_only", is_flag=True, default=False,
                      help="Print just the number of matches instead of "
                           "features.")(fn)
    fn = click.option("-n", "--limit", "limit", default=None, type=int,
                      help="Maximum number of features to emit "
                           "(default: all matches).")(fn)
    fn = click.option("--where", "where_exprs", multiple=True,
                      help="Raw attribute filter K OP V (repeatable).")(fn)
    fn = click.option("--bbox", required=False, type=BboxParamType(),
                      help="Bounding box xmin,ymin,xmax,ymax. Mutually "
                           "exclusive with --in.")(fn)
    fn = click.option("--in", "in_place", required=False, type=str,
                      help="Place name, resolved via the divisions index.")(fn)
    return fn


@cli.command()
@_feature_verb_options
@click.option("--category", "categories_", multiple=True,
              help="POI category (repeatable), e.g. hospital, coffee_shop. "
                   "Shortcut for --where categories.primary=VAL. Unsure of the "
                   "spelling? `botmap values --in \"<place>\" "
                   "--field categories.primary`.")
@click.option("--name", required=False, type=str,
              help="Case-insensitive substring on names.primary OR "
                   "brand.names.primary (chains: --name Starbucks).")
@click.option("--brand", required=False, type=str,
              help="Case-insensitive substring on brand.names.primary only.")
@click.pass_context
def places(ctx, in_place, bbox, where_exprs, limit, count_only, output_format,
           output, release, json_flag, categories_, name, brand):
    """POIs / businesses in a place. Filter with --category, --name, --brand.

    \b
    botmap places --in "Cambridge, MA" --category coffee_shop
    botmap places --in "Seattle, WA" --name Starbucks --count
    """
    filters = _parse_where(where_exprs)
    row_parts = []
    cats = [c for c in (categories_ or []) if c]
    if len(cats) == 1:
        filters.append(ParsedFilter(key="categories.primary", op="=", value=cats[0]))
    elif len(cats) > 1:
        row_parts.append(FieldSetFilter("categories.primary", cats))
    if name or brand:
        row_parts.append(NameFilter(name=name, brand=brand))
    _run_features(
        ctx, "place", in_place, bbox, filters, _combine_filters(row_parts),
        limit, output_format, output, release, count_only=count_only,
        json_flag=json_flag,
        example='botmap places --in "Cambridge, MA" --category coffee_shop',
    )


