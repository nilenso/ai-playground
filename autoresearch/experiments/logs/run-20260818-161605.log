@cli.command("examples")
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def examples_cmd(ctx, json_flag):
    """Question -> command cheat sheet (start here)."""
    if _json_mode(ctx, json_flag):
        _emit_json(ctx, [{"question": q, "command": c} for q, c in RECIPES])
        return
    click.secho("QUESTION -> COMMAND", bold=True)
    for line in _cheat_sheet_lines():
        click.echo(line)
    click.echo()
    click.echo(NOTES)


@cli.command("groups")
@click.argument("name", required=False)
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def groups_cmd(ctx, name, json_flag):
    """Curated category groups for `--category @NAME` (e.g. @asian, @lodging).

    Overture stores only leaf categories, so cuisine- or sector-level questions
    ("Asian restaurants", "hotels", "schools") need many leaf values at once.
    """
    if name:
        found = _lookup_group(name)
        if not found:
            raise click.UsageError(
                f"No category group named {name!r}. Known groups: "
                f"{', '.join(sorted(CATEGORY_GROUPS))}.\n"
                f"You can also use a glob: --category '*{name.lower()}*'"
            )
        gname, members = found
        if _json_mode(ctx, json_flag):
            _emit_json(ctx, {"group": gname, "categories": members})
            return
        click.secho(f"@{gname}  ({len(members)} categories)", bold=True)
        for m in members:
            click.echo(f"  {m}")
        click.echo()
        click.echo(f'Use: botmap count -t place --in "<place>" --category @{gname}')
        return

    if _json_mode(ctx, json_flag):
        _emit_json(ctx, [{"group": g, "categories": v}
                         for g, v in sorted(CATEGORY_GROUPS.items())])
        return
    click.secho("Category groups (use as --category @NAME)", bold=True)
    for g, members in sorted(CATEGORY_GROUPS.items()):
        click.secho(f"  @{g}", fg="cyan", bold=True, nl=False)
        click.echo(f"  ({len(members)}): {', '.join(members[:6])}"
                   f"{' …' if len(members) > 6 else ''}")
    click.echo()
    click.echo('Example: botmap count -t place --in "Cambridge, MA" --category @asian')
    click.echo("Groups are convenience supersets; verify with "
               "`botmap categories --in \"<place>\" --top 300`.")


# ---------------------------------------------------------------------------
# download (bulk escape hatch)
# ---------------------------------------------------------------------------

@cli.command()
@click.option("--bbox", required=False, type=BboxParamType())
@click.option("--in", "--place", "--location", "in_place", required=False, type=str,
              help="Resolve a place name to a bbox via the divisions index.")
@click.option("--where", "where_exprs", multiple=True,
              help="Attribute filter K OP V (repeatable). Example: --where height>50")
@click.option(
    "-f",
    "output_format",
    type=click.Choice(["geojson", "geojsonseq", "geoparquet"]),
    required=True,
)
@click.option("-o", "--output", required=False, type=click.Path())
@click.option("-t", "--type", "type_", type=OVERTURE_TYPE, required=True)
@click.option("-r", "--release", default=None, callback=validate_release,
              required=False, help="Release version (defaults to latest)")
@click.option(
    "--stac/--no-stac",
    required=False,
    type=bool,
    is_flag=True,
    default=True,
    help="By default, uses the STAC catalog to limit which Parquet files are "
         "downloaded. Pass --no-stac to skip the catalog and read S3 directly.",
)
@click.option("--connect_timeout", required=False, type=int)
@click.option("--request_timeout", required=False, type=int)
@click.argument("extra", nargs=-1)
def download(
    bbox, in_place, where_exprs, output_format, output, type_, release,
    connect_timeout, request_timeout, stac, extra,
):
    """Bulk export raw features (last resort — prefer the verbs above)."""
    in_place, where_exprs = _fix_unquoted(extra, in_place, where_exprs)

    if bbox is not None and in_place is not None:
        raise click.UsageError("--bbox and --in are mutually exclusive")

    # Steering hints: nudge toward the right tool when download isn't needed.
    verb = TYPE_TO_VERB.get(type_)
    if verb is not None:
        suggestion = _suggest_verb_command(
            verb, in_place, bbox, where_exprs, output_format, output
        )
        if type_ == "division_area":
            raise click.UsageError(
                f"division_area is not downloadable this way — "
                f"for a boundary polygon run: {suggestion}"
            )
        click.secho(
            f"[botmap] Tip: try instead: {suggestion}",
            fg="bright_black", err=True,
        )
    elif type_ == "infrastructure":
        _TRANSIT_CLASSES = {"bus_stop", "bus_station", "train_station", "transit"}
        is_transit = any(
            (e.startswith("class=") and e.split("=", 1)[1].strip() in _TRANSIT_CLASSES)
            or e.startswith("subtype=transit")
            for e in (where_exprs or [])
        )
        if is_transit:
            loc_flag = (
                f'--in "{in_place}"' if in_place
                else (f"--bbox {bbox[0]},{bbox[1]},{bbox[2]},{bbox[3]}"
                      if bbox else "--in <place>")
            )
            raise click.UsageError(
                f"Transit stops are `place` features, not infrastructure — run: "
                f"botmap places --category bus_stop {loc_flag}"
            )
        click.secho(
            "[botmap] Tip: transit stops (bus_stop, bus_station, "
            "train_station) are `place` features — use "
            "`botmap places --category bus_stop`. "
            "For non-transit infrastructure, download is correct.",
            fg="bright_black", err=True,
        )

    if in_place is not None:
        division = _resolve_in_place(in_place)
        bbox = list(division.bbox)
        loc = division.region or division.country or "unknown"
        pop = (f"pop {division.population:,}"
               if division.population is not None else "pop unknown")
        click.secho(
            f"Resolved {in_place!r} -> {division.name} "
            f"({division.subtype}, {loc}, {pop})",
            fg="bright_black", err=True,
        )

    where_filters = None
    if where_exprs:
        try:
            where_filters = [parse_where_expr(e) for e in where_exprs]
        except ValueError as e:
            raise click.UsageError(str(e))

    if bbox is None:
        click.secho(
            "Warning: No bounding box provided. Downloading the entire dataset "
            "for this type. The full Overture dataset is approximately "
            "1.2 TB as GeoJSON and 400 GB as GeoParquet. Add --in \"<place>\" "
            "or --bbox to bound it.",
            fg="yellow", bold=True, err=True,
        )
    else:
        area = _bbox_area_sq_deg(bbox[0], bbox[1], bbox[2], bbox[3])
        fraction = area / EARTH_AREA_SQ_DEG
        if fraction >= LARGE_BBOX_THRESHOLD:
            pct = fraction * 100
            click.secho(
                f"Warning: The bounding box covers ~{pct:.1f}% of Earth's "
                f"surface. This may take a long time and use significant "
                f"bandwidth.",
                fg="yellow", bold=True, err=True,
            )

    if output_format == "geoparquet" and output is None:
        raise click.UsageError(
            "Output file (-o/--output) is required when using geoparquet format"
        )

    output_file = sys.stdout if output is None else output

    reader = _safe_reader(
        type_, bbox, release, connect_timeout, request_timeout, stac,
        where_filters=where_filters,
    )

    if reader is None:
        click.secho(
            f"[botmap] No data available for type {type_!r} in this area "
            f"(the reader returned nothing). Verify the area with "
            f"`botmap where <place>`.",
            fg="yellow", err=True,
        )
        return

    with get_writer(output_format, output_file, schema=reader.schema) as writer:
        rows = copy(reader, writer)

    if rows == 0:
        _explain_zero(type_, bbox, release, where_filters,
                      location_flag=(f'--in "{in_place}"' if in_place else
                                     (f"--bbox {bbox[0]},{bbox[1]},{bbox[2]},{bbox[3]}"
                                      if bbox else "")))

    if output is not None:
        output_path = os.path.abspath(os.path.expanduser(output))
        backend = Backend(output_format)
        theme = type_theme_map.get(type_)
        if theme is None:
            click.secho(
                f"Warning: Could not determine theme for type {type_}",
                fg="yellow", bold=True, err=True,
            )
            return

        state = PipelineState(
            last_release=release,
            last_run=datetime.now(timezone.utc).isoformat(),
            theme=theme,
            type=type_,
            bbox=(
                BBox(xmin=bbox[0], ymin=bbox[1], xmax=bbox[2], ymax=bbox[3])
                if bbox is not None else None
            ),
            backend=backend,
            output=output_path,
        )

        state_path = get_state_path(output)
        save_state(state, state_path)
        click.secho(f"State saved to {state_path}", fg="bright_black", err=True)


@cli.command()
@click.argument("gers_id", required=True, callback=validate_gers_id)
@click.option(
    "-f", "output_format",
    type=click.Choice(["geojson", "geojsonseq", "geoparquet"]),
    default=None, required=False,
    help="Output format. If not specified, only registry information is shown.",
)
@click.option("-o", "--output", required=False, type=click.Path())
@click.option("--connect_timeout", required=False, type=int)
@click.option("--request_timeout", required=False, type=int)
@click.pass_context
def gers(ctx, gers_id, output_format, output, connect_timeout, request_timeout):
    """Query the GERS registry for a feature by its GERS ID."""
    from .core import query_gers_registry

    result = query_gers_registry(gers_id)

    if result is None:
        raise click.ClickException(
            f"No GERS registry entry for {gers_id!r}. GERS ids are UUIDs "
            f"attached to Overture features; find one with "
            f"`botmap places --in \"<place>\" -n 1`."
        )

    if output_format is None:
        click.secho(
            f"\nRegistry lookup complete for GERS ID: {gers_id}",
            fg="bright_black", err=True,
        )
        click.secho(
            "To download the feature data, use -f/--format option.",
            fg="bright_black", err=True,
        )
        return

    if output_format == "geoparquet" and output is None:
        raise click.UsageError(
            "Output file (-o/--output) is required when using geoparquet format"
        )

    if output is None:
        output = sys.stdout

    reader = record_batch_reader_from_gers(
        gers_id, connect_timeout, request_timeout, registry_result=result
    )

    if reader is None:
        raise click.ClickException(
            f"Could not fetch feature data for GERS ID '{gers_id}'"
        )

    with get_writer(output_format, output, schema=reader.schema) as writer:
        copy(reader, writer)


# ---------------------------------------------------------------------------
# Place resolution commands
# ---------------------------------------------------------------------------

@cli.command()
@click.argument("query", nargs=-1)
@click.option("--in", "in_query", required=False, type=str,
              help="Alias for the positional QUERY.")
@click.option("--all", "show_all", is_flag=True, default=False,
              help="Show all matching divisions, not just the best one.")
@click.option("--geometry", "--geojson", "geometry", is_flag=True, default=False,
              help="Emit the division's polygon as a GeoJSON Feature on stdout.")
@click.option("-r", "--release", default=None, required=False, hidden=True,
              help="Accepted and ignored (the divisions index tracks latest).")
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def where(ctx, query, in_query, show_all, geometry, release, json_flag):
    """Resolve a place name to bbox / population / subtype.

    QUERY may be unquoted: `botmap where Cambridge, MA` works.
    """
    text = " ".join(query).strip() if query else (in_query or "").strip()
    if in_query and query:
        text = " ".join(query).strip()
    if not text:
        raise click.UsageError(
            'Give a place name, e.g. botmap where "Cambridge, MA"'
        )
    json_mode = _json_mode(ctx, json_flag)
    matches = _safe_resolve(text)
    if not matches:
        try:
            pick = _resolve_in_place(text)
            matches = [pick]
        except click.UsageError as e:
            msg = str(e)
            if json_mode:
                _emit_error_json(msg, code="no_match")
            else:
                click.secho(msg, fg="red", err=True)
            ctx.exit(1)
            return
    pick = matches[0]

    if geometry:
        _emit_division_geometry(ctx, pick)
        return

    if json_mode:
        payload = pick.as_dict()
        payload["candidates"] = [d.as_dict() for d in matches]
        _emit_json(ctx, payload)
        return

    def _print_one(d, prefix=""):
        qual = d.region or d.country or "?"
        click.secho(f"{prefix}{d.name}, {qual}", bold=True)
        click.echo(f"  subtype: {d.subtype}")
        click.echo(f"  bbox: {d.bbox[0]:.4f}, {d.bbox[1]:.4f}, "
                   f"{d.bbox[2]:.4f}, {d.bbox[3]:.4f}")
        if d.population is not None:
            click.echo(f"  population: {d.population:,}")
        click.echo(f"  id: {d.id}")

    if show_all:
        for i, d in enumerate(matches, start=1):
            _print_one(d, prefix=f"[{i}] ")
    else:
        _print_one(pick)
        if len(matches) > 1:
            click.secho(
                f"\n  ({len(matches) - 1} other match"
                f"{'es' if len(matches) - 1 != 1 else ''}; "
                f"rerun with --all to see them.)",
                fg="yellow",
            )
            subtypes = {m.subtype for m in matches[:4]}
            if len(subtypes) > 1:
                click.secho(
                    f"  Candidates span subtypes ({', '.join(sorted(subtypes))}) "
                    f"— e.g. a country and a city of the same name. Do not "
                    f"compare across subtypes without checking.",
                    fg="yellow",
                )
        click.echo(
            f"\n  Next: botmap count -t place --in \"{text}\" --category <cat>"
        )


@cli.command()
@click.argument("query", nargs=-1)
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.pass_context
def boundary(ctx, query, json_flag):
    """Emit a division's polygon as a GeoJSON Feature (for clipping/joins).

    QUERY is a place name, e.g. 'Alameda County, CA' or 'Brooklyn, NY'.
    """
    text = " ".join(query).strip()
    if not text:
        raise click.UsageError('Give a place name: botmap boundary "Brooklyn, NY"')
    division = _resolve_in_place(text)
    _emit_division_geometry(ctx, division)


# ---------------------------------------------------------------------------
# count / sample
# ---------------------------------------------------------------------------

@cli.command()
@click.option("-t", "--type", "type_", type=OVERTURE_TYPE, required=False,
              default=None,
              help="Feature type (place, building, segment, address, water, "
                   "land_use, connector, ...). Defaults to `place` when "
                   "--category is given.")
@click.option("--bbox", required=False, type=BboxParamType())
@click.option("--in", "--place", "--location", "in_place", required=False, type=str,
              help='Place name, e.g. --in "Rhode Island".')
@click.option("--category", "--categories", required=False, type=str,
              help="place only: leaf category, comma list, @group or glob. "
                   "Example: --category hospital / --category @asian / "
                   "--category '*restaurant*'")
@click.option("--class", "class_", required=False, type=str,
              help="Shortcut for --where class=VAL (segment/water/land_use).")
@click.option("--where", "where_exprs", multiple=True,
              help='Attribute filter, quote it: --where "height>50"')
@click.option("-r", "--release", default=None, callback=validate_release,
              required=False)
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.argument("extra", nargs=-1)
@click.pass_context
def count(ctx, type_, bbox, in_place, category, class_, where_exprs, release,
          json_flag, extra):
    """Count features matching a query — the answer to "how many X in PLACE?".

    Examples:
      botmap count --in "Rhode Island" --category hospital
      botmap count -t building --in "Providence, RI"
      botmap count -t segment --in "Brooklyn, NY" --where "class in [motorway,primary]"
    """
    extra = list(extra)
    if type_ is None and extra:
        try:
            maybe = OVERTURE_TYPE.convert(extra[0], None, ctx)
        except Exception:
            maybe = None
        if maybe:
            type_ = maybe
            extra = extra[1:]
    in_place, where_exprs = _fix_unquoted(extra, in_place, where_exprs)

    if type_ is None:
        if category is not None:
            type_ = "place"
        else:
            raise click.UsageError(
                "Which feature type? Pass -t/--type.\n"
                "Common: -t place (POIs), -t building, -t segment (roads), "
                "-t address, -t connector (junctions), -t water, -t land_use.\n"
                'Ready to run: botmap count -t place --in "<place>" '
                "--category <category>\n"
                "See all types: botmap types"
            )

    bbox, loc_flag = _bbox_from_location(in_place, bbox, required=False)
    if bbox is None:
        click.secho(
            "[botmap] No --in/--bbox given: counting this type worldwide, which "
            "is slow. Bound it with --in \"<place>\" or --bbox.",
            fg="yellow", err=True,
        )

    try:
        filters = [parse_where_expr(e) for e in where_exprs]
    except ValueError as e:
        raise click.UsageError(str(e))
    if class_ is not None:
        filters.append(ParsedFilter(key="class", op="=", value=class_))
    if category is not None:
        if type_ != "place":
            raise click.UsageError(
                f"--category applies to `place` features; type is {type_!r}. "
                f"For {type_!r} the classifying field is `class` — use "
                f"`--class <value>` (see `botmap --json schema -t {type_}`)."
            )
        cf = _category_filter(category, bbox, release)
        if cf is not None:
            filters.append(cf)

    n = _safe_count(
        type_, bbox=bbox, release=release, stac=True,
        where_filters=filters or None,
    )

    if _json_mode(ctx, json_flag):
        _emit_json(ctx, {
            "type": type_,
            "bbox": bbox,
            "where": [{"key": f.key, "op": f.op, "value": f.value}
                      for f in (filters or [])],
            "release": release,
            "count": n,
        })
    else:
        click.echo(f"{n:,}")

    if n == 0:
        _explain_zero(type_, bbox, release, filters, location_flag=loc_flag)
    elif category is not None:
        _umbrella_hint(category)


@cli.command()
@click.option("-t", "--type", "type_", type=OVERTURE_TYPE, required=False,
              default="place", show_default=True)
@click.option("--bbox", required=False, type=BboxParamType())
@click.option("--in", "--place", "--location", "in_place", required=False, type=str)
@click.option("--category", "--categories", required=False, type=str,
              help="place only: leaf category, comma list, @group or glob.")
@click.option("--class", "class_", required=False, type=str)
@click.option("--where", "where_exprs", multiple=True)
@click.option("-n", "--limit", "n", default=10, show_default=True, type=int,
              help="Maximum number of features to emit.")
@click.option("-f", "output_format",
              type=click.Choice(["geojson", "geojsonseq", "geoparquet"]),
              default="geojsonseq", show_default=True)
@click.option("-o", "--output", required=False, type=click.Path())
@click.option("-r", "--release", default=None, callback=validate_release,
              required=False)
@click.option("--json", "json_flag", is_flag=True, default=False)
@click.argument("extra", nargs=-1)
@click.pass_context
def sample(ctx, type_, bbox, in_place, category, class_, where_exprs, n,
           output_format, output, release, json_flag, extra):
    """Emit the first N features matching the query (quick look at real data)."""
    in_place, where_exprs = _fix_unquoted(extra, in_place, where_exprs)
    bbox, loc_flag = _bbox_from_location(in_place, bbox, required=False)

    try:
        filters = [parse_where_expr(e) for e in where_exprs]
    except ValueError as e:
        raise click.UsageError(str(e))
    if class_ is not None:
        filters.append(ParsedFilter(key="class", op="=", value=class_))
    if category is not None:
        cf = _category_filter(category, bbox, release)
        if cf is not None:
            filters.append(cf)

    if json_flag and _param_default(ctx, "output_format"):
        output_format = "geojson"
    if output_format == "geoparquet" and output is None:
        raise click.UsageError("Output file (-o/--output) is required for geoparquet")

    reader = _safe_reader(
        type_, bbox, release, None, None, True, where_filters=filters or None,
    )
    if reader is None:
        _explain_zero(type_, bbox, release, filters, location_flag=loc_flag)
        return

    output_file = sys.stdout if output is None else output
    limited = _limit_reader(reader, n)

    with get_writer(output_format, output_file, schema=limited.schema) as writer:
        rows = copy(limited, writer)

    if rows == 0:
        _explain_zero(type_, bbox, release, filters, location_flag=loc_flag)


def _param_default(ctx, name) -> bool:
    """True if the parameter still holds its default (user didn't pass it)."""
    try:
        return ctx.get_parameter_source(name) == click.core.ParameterSource.DEFAULT
    except Exception:
        return True


