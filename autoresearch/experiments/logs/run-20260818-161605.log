def _parse_latlon(latlon: str) -> tuple[float, float]:
    """Parse 'LAT,LON' (also 'LAT, LON' or 'LAT LON') into (lat, lon)."""
    text = str(latlon).strip().strip("()[]").rstrip(",")
    parts = [p.strip() for p in text.split(",") if p.strip()]
    if len(parts) == 1:
        parts = [p for p in parts[0].replace("/", " ").split() if p]
    if len(parts) != 2:
        raise click.UsageError(
            f"Could not read a coordinate from {latlon!r}. "
            f"Use 'LAT,LON' (latitude first), e.g. `botmap containing 42.36,-71.06`."
        )
    try:
        first, second = float(parts[0]), float(parts[1])
    except ValueError:
        raise click.UsageError(
            f"Coordinate values must be numeric; got {latlon!r}. "
            f"Example: 42.36,-71.06"
        )
    if abs(first) > 90 and abs(second) <= 90:
        click.secho(
            f"[botmap] {latlon!r} looks like LON,LAT — swapping to "
            f"lat={second}, lon={first}. This tool takes LAT,LON.",
            fg="yellow", err=True,
        )
        return second, first
    if abs(first) > 90 or abs(second) > 180:
        raise click.UsageError(
            f"Coordinate out of range: {latlon!r}. Expected 'LAT,LON' with "
            f"-90<=LAT<=90 and -180<=LON<=180."
        )
    return first, second


def _json_default(value):
    if isinstance(value, (bytes, bytearray)):
        return value.hex()
    raise TypeError(f"Type is not JSON serializable: {type(value).__name__}")


def _emit_json(ctx, payload, file=None):
    out = orjson.dumps(
        payload, default=_json_default, option=orjson.OPT_INDENT_2
    ).decode()
    click.echo(out, file=file)


def _emit_error_json(message, code="error"):
    err = {"error": {"code": code, "message": message}}
    click.echo(orjson.dumps(err).decode(), err=True)


def _json_mode(ctx, flag=False) -> bool:
    """True when --json was given before OR after the subcommand."""
    try:
        obj = ctx.obj or {}
    except Exception:
        obj = {}
    return bool(obj.get("json")) or bool(flag)


def _describe_division(d) -> str:
    qual = d.region or d.country or "?"
    pop = f"pop {d.population:,}" if d.population is not None else "pop ?"
    return f"{d.name} ({d.subtype}, {qual}, {pop})"


def _fix_unquoted(extra, in_place, where_exprs, what="query"):
    """Absorb stray argv tokens produced by missing shell quotes.

    `--in Cambridge, MA` and `--where class in [a,b]` are the two mistakes
    assistants make constantly; both leave leftover tokens. Rather than
    failing, attribute them and say what we did. If they cannot be
    attributed, fail with a ready-to-run quoted command.
    """
    extra = [e for e in (extra or []) if e not in ("", None)]
    where_exprs = list(where_exprs or [])
    if not extra:
        return in_place, where_exprs

    if in_place and in_place.rstrip().endswith(","):
        merged = in_place.rstrip() + " " + " ".join(extra)
        click.secho(
            f"[botmap] Unquoted place name detected; reading it as "
            f'--in "{merged}". Always quote place names.',
            fg="yellow", err=True,
        )
        return merged, where_exprs

    if where_exprs:
        candidate = " ".join([where_exprs[-1], *extra])
        try:
            parse_where_expr(candidate)
        except Exception:
            pass
        else:
            click.secho(
                f"[botmap] Unquoted filter detected; reading it as "
                f'--where "{candidate}". Always quote --where expressions.',
                fg="yellow", err=True,
            )
            where_exprs[-1] = candidate
            return in_place, where_exprs

    raise click.UsageError(
        f"Unrecognized extra arguments: {' '.join(extra)}\n"
        f"Any value containing a space must be quoted. Correct shapes:\n"
        f'  botmap count -t place --in "Cambridge, MA" --category cafe\n'
        f'  botmap count -t segment --bbox -74.0,40.7,-73.9,40.8 '
        f'--where "class in [motorway,primary]"'
    )


