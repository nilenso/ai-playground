def _normalize_qualifier(q: str) -> str:
    """'USA'/'United States' → 'US'; 'New York' → 'NY' ('-NY' suffix match)."""
    normalized = q.strip().strip(".").upper()
    normalized = re.sub(r"\s+", " ", normalized)
    if normalized in _COUNTRY_ALIASES:
        return _COUNTRY_ALIASES[normalized]
    if normalized in _US_STATE_ALIASES:
        return _US_STATE_ALIASES[normalized]
    if normalized in _SUBDIVISION_ALIASES:
        return _SUBDIVISION_ALIASES[normalized]
    # "Massachusetts, USA" style already handled; also accept "US - MA".
    compact = normalized.replace(" ", "")
    if re.fullmatch(r"[A-Z]{2}-[A-Z0-9]{1,3}", compact):
        return compact
    return normalized


# --------------------------------------------------------------------------- #
# Query parsing / name folding
# --------------------------------------------------------------------------- #

_PAREN_RE = re.compile(r"\(([^)]*)\)")
_PUNCT_RE = re.compile(r"[^\w\s]", re.UNICODE)
_WS_RE = re.compile(r"\s+")

_ABBREV = {
    "st": "saint", "st.": "saint", "ste": "sainte", "mt": "mount", "mt.": "mount",
    "ft": "fort", "n": "north", "s": "south", "e": "east", "w": "west",
    "nw": "northwest", "ne": "northeast", "sw": "southwest", "se": "southeast",
}

_GENERIC_SUFFIXES = {
    "county", "city", "municipality", "parish", "borough", "district",
    "township", "town", "village", "prefecture", "province", "state",
    "region", "department", "canton", "comune", "gemeinde", "municipio",
    "metropolitan", "area", "council", "shire",
}

_GENERIC_PREFIXES = (
    "city of", "town of", "village of", "municipality of", "borough of",
    "county of", "state of", "province of", "district of", "the",
)

_MAX_FUZZY = 2000


def _fold(s: str) -> str:
    """Accent/case/punctuation-insensitive form of a name."""
    if not s:
        return ""
    s = unicodedata.normalize("NFKD", s)
    s = "".join(ch for ch in s if not unicodedata.combining(ch))
    for a, b in (("ß", "ss"), ("Ø", "O"), ("ø", "o"), ("Đ", "D"), ("đ", "d"),
                 ("Ł", "L"), ("ł", "l"), ("Æ", "AE"), ("æ", "ae"), ("Œ", "OE"),
                 ("œ", "oe")):
        s = s.replace(a, b)
    s = s.lower().replace("&", " and ")
    s = _PUNCT_RE.sub(" ", s)
    return _WS_RE.sub(" ", s).strip()


def _canon(s: str) -> str:
    """Fold, expand 'St.'/'Mt.', drop 'City of ...' / '... County' noise."""
    f = _fold(s)
    if not f:
        return ""
    changed = True
    while changed:
        changed = False
        for p in _GENERIC_PREFIXES:
            if f.startswith(p + " ") and len(f) > len(p) + 1:
                f = f[len(p) + 1:]
                changed = True
    words = [_ABBREV.get(w, w) for w in f.split()]
    while len(words) > 1 and words[-1] in _GENERIC_SUFFIXES:
        words.pop()
    return " ".join(words)


def _parse_query(query: str) -> Tuple[str, List[str]]:
    """Split 'Boston, US-MA' into ('Boston', ['US-MA']).

    Also accepts 'Boston (Massachusetts)', 'Boston / MA', 'Boston | MA' and
    strips surrounding quotes, because assistants type all of these.
    """
    if query is None:
        return "", []
    q = str(query).strip().strip('"').strip("'").strip()
    # Parenthesised qualifier -> comma form.
    m = _PAREN_RE.search(q)
    if m:
        inner = m.group(1).strip()
        q = (_PAREN_RE.sub("", q).strip() + (", " + inner if inner else "")).strip()
    q = q.replace(" | ", ", ").replace(" / ", ", ").replace(";", ",")
    parts = [p.strip() for p in q.split(",")]
    name = parts[0].strip()
    qualifiers = [p for p in parts[1:] if p]
    # "Washington DC" / "New York City, NY" style shortcuts.
    upper = name.upper()
    if upper in ("WASHINGTON DC", "WASHINGTON D.C.", "WASHINGTON, D.C."):
        name, qualifiers = "Washington", ["DC"] + qualifiers
    elif upper in ("NYC", "NEW YORK CITY"):
        name = "New York"
        if not qualifiers:
            qualifiers = ["US-NY"]
    return name, qualifiers


# --------------------------------------------------------------------------- #
# Index loading
# --------------------------------------------------------------------------- #

class _Index:
    def __init__(self, release: str, table) -> None:
        self.release = release
        self.table = table
        self._lower = None
        self._names = None
        self._fold_map: Optional[dict] = None
        self._canon_map: Optional[dict] = None

    @property
    def lowered(self):
        if self._lower is None:
            self._lower = pc.utf8_lower(self.table.column("name_primary"))
        return self._lower

    @property
    def names(self) -> List[Optional[str]]:
        if self._names is None:
            self._names = self.table.column("name_primary").to_pylist()
        return self._names

    @property
    def fold_map(self) -> dict:
        if self._fold_map is None:
            m: dict = {}
            for i, n in enumerate(self.names):
                if not n:
                    continue
                m.setdefault(_fold(n), []).append(i)
            self._fold_map = m
        return self._fold_map

    @property
    def canon_map(self) -> dict:
        if self._canon_map is None:
            m: dict = {}
            for key, rows in self.fold_map.items():
                c = _canon(key)
                if c:
                    m.setdefault(c, []).extend(rows)
            self._canon_map = m
        return self._canon_map


_index_cache: dict[str, "pq.Table"] = {}   # kept for backwards compatibility
_index_objects: dict[str, _Index] = {}


def _get_index(release: Optional[str] = None) -> _Index:
    rel = release or _latest_release()
    if rel not in _index_objects:
        try:
            path = ensure_index(rel)
        except ReleaseUnavailable:
            raise
        except Exception as exc:
            raise ReleaseUnavailable(
                f"Could not obtain the division index for release {rel!r} "
                f"({type(exc).__name__}: {exc}).\n"
                "If this machine is offline, point botmap at a release that is "
                "already cached:\n"
                + (f"    BOTMAP_RELEASE={_cached_releases()[0]} botmap where \"<place name>\"\n"
                   if _cached_releases() else
                   "    botmap --release <release-id> where \"<place name>\"\n")
                + "(The download/catalog code lives in botmap/core.py and "
                  "botmap/cache.py.)"
            ) from None
        try:
            table = pq.read_table(path)
        except Exception as exc:
            raise ReleaseUnavailable(
                f"The cached division index for release {rel!r} is unreadable "
                f"({type(exc).__name__}: {exc}).\nReady to run:\n"
                f"    botmap cache clear && botmap where \"<place name>\""
            ) from None
        _index_objects[rel] = _Index(rel, table)
        _index_cache[rel] = table
    return _index_objects[rel]


def _load_index_table(release: Optional[str] = None):
    """Backwards-compatible accessor used elsewhere in the codebase."""
    return _get_index(release).table


# --------------------------------------------------------------------------- #
# Candidate matching
# --------------------------------------------------------------------------- #

def _take(index: _Index, rows: Sequence[int]):
    rows = list(rows)[:_MAX_FUZZY]
    return index.table.take(rows)


def _candidates(index: _Index, name: str, fuzzy: bool) -> Tuple["pq.Table", str]:
    """Return (subset table, match_type) for a bare name (no qualifiers)."""
    empty = index.table.slice(0, 0)
    if not name:
        return empty, "none"

    # 1. exact, case-insensitive on name_primary (fast, arrow-native).
    sub = index.table.filter(pc.equal(index.lowered, name.lower()))
    if sub.num_rows:
        return sub, "exact"
    if not fuzzy:
        return empty, "none"

    folded = _fold(name)
    if not folded:
        return empty, "none"

    # 2. accent/punctuation-insensitive.
    rows = index.fold_map.get(folded)
    if rows:
        return _take(index, rows), "normalized"

    # 3. canonical: 'St.'/'Saint', 'City of X', 'X County', 'the X'.
    canon = _canon(name)
    for key in {canon, folded}:
        if not key:
            continue
        rows = index.canon_map.get(key) or index.fold_map.get(key)
        if rows:
            return _take(index, rows), "canonical"

    # 4. word-prefix ("Frankfurt" -> "Frankfurt am Main").
    hits: List[int] = []
    needle = folded + " "
    for key, idxs in index.fold_map.items():
        if key.startswith(needle):
            hits.extend(idxs)
            if len(hits) >= _MAX_FUZZY:
                break
    if hits:
        return _take(index, hits), "prefix"

    # 5. substring, last resort.
    hits = []
    for key, idxs in index.fold_map.items():
        if folded in key:
            hits.extend(idxs)
            if len(hits) >= _MAX_FUZZY:
                break
    if hits:
        return _take(index, hits), "substring"

    return empty, "none"


def _region_columns(table):
    region = pc.utf8_upper(pc.cast(table.column("region"), "string"))
    country = pc.utf8_upper(pc.cast(table.column("country"), "string"))
    return country, region


def _filter_by_code(table, code: str):
    country, region = _region_columns(table)
    mask = pc.or_kleene(
        pc.or_kleene(pc.equal(country, code), pc.equal(region, code)),
        pc.ends_with(region, pattern=f"-{code}"),
    )
    return table.filter(mask)


def _filter_by_parent(table, parent: Division):
    """Keep rows inside a named parent division (id link or bbox containment)."""
    pxmin, pymin, pxmax, pymax = parent.bbox
    cx = pc.divide(pc.add(table.column("bbox_xmin"), table.column("bbox_xmax")), 2.0)
    cy = pc.divide(pc.add(table.column("bbox_ymin"), table.column("bbox_ymax")), 2.0)
    inside = pc.and_kleene(
        pc.and_kleene(pc.greater_equal(cx, pxmin), pc.less_equal(cx, pxmax)),
        pc.and_kleene(pc.greater_equal(cy, pymin), pc.less_equal(cy, pymax)),
    )
    mask = inside
    try:
        mask = pc.or_kleene(
            mask, pc.equal(pc.cast(table.column("parent_division_id"), "string"), parent.id)
        )
    except Exception:
        pass
    return table.filter(mask)


def _sort_and_build(table, match_type: str) -> List[Division]:
    if table.num_rows == 0:
        return []
    # Prefer rows with a known population (real places people search for),
    # then larger population, then innermost admin_level as a tiebreaker.
    # admin_level is mostly null, so it must not be the primary key.
    t = table.append_column("_has_pop", pc.is_valid(table.column("population")))
    order = pc.sort_indices(
        t,
        sort_keys=[
            ("_has_pop", "descending"),
            ("population", "descending"),
            ("admin_level", "descending"),
        ],
    )
    t = t.take(order).drop_columns(["_has_pop"])
    out: List[Division] = []
    for r in t.to_pylist():
        out.append(
            Division(
                id=r["id"],
                name=r["name_primary"],
                subtype=r["subtype"],
                country=r["country"],
                region=r["region"],
                admin_level=r["admin_level"],
                population=r["population"],
                parent_division_id=r["parent_division_id"],
                bbox=(r["bbox_xmin"], r["bbox_ymin"], r["bbox_xmax"], r["bbox_ymax"]),
                match_type=match_type,
            )
        )
    return out


# --------------------------------------------------------------------------- #
# Diagnostics / suggestions
# --------------------------------------------------------------------------- #

def _where_else(table, limit: int = 8) -> List[dict]:
    """Distinct (name, subtype, country, region) for name matches, best first."""
    divs = _sort_and_build(table, "exact")
    seen: set = set()
    out: List[dict] = []
    for d in divs:
        key = (d.name, d.subtype, d.country, d.region)
        if key in seen:
            continue
        seen.add(key)
        out.append(
            {
                "name": d.name,
                "subtype": d.subtype,
                "country": d.country,
                "region": d.region,
                "population": d.population,
                "bbox": list(d.bbox),
                "command": f'botmap where "{d.name}, {d.qualifier}"' if d.qualifier
                else f'botmap where "{d.name}"',
            }
        )
        if len(out) >= limit:
            break
    return out


def _suggest_from_index(index: _Index, name: str, limit: int = 8) -> List[dict]:
    """Closest real names in the index, with ready-to-run commands."""
    folded = _fold(name)
    if not folded:
        return []
    keys = index.fold_map
    first = folded[0]
    pool = [
        k for k in keys
        if k and k[0] == first and abs(len(k) - len(folded)) <= max(4, len(folded) // 2)
    ]
    if len(pool) > 60000:
        pool = pool[:60000]
    close = difflib.get_close_matches(folded, pool, n=limit, cutoff=0.72)
    if not close:
        close = [k for k in pool if k.startswith(folded[: max(3, len(folded) // 2)])][:limit]
    out: List[dict] = []
    for key in close:
        rows = keys.get(key) or []
        if not rows:
            continue
        out.extend(_where_else(_take(index, rows[:50]), limit=1))
        if len(out) >= limit:
            break
    return out[:limit]


def suggest(query: str, limit: int = 8, release: Optional[str] = None) -> List[dict]:
    """Public helper: near-miss division names for a query string."""
    name, _ = _parse_query(query)
    try:
        index = _get_index(release)
    except ReleaseUnavailable:
        return []
    return _suggest_from_index(index, name, limit=limit)


_QUALIFIER_HELP = (
    "Qualifier forms that work: 'US', 'USA', 'United States', 'MA', 'US-MA', "
    "'Massachusetts', 'Ontario', or a parent place name like 'Middlesex County'."
)


def _format_not_found(query: str, report: dict) -> str:
    name = report.get("name") or query
    lines = [f"No division matched {query!r}."]
    if report.get("name_matches"):
        quals = ", ".join(report.get("qualifiers") or [])
        lines.append(
            f"{report['name_matches']} division(s) named {name!r} exist in the "
            f"index, but none is in {quals!r}."
        )
        if report.get("elsewhere"):
            lines.append("It exists here instead — copy one of these:")
            for e in report["elsewhere"]:
                loc = e["region"] or e["country"] or "?"
                lines.append(f"  {e['command']}    # {e['subtype']}, {loc}")
        lines.append(f'Or drop the qualifier entirely: botmap where "{name}"')
    elif report.get("suggestions"):
        lines.append("No place has that exact name. Closest names in the index:")
        for e in report["suggestions"]:
            loc = e["region"] or e["country"] or "?"
            lines.append(f"  {e['command']}    # {e['subtype']}, {loc}")
    else:
        lines.append(
            "No similar name exists in the division index either. Check the "
            "spelling, try the parent area instead (e.g. the state or country), "
            f'or search by bounding box: botmap count -t place --bbox '
            f'<xmin,ymin,xmax,ymax> ...'
        )
    lines.append(_QUALIFIER_HELP)
    lines.append(f"(release: {report.get('release', 'unknown')})")
    return "\n".join(lines)


# --------------------------------------------------------------------------- #
# Public resolution API
# --------------------------------------------------------------------------- #

def _pick_parent(divisions: Sequence[Division]) -> Optional[Division]:
    """Pick the most plausible *containing* division: the biggest bbox."""
    if not divisions:
        return None
    return max(divisions[:25], key=lambda d: (d.bbox_area, d.population or 0))


def _resolve_internal(
    index: _Index, query: str, fuzzy: bool, depth: int
) -> Tuple[List[Division], dict]:
    name, qualifiers = _parse_query(query)
    report: dict = {
        "query": query,
        "name": name,
        "qualifiers": qualifiers,
        "normalized_qualifiers": [_normalize_qualifier(q) for q in qualifiers],
        "release": index.release,
        "match_type": "none",
        "name_matches": 0,
        "elsewhere": [],
        "suggestions": [],
        "notes": [],
    }
    if not name:
        report["notes"].append("empty place name")
        return [], report

    cand, match_type = _candidates(index, name, fuzzy)
    report["match_type"] = match_type
    report["name_matches"] = cand.num_rows
    if cand.num_rows == 0:
        report["suggestions"] = _suggest_from_index(index, name)
        return [], report
    if match_type != "exact":
        report["notes"].append(
            f"no exact name match; matched by {match_type} on {name!r}"
        )

    name_only = cand
    filtered = cand
    for q in qualifiers:
        code = _normalize_qualifier(q)
        step = _filter_by_code(filtered, code)
        if step.num_rows == 0 and depth < 2 and re.search(r"[A-Za-z]{3}", q):
            # The qualifier may be a place name ("Cambridge, Middlesex County"
            # or "Springfield, Illinois" where the code table has no entry).
            parent_results, _ = _resolve_internal(index, q, True, depth + 1)
            parent = _pick_parent(parent_results)
            if parent is not None:
                step = _filter_by_parent(filtered, parent)
                if step.num_rows:
                    report["notes"].append(
                        f"qualifier {q!r} interpreted as the place "
                        f"{parent.name!r} ({parent.subtype})"
                    )
        if step.num_rows == 0:
            report["elsewhere"] = _where_else(name_only)
            report["notes"].append(f"qualifier {q!r} ({code}) matched nothing")
            return [], report
        filtered = step

    return _sort_and_build(filtered, match_type), report


def resolve_with_report(
    query: str, *, fuzzy: bool = True, release: Optional[str] = None
) -> Tuple[List[Division], dict]:
    """Resolve a place name and always return an explanation alongside.

    The report is what stops a caller from reporting "zero results" as "there
    are none": it says how the name was matched, where else that name exists,
    and what to run next.
    """
    index = _get_index(release)
    try:
        return _resolve_internal(index, query, fuzzy, 0)
    except GeocodeError:
        raise
    except Exception as exc:  # never leak a raw traceback to the assistant
        raise GeocodeError(
            f"Internal error while resolving {query!r} "
            f"({type(exc).__name__}: {exc}).\n"
            f'Try the simplest form first: botmap where "{_parse_query(query)[0]}"'
        ) from None


def resolve(
    query: str,
    *,
    fuzzy: bool = True,
    limit: Optional[int] = None,
    release: Optional[str] = None,
) -> List[Division]:
    """Return all divisions matching the query (name + optional qualifiers).

    Best match first: divisions with a known population first, then descending
    population, then descending admin_level (innermost area) as a tiebreaker.

    Matching is exact and case-insensitive first, then falls back to
    accent/punctuation-insensitive, then 'St.'/'Saint'/'City of'/'County'
    canonicalisation, then word-prefix, then substring. Non-exact matches are
    flagged in Division.match_type.
    """
    results, _ = resolve_with_report(query, fuzzy=fuzzy, release=release)
    if limit is not None and limit >= 0:
        return results[:limit]
    return results


def best_match(query: str, *, fuzzy: bool = True, release: Optional[str] = None) -> Division:
    """Single best match for the query.

    Raises DivisionNotFound (a LookupError) whose message names the problem and
    includes ready-to-run replacement commands, so a wrong first try becomes a
    correct second try instead of a confident "there are none".
    """
    results, report = resolve_with_report(query, fuzzy=fuzzy, release=release)
    if not results:
        raise DivisionNotFound(_format_not_found(query, report))
    return results[0]


