    if key.endswith("s") and key[:-1] in THEME_ALIASES:
        return THEME_ALIASES[key[:-1]]
    if key + "s" in THEME_DESCRIPTIONS:
        return key + "s"
    return None


def resolve_type(name: str) -> Optional[str]:
    """Return the canonical Overture type for any reasonable spelling, else None."""
    key = _norm(name)
    known = set(_all_types()) | set(TYPE_DESCRIPTIONS)
    if key in known:
        return key
    if key in TYPE_ALIASES:
        return TYPE_ALIASES[key]
    if key.endswith("s") and key[:-1] in known:
        return key[:-1]
    if key.endswith("es") and key[:-2] in known:
        return key[:-2]
    return None


def theme_of(type_name: str) -> Optional[str]:
    """Theme that owns a type (accepting aliases)."""
    canon = resolve_type(type_name)
    if canon is None:
        return None
    return _theme_map().get(canon) or _STATIC_TYPE_THEME_MAP.get(canon)


def list_themes() -> List[dict]:
    """List the six themes with descriptions, member types and a sample command."""
    mapping = _theme_map()
    out = []
    for theme in sorted(THEME_DESCRIPTIONS):
        members = sorted(t for t, th in mapping.items() if th == theme)
        out.append({
            "name": theme,
            "description": THEME_DESCRIPTIONS[theme],
            "types": members,
            "example": THEME_COMMAND_HINTS.get(theme, ""),
        })
    return out


def list_types(theme: Optional[str] = None) -> List[dict]:
    """List all types, optionally filtered to a single theme (aliases accepted)."""
    canon_theme = None
    if theme is not None:
        canon_theme = resolve_theme(theme)
        if canon_theme is None:
            raise ValueError(
                f"Unknown theme {theme!r}. Available: "
                f"{', '.join(sorted(THEME_DESCRIPTIONS))}. "
                f"Run 'botmap themes' to see them with their types."
            )
    mapping = _theme_map()
    out = []
    for type_name in _all_types():
        type_theme = mapping.get(type_name) or _STATIC_TYPE_THEME_MAP.get(type_name, "")
        if canon_theme is not None and type_theme != canon_theme:
            continue
        out.append({
            "name": type_name,
            "theme": type_theme,
            "description": TYPE_DESCRIPTIONS.get(type_name, ""),
            "example": TYPE_COMMAND_HINTS.get(type_name, ""),
        })
    return out


# ---------------------------------------------------------------------------
# Enum vocabularies -- the antidote to "0 results, so there are none".
# ---------------------------------------------------------------------------

# Overture `segment.class` values, ordered roughly most- to least-important.
