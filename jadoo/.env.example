# ─── Database ────────────────────────────────────────
# DB_PATH=./data/jadoo.db

# ─── Slack ───────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
# SLACK_PORT=3000
# LEAVE_DEBUG_LOG_ALL_MESSAGES=false

# ─── AI (pi-ai) ─────────────────────────────────────
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-20250514
AI_API_KEY=sk-your-api-key
# AI_MAX_TOKENS=4096
# AI_TEMPERATURE=0.7

# ─── Google Calendar ─────────────────────────────────
# Option 1: Base64-encoded service account JSON (preferred — one var, copy-paste from GCP)
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
# Option 2: Individual fields (if you don't have the full JSON file)
GOOGLE_CLIENT_EMAIL=bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Always required:
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# ─── Harvest ─────────────────────────────────────────
HARVEST_ACCESS_TOKEN=your-harvest-personal-access-token
HARVEST_ACCOUNT_ID=123456
HARVEST_PROJECT_ID=12345678
HARVEST_VACATION_TASK_ID=1234567
HARVEST_SICK_TASK_ID=1234568
