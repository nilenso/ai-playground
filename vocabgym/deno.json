{
	"tasks": {
		"dev": "deno run -A --watch src/main.ts",
		"start": "deno run -A src/main.ts",
		"check": "deno fmt --check && deno lint && deno test -A",
		"test": "deno test -A",
		"migrate": "deno run -A src/migrate.ts"
	},
	"imports": {
		"@db/sqlite": "jsr:@db/sqlite@^0.13.0",
		"@flue/runtime": "npm:@flue/runtime@^0.9.2",
		"@flue/runtime/internal": "npm:@flue/runtime@^0.9.2/internal",
		"@simplewebauthn/server": "npm:@simplewebauthn/server@^13.3.1",
		"@std/assert": "jsr:@std/assert@^1.0.15",
		"@std/dotenv": "jsr:@std/dotenv@^0.225.5",
		"@std/path": "jsr:@std/path@^1.1.2",
		"@std/fs": "jsr:@std/fs@^1.0.20",
		"hono": "jsr:@hono/hono@^4.9.8",
		"valibot": "jsr:@valibot/valibot@^1.1.0"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 120,
		"semiColons": true,
		"singleQuote": false
	},
	"lint": {
		"rules": {
			"tags": ["recommended"]
		}
	}
}
